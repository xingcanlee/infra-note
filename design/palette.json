{
  "$comment": "Wisp 全局设计令牌的唯一事实来源。tokens.css、Pele 映射、图表 lint、Excalidraw/draw.io 素材库全部由此生成，禁止在别处硬编码颜色。",
  "version": 1,
  "color": {
    "base": {
      "bg": { "light": "#fcfcfb", "dark": "#111214" },
      "surface": { "light": "#f4f4f2", "dark": "#18191c" },
      "surface-2": { "light": "#ebebe7", "dark": "#202125" },
      "border": { "light": "#e2e2dd", "dark": "#2b2d31" },
      "fg": { "light": "#1d1d1f", "dark": "#e6e6e3" },
      "muted": { "light": "#5c6067", "dark": "#a0a4ab" },
      "subtle": {
        "light": "#8b9098",
        "dark": "#6b7078",
        "$comment": "仅用于非文本元素（分隔线、图标），对比度不满足正文 AA"
      },
      "accent": { "light": "#2b5b9e", "dark": "#8db8f2" },
      "accent-fg": { "light": "#ffffff", "dark": "#0b1f1d" },
      "code-bg": { "light": "#f6f6f4", "dark": "#16171a" },
      "selection": { "light": "#dce8fa", "dark": "#1c2d45" }
    },
    "hue": {
      "$comment": "8 色分类色板（顶会论文粉彩 + Distill/DeepSeek 克制风格）：以冰蓝、暖杏橙、淡紫为主强调色，轻描边高可读，明暗双模式全量通过 WCAG AA (>=4.5:1) 对比度校验。顺序即 Pele --pele-series-1..8 的顺序。",
      "blue": {
        "stroke": { "light": "#2b5b9e", "dark": "#9ec4f6" },
        "fill": { "light": "#eaf2fd", "dark": "#182436" }
      },
      "amber": {
        "stroke": { "light": "#9a4a16", "dark": "#f2b886" },
        "fill": { "light": "#fef0e1", "dark": "#2d2117" }
      },
      "green": {
        "stroke": { "light": "#2b6142", "dark": "#8ecaa5" },
        "fill": { "light": "#ebf5ee", "dark": "#17271d" }
      },
      "rose": {
        "stroke": { "light": "#9b3d47", "dark": "#f0a5ad" },
        "fill": { "light": "#fceeee", "dark": "#311d20" }
      },
      "violet": {
        "stroke": { "light": "#5b4282", "dark": "#c4b0ea" },
        "fill": { "light": "#f2ecfa", "dark": "#261d33" }
      },
      "teal": {
        "stroke": { "light": "#1f5f73", "dark": "#8ac9dc" },
        "fill": { "light": "#e8f4f8", "dark": "#15262e" }
      },
      "orange": {
        "stroke": { "light": "#8c3d19", "dark": "#e5a37e" },
        "fill": { "light": "#fdf0e8", "dark": "#2f1e16" }
      },
      "slate": {
        "stroke": { "light": "#47505c", "dark": "#a4aebc" },
        "fill": { "light": "#eef0f4", "dark": "#22252b" }
      }
    },
    "semantic": {
      "$comment": "ML/算法讲解的固定语义色，所有文章、图表、交互组件一致使用。值为 hue 名。",
      "q": "blue",
      "k": "amber",
      "v": "green",
      "weight": "violet",
      "activation": "teal",
      "grad": "rose",
      "bias": "orange",
      "mask": "slate",
      "highlight": "amber",
      "visited": "slate",
      "active": "blue",
      "done": "green",
      "error": "rose"
    }
  },
  "font": {
    "sans": [
      "Inter Variable",
      "Noto Sans SC Variable",
      "Noto Sans SC",
      "Wisp CJK Fallback",
      "-apple-system",
      "BlinkMacSystemFont",
      "PingFang SC",
      "HarmonyOS Sans SC",
      "MiSans",
      "Noto Sans CJK SC",
      "Microsoft YaHei",
      "sans-serif"
    ],
    "mono": [
      "JetBrains Mono Variable",
      "ui-monospace",
      "SFMono-Regular",
      "Menlo",
      "Consolas",
      "Noto Sans SC Variable",
      "Noto Sans SC",
      "PingFang SC",
      "Microsoft YaHei",
      "monospace"
    ],
    "hand": [
      "Inter Variable",
      "Noto Sans SC Variable",
      "Noto Sans SC",
      "Wisp CJK Fallback",
      "-apple-system",
      "BlinkMacSystemFont",
      "PingFang SC",
      "HarmonyOS Sans SC",
      "MiSans",
      "Noto Sans CJK SC",
      "Microsoft YaHei",
      "sans-serif"
    ],
    "$comment": "hand 与 sans 统一使用 Inter + Noto Sans SC 印刷体（同时列出 Noto Sans SC 供无头 SVG/静态导出命中），保留 Excalidraw 框线手绘感的同时确保中英文与技术术语视觉统一。"
  },
  "type": {
    "base-px": { "mobile": 16, "desktop": 17 },
    "line-height": { "body": 1.8, "heading": 1.35, "code": 1.65, "ui": 1.5 },
    "scale-rem": {
      "xs": 0.8125,
      "sm": 0.875,
      "base": 1,
      "lg": 1.125,
      "h4": 1.0625,
      "h3": 1.25,
      "h2": 1.5,
      "h1": 2,
      "display": 2.5
    },
    "weight": { "body": 400, "medium": 500, "strong": 600, "heading": 600 },
    "measure-em": 42
  },
  "space": { "unit-px": 4, "scale": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96] },
  "radius": { "sm": 3, "md": 4, "lg": 4 },
  "diagram": {
    "stroke-width": { "thin": 1, "normal": 1.25, "bold": 2 },
    "font-size-px": { "label": 14, "title": 18, "note": 12 },
    "grid-px": 8,
    "corner-radius": 4,
    "excalidraw": { "roughness": 1, "fillStyle": "solid", "strokeStyle": "solid" },
    "drawio": { "rounded": 1, "absoluteArcSize": 1, "arcSize": 8, "shadow": 0, "sketch": 0 },
    "$comment": "corner-radius 是渲染出的圆角（px），与页面 box 圆角一致。draw.io 的 absoluteArcSize=1 时 arcSize 是圆角直径，所以 arcSize = 2 × corner-radius；Excalidraw 用 roundness {type: 3, value: corner-radius}。"
  }
}

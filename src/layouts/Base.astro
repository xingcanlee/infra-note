---
/**
 * 全站基础布局：主题初始化脚本（先于样式执行）、字体、meta/OG/canonical/RSS、lang、
 * SkipLink、Header、<main id="main">、Footer。
 * main 不限制宽度，页面自行使用 `.wisp-container` 或自己的网格。
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/jetbrains-mono';
import '../wisp/styles/global.css';
import '../wisp/styles/code.css';
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import config from '../wisp.config';
import SkipLink from '../wisp/components/SkipLink.astro';
import Header from '../wisp/components/Header.astro';
import Footer from '../wisp/components/Footer.astro';
import CopyButton from '../wisp/components/CopyButton.astro';

export interface Props {
  /** 页面标题；不传时只显示站点名。会自动拼成 “标题 · 站点名” */
  title?: string;
  /** meta description，默认站点描述 */
  description?: string;
  /** <html lang>，默认 config.site.lang */
  lang?: string;
  /** canonical URL（绝对或站内路径），默认当前 URL */
  canonical?: string;
  /** OG 图片（绝对或站内路径） */
  image?: string;
  /** og:type，默认 website；文章页为 article */
  type?: 'website' | 'article';
  /** 文章发布时间 / 更新时间（type=article 时输出 article:*） */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 文章标签（输出 article:tag） */
  tags?: string[];
  /** 不希望被索引（如 404、草稿预览） */
  noindex?: boolean;
}

const {
  title,
  description = config.site.description,
  lang = config.site.lang,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(config.site.url);
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, site).href;
const fullTitle = title && title !== config.site.title ? `${title} · ${config.site.title}` : config.site.title;
const imageUrl = image ? new URL(image, site).href : undefined;
const ogLocale = lang.replace('-', '_');
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let s = 'system';
        try { s = localStorage.getItem('wisp-theme') || 'system'; } catch {}
        const d = document.documentElement;
        const dark = s === 'dark' || (s !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        d.dataset.theme = dark ? 'dark' : 'light';
        d.dataset.themePref = s === 'light' || s === 'dark' ? s : 'system';
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {config.site.author && <meta name="author" content={config.site.author} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={config.site.title} href={new URL('/rss.xml', site).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={interLatinUrl} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:title" content={title ?? config.site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CopyButton />
  </body>
</html>

<style>
  main {
    display: block;
    outline: none;
  }
</style>

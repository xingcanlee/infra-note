---
/**
 * 文章布局：标题区（h1 + PostMeta + 标签）、目录（宽屏右侧 sticky / 窄屏文首折叠）、prose 正文、上一篇/下一篇。
 * hasMath 为真时才引入 KaTeX 样式（独立 CSS 文件，通过 <link> 按需加载）。
 */
import type { MarkdownHeading } from 'astro';
import type { PostEntry } from '../wisp/utils/posts';
import config from '../wisp.config';
import Base from './Base.astro';
import PostMeta from '../wisp/components/PostMeta.astro';
import TagList from '../wisp/components/TagList.astro';
import Toc from '../wisp/components/Toc.astro';
import ReadingProgress from '../wisp/components/ReadingProgress.astro';
import BackToTop from '../wisp/components/BackToTop.astro';
import PrevNext, { type PrevNextItem } from '../wisp/components/PrevNext.astro';
import katexCssUrl from '../wisp/styles/katex.css?url';
import diagramCssUrl from '../wisp/styles/diagram-figure.css?url';
import excalifontLatinUrl from '../../node_modules/@excalidraw/excalidraw/dist/prod/fonts/Excalifont/Excalifont-Regular-a88b72a24fb54c9f94e3b5fdaa7481c9.woff2?url';
import '../explainers/explainers.css';

export interface Props {
  post: PostEntry;
  /** render() 返回的全部 headings；布局内部取 depth 2–3 */
  headings?: MarkdownHeading[];
  /** remarkPluginFrontmatter.readingTime */
  readingTime?: number;
  /** remarkPluginFrontmatter.hasMath */
  hasMath?: boolean;
  /** remarkPluginFrontmatter.hasDiagram / hasHandDiagram（remark-diagram 写入） */
  hasDiagram?: boolean;
  hasHandDiagram?: boolean;
  prev?: PrevNextItem;
  next?: PrevNextItem;
}

const { post, headings = [], readingTime, hasMath = false, hasDiagram = false, hasHandDiagram = false, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, category, lang, toc, cover } = post.data;
// 排除 GFM 脚注区的隐藏标题（id=footnote-label）
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label');
const zh = /^zh\b/i.test(lang ?? config.site.lang);
const tocTitle = zh ? '目录' : 'Contents';
const showToc = config.features.toc && toc !== false && tocHeadings.length >= 2;
// 目录收起状态：首帧前写入 html[data-toc]（同时是“JS 可用”的标记，无 JS 时目录完整展开）
const tocInit = `try{document.documentElement.dataset.toc=localStorage.getItem('wisp-toc-collapsed')==='1'?'collapsed':'open'}catch(e){document.documentElement.dataset.toc='open'}`;
---

<Base
  title={title}
  description={description}
  lang={lang}
  type="article"
  image={cover?.src}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
>
  <Fragment slot="head">
    {showToc && <script is:inline set:html={tocInit} />}
    {hasMath && config.features.math && <link rel="stylesheet" href={katexCssUrl} />}
    {(hasDiagram || hasHandDiagram) && <link rel="stylesheet" href={diagramCssUrl} />}
    {hasHandDiagram && <link rel="preload" as="font" type="font/woff2" href={excalifontLatinUrl} crossorigin />}
  </Fragment>

  <ReadingProgress />
  <BackToTop />

  <div class:list={['wisp-post', { 'wisp-has-toc': showToc }]}>
    <article class="wisp-post-article">
      <header class="wisp-post-header">
        <h1>{title}</h1>
        <PostMeta
          pubDate={pubDate}
          updatedDate={updatedDate}
          readingTime={readingTime}
          category={category}
          lang={lang}
        />
        {tags.length > 0 && <TagList tags={tags} class="wisp-post-tags" />}
      </header>

      {showToc && (
        <div class="wisp-post-toc-inline">
          <Toc headings={tocHeadings} variant="inline" title={tocTitle} />
        </div>
      )}

      <div class="prose wisp-post-body">
        <slot />
      </div>

      <footer>
        <PrevNext prev={prev} next={next} />
      </footer>
    </article>

    {showToc && (
      <aside class="wisp-post-aside" aria-label={tocTitle}>
        <div class="wisp-post-aside-inner">
          <Toc headings={tocHeadings} variant="aside" title={tocTitle} />
        </div>
      </aside>
    )}
  </div>
</Base>

<style>
  .wisp-post {
    width: 100%;
    max-width: calc(42em + 2 * 20px);
    margin-inline: auto;
    padding-inline: 20px;
    padding-top: 3rem;
  }
  @media (min-width: 48rem) {
    .wisp-post {
      max-width: calc(42em + 2 * 32px);
      padding-inline: 32px;
      padding-top: 4rem;
    }
  }
  .wisp-post-article {
    min-width: 0;
  }

  .wisp-post-header {
    margin-bottom: 2.5rem;
  }
  .wisp-post-header h1 {
    margin: 0 0 0.75rem;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .wisp-post-header :global(.wisp-post-tags) {
    margin-top: 0.35rem;
    font-size: 0.875rem;
  }

  .wisp-post-aside {
    display: none;
  }

  /* ≥ 1200px：正文居中，目录放在右侧留白中 sticky */
  @media (min-width: 75rem) {
    .wisp-post.wisp-has-toc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 42em) minmax(0, 1fr);
      max-width: none;
    }
    .wisp-has-toc .wisp-post-article {
      grid-column: 2;
      grid-row: 1;
    }
    .wisp-post-aside {
      display: block;
      grid-column: 3;
      grid-row: 1;
      padding-inline-start: clamp(2rem, 4vw - 1rem, 3rem);
    }
    .wisp-post-aside-inner {
      position: sticky;
      top: 2.5rem;
      max-width: 14rem;
      max-height: calc(100dvh - 5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--wisp-border) transparent;
    }
    .wisp-post-toc-inline {
      display: none;
    }
  }
</style>

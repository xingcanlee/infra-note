---
/**
 * Lucide 图标组件（构建期内联）。
 * Props: name（Lucide 图标名，如 "sun"）、size（默认 1em）、label（提供则作为可读图标，否则 aria-hidden）、class、strokeWidth
 */
import { iconSvg } from '../lib/icons';

export interface Props {
  name: string;
  size?: number | string;
  label?: string;
  class?: string;
  strokeWidth?: number;
}
const { name, size, label, class: cls, strokeWidth } = Astro.props;
---
<Fragment set:html={iconSvg(name, { size, label, class: cls, strokeWidth })} />

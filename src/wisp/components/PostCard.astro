---
/**
 * 文章卡片：无边框、无阴影。标题 1.25rem/600，摘要（muted，最多 2 行），元信息行（日期 · 阅读时长 · 标签）。
 * hover 时标题变 accent。
 */
import type { PostEntry } from '../utils/posts';
import PostMeta from './PostMeta.astro';

export interface Props {
  post: PostEntry;
  /** 阅读时长（分钟）。列表页需要自行 render() 取 remarkPluginFrontmatter.readingTime；不传则不显示 */
  readingTime?: number;
  /** 标题标签层级，默认 h2（在列表页 h1 之下）；放在 h2 小节里时传 3 */
  headingLevel?: 2 | 3;
  /** 是否显示摘要，默认 true */
  showDescription?: boolean;
  /** 是否在元信息行显示标签，默认 true */
  showTags?: boolean;
}

const { post, readingTime, headingLevel = 2, showDescription = true, showTags = true } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const { title, description, pubDate, tags, lang } = post.data;
---

<article class="wisp-card" lang={lang}>
  <H class="wisp-card-title">
    <a href={`/posts/${post.id}/`}>{title}</a>
  </H>
  {showDescription && description && <p class="wisp-card-desc">{description}</p>}
  <PostMeta pubDate={pubDate} readingTime={readingTime} tags={showTags ? tags : []} lang={lang} />
</article>

<style>
  .wisp-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .wisp-card-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .wisp-card-title a {
    color: var(--wisp-fg);
    transition: color 150ms;
  }
  .wisp-card-title a:hover {
    color: var(--wisp-accent);
  }
  .wisp-card-desc {
    margin: 0;
    color: var(--wisp-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    text-wrap: pretty;
  }
</style>

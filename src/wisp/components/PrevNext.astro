---
/**
 * 文章页底部的上一篇 / 下一篇。
 * 约定：prev = 更早发布的一篇，next = 更新发布的一篇（getPosts() 为降序时，prev = posts[i + 1]，next = posts[i - 1]）。
 */
export interface PrevNextItem {
  /** 文章 id，链接为 /posts/<id>/ */
  id: string;
  title: string;
}

export interface Props {
  prev?: PrevNextItem;
  next?: PrevNextItem;
}

import Icon from './Icon.astro';
import { sitePath } from '../utils/paths';

const base = import.meta.env.BASE_URL;
const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="wisp-prevnext" aria-label="相邻文章">
      {prev ? (
        <a href={sitePath(base, `/posts/${prev.id}/`)} rel="prev" class="is-prev">
          <span class="label"><Icon name="arrow-left" /> 上一篇</span>
          <span class="title">{prev.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={sitePath(base, `/posts/${next.id}/`)} rel="next" class="is-next">
          <span class="label">下一篇 <Icon name="arrow-right" /></span>
          <span class="title">{next.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .wisp-prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--wisp-border);
  }
  .wisp-prevnext a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .is-next {
    text-align: end;
    grid-column: 2;
  }
  .label {
    color: var(--wisp-muted);
    font-size: 0.8125rem;
  }
  .title {
    color: var(--wisp-fg);
    font-weight: 600;
    line-height: 1.5;
    transition: color 150ms;
    text-wrap: balance;
  }
  .wisp-prevnext a:hover .title {
    color: var(--wisp-accent);
  }
  @media (max-width: 39.99rem) {
    .wisp-prevnext {
      grid-template-columns: 1fr;
    }
    .is-next {
      grid-column: 1;
    }
  }
</style>

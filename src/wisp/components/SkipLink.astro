---
/**
 * “跳到正文”链接：默认视觉隐藏，获得键盘焦点时出现在左上角。
 */
export interface Props {
  /** 目标元素 id，默认 `main` */
  target?: string;
  /** 链接文字，默认“跳到正文” */
  label?: string;
}
const { target = 'main', label = '跳到正文' } = Astro.props;
---

<a href={`#${target}`} class="wisp-skip">{label}</a>

<style>
  .wisp-skip {
    position: absolute;
    left: 12px;
    top: 12px;
    z-index: 50;
    padding: 0.5em 0.9em;
    border-radius: 6px;
    background-color: var(--wisp-accent);
    color: var(--wisp-accent-fg);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    transform: translateY(calc(-100% - 24px));
  }
  .wisp-skip:focus,
  .wisp-skip:focus-visible {
    transform: none;
  }
</style>

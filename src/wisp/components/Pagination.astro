---
/**
 * 分页导航：上一页 / 第 n / N 页 / 下一页。
 * URL 规则：第 1 页为 `base`，第 n 页为 `${base}page/${n}/`；也可直接传 prevUrl / nextUrl（例如来自 Astro paginate() 的 page.url）。
 */
export interface Props {
  /** 当前页（从 1 开始） */
  current: number;
  /** 总页数 */
  total: number;
  /** 第 1 页的 URL，默认 `/` */
  base?: string;
  /** 覆盖上一页 URL */
  prevUrl?: string;
  /** 覆盖下一页 URL */
  nextUrl?: string;
}

import Icon from './Icon.astro';

const { current, total, base = '/' } = Astro.props;
const root = base.endsWith('/') ? base : `${base}/`;
const urlOf = (n: number) => (n <= 1 ? root : `${root}page/${n}/`);
const prevUrl = Astro.props.prevUrl ?? (current > 1 ? urlOf(current - 1) : undefined);
const nextUrl = Astro.props.nextUrl ?? (current < total ? urlOf(current + 1) : undefined);
---

{
  total > 1 && (
    <nav class="wisp-pagination" aria-label="分页">
      {prevUrl ? (
        <a href={prevUrl} rel="prev">
          <Icon name="arrow-left" /> 上一页
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
      <span class="wisp-pagination-cur" aria-current="page">
        第 {current} / {total} 页
      </span>
      {nextUrl ? (
        <a href={nextUrl} rel="next">
          下一页 <Icon name="arrow-right" />
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
    </nav>
  )
}

<style>
  .wisp-pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 1rem;
    margin-top: 4rem;
    font-size: 0.9375rem;
  }
  .wisp-pagination a {
    color: var(--wisp-accent);
    transition: color 150ms;
  }
  .wisp-pagination a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .wisp-pagination > :last-child {
    justify-self: end;
  }
  .wisp-pagination-cur {
    color: var(--wisp-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
</style>

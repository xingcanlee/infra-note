---
/**
 * 阅读进度条：页面顶部 2px 的 accent 细线，表示 `.wisp-post-body` 的阅读进度。
 * scroll + requestAnimationFrame 节流，用 transform: scaleX 避免重排；无 JS 时不显示。
 */
---

<div class="wisp-progress" data-reading-progress aria-hidden="true"></div>

<style>
  .wisp-progress {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: 2px;
    background: var(--wisp-accent);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
  :global([dir='rtl']) .wisp-progress {
    transform-origin: right;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const body = document.querySelector('.wisp-post-body');
  if (bar && body) {
    let tick = false;
    const update = () => {
      tick = false;
      const r = body.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = span > 0 ? -r.top / span : r.bottom <= innerHeight ? 1 : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`;
    };
    const onScroll = () => tick || ((tick = true), requestAnimationFrame(update));
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }
</script>

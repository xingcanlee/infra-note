---
/**
 * 页脚：版权、RSS、社交链接。muted，0.875rem。
 */
import config from '../../wisp.config';
import Icon from './Icon.astro';

export interface Props {
  /** 版权年份，默认当前构建年份 */
  year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;
const defaultLabel: Record<string, string> = {
  github: 'GitHub',
  x: 'X',
  mastodon: 'Mastodon',
  bluesky: 'Bluesky',
  email: '邮箱',
  rss: 'RSS',
  link: '链接',
};
const iconOf: Record<string, string> = {
  github: 'github',
  rss: 'rss',
  x: 'twitter',
  email: 'mail',
  mastodon: 'at-sign',
  bluesky: 'at-sign',
  link: 'link',
};
const owner = config.site.author || config.site.title;
---

<footer class="wisp-footer">
  <div class="wisp-container">
  <div class="wisp-footer-inner">
    <p>© {year} {owner}</p>
    {
      config.social.length > 0 && (
        <ul aria-label="社交链接">
          {config.social.map((s) => {
            const external = /^https?:/.test(s.href);
            return (
              <li>
                <a
                  href={s.kind === 'email' && !s.href.startsWith('mailto:') ? `mailto:${s.href}` : s.href}
                  rel={external ? 'me noopener' : undefined}
                  type={s.kind === 'rss' ? 'application/rss+xml' : undefined}
                  aria-label={s.label ?? defaultLabel[s.kind]}
                  title={s.label ?? defaultLabel[s.kind]}
                >
                  <Icon name={iconOf[s.kind] ?? 'link'} size={18} />
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
  </div>
</footer>

<style>
  .wisp-footer {
    margin-top: 6rem;
    color: var(--wisp-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .wisp-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--wisp-border);
  }
  .wisp-footer p {
    margin: 0;
  }
  .wisp-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 -0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .wisp-footer a {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 6px;
    color: var(--wisp-muted);
    transition: color 150ms;
  }
  .wisp-footer a:hover {
    color: var(--wisp-accent);
  }
</style>

<mxfile host="wisp-diagram">
  <diagram id="foundations-04-sram-tiling-arch" name="SRAM Tiling Architecture">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr" value="FlashAttention IO 架构：\(Q/K/V\) 留在 HBM，所有 \([B_r, B_c]\) 分数与归一化状态均在片上完成" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="688" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="hbm" value="片外 HBM 显存 (大容量 · 低带宽: H800 3.35 TB/s)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="8" y="32" width="672" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="hbm_q" value="完整 \(Q\;[N, d]\)&lt;br&gt;按块 \(B_r\) 分片读一次" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="72" width="120" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="hbm_kv" value="完整 \(K, V\;[N, d]\)&lt;br&gt;分块 \(B_c\) 顺序流式读取" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="168" y="72" width="160" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="hbm_no_sp" value="已消除：\(S, P\;[N, N]\)&lt;br&gt;\(O(N^2)\) 中间矩阵不写回 HBM" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5c6067;strokeWidth=1.25;dashed=1;dashPattern=4 4;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="352" y="72" width="176" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="hbm_o" value="最终 \(O\;[N, d]\)&lt;br&gt;仅循环末尾写回一次" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="552" y="72" width="112" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="sram" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2f5783;container=0;" vertex="1" parent="1">
          <mxGeometry x="8" y="216" width="672" height="264" as="geometry"/>
        </mxCell>
        <mxCell id="sram_hdr" value="片上高速缓存 (GPU SMEM/TMEM · 昇腾 L1/L0C + UB)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2f5783;" vertex="1" parent="1">
          <mxGeometry x="192" y="224" width="368" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sram_q" value="常驻切片 \(Q_i\)&lt;br&gt;\([B_r, d]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="264" width="104" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="sram_kv" value="当前分块 \(K_j, V_j\)&lt;br&gt;\([B_c, d]\) 双缓冲覆写" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="376" width="104" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="sram_s" value="局部矩阵乘 \(S_{ij}\)&lt;br&gt;\(= Q_i K_j^\top / \sqrt{d}\)&lt;br&gt;仅占 \([B_r, B_c]\) 用完即丢" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="160" y="264" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sram_sm" value="片上统计更新&lt;br&gt;\(m_{\text{new}} = \max(m, \text{rowmax})\)&lt;br&gt;\(\alpha = \exp(m_{\text{old}} - m_{\text{new}})\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="160" y="368" width="184" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="sram_acc" value="唯一片上输出累加器&lt;br&gt;\(\tilde{O}_i\;[B_r, d]\)（未除 \(l_i\)）&lt;br&gt;原地重缩放并叠加：&lt;br&gt;\(\tilde{O}_i \leftarrow \alpha\tilde{O}_i + \tilde{P}_{ij} V_j\)&lt;br&gt;（Ascend 950 迁至 UB&lt;br&gt;配合 skip-scale 减少搬运）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="376" y="272" width="168" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="sram_fin" value="循环 \(T_c\) 块后&lt;br&gt;唯一一次除法&lt;br&gt;\(O_i = \tilde{O}_i / l_i\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;dashed=1;dashPattern=4 4;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="568" y="328" width="96" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e_hq" value="TMA / MTE2" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="hbm_q" target="sram_q">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_hkv" value="按 \(B_c\) 迭代" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="hbm_kv" target="sram_kv">
          <mxGeometry x="-0.5" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="248" y="184"/>
              <mxPoint x="148" y="184"/>
              <mxPoint x="148" y="416"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_qs" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="sram_q" target="sram_s">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_kvs" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="sram_kv" target="sram_s">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_ssm" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sram_s" target="sram_sm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_sma" value="\(\alpha, \tilde{P}\)" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.7;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="sram_sm" target="sram_acc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_fin" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1.0;exitY=0.65;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sram_acc" target="sram_fin">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_wo" value="仅写 \(O(Nd)\)" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="sram_fin" target="hbm_o">
          <mxGeometry x="0.45" relative="1" as="geometry"/>

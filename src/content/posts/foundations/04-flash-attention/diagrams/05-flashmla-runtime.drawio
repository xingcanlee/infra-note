<mxfile host="wisp-diagram">
  <diagram id="flashmla-runtime" name="FlashMLA 解码调度：Split-KV 分区、9 路 TMA 与 Seesaw 双 Warpgroup">
    <mxGraphModel dx="640" dy="560" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kv_mem" value="Paged KV Cache（单头 \(h_{kv}=1\)）&lt;br&gt;Hopper 576 维；SM100 稀疏 512 维" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="264" height="64" as="geometry" />
        </mxCell>
        <mxCell id="q_abs" value="Query 吸收 \(W_{UK}^\top\) 后合并多头&lt;br&gt;\(Q: [128,\; 576]\)，\(M = h_q s_q \ge 128\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="288" y="0" width="336" height="64" as="geometry" />
        </mxCell>

        <mxCell id="grp_sm" value="Split-KV 分区：按 SM 切分长 KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="96" width="624" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tma_9" value="9 路 TMA \(64\times 64\)&lt;br&gt;切分 \(576 = 9\times 64\)&lt;br&gt;首块到齐即开算 GEMM&lt;br&gt;（EVICT_FIRST 护 L2）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="136" width="168" height="144" as="geometry" />
        </mxCell>
        <mxCell id="seesaw" value="双 Warpgroup 跷跷板&lt;br&gt;仅存 1 份 \(64\times 512\) 寄存器&lt;br&gt;WG0 管 \(O_L\,(64\times 256)\)&lt;br&gt;WG1 管 \(O_R\,(64\times 256)\)&lt;br&gt;交替重叠 MMA 与 Softmax" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="208" y="136" width="208" height="144" as="geometry" />
        </mxCell>
        <mxCell id="part_out" value="单 SM 分片局部输出&lt;br&gt;\(o_{\text{accum}}\,[S, s_q, h_q, d_v]\)&lt;br&gt;\(\text{lse}_{\text{accum}}\,[S, s_q, h_q]\)&lt;br&gt;（PDL 重叠启动下核）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="440" y="136" width="168" height="144" as="geometry" />
        </mxCell>

        <mxCell id="combine" value="combine.cu：按全局 LogSumExp 权重归并各分片&lt;br&gt;\(w_s = \operatorname{exp2}(\text{lse}_s - \text{lse}_{\text{global}})\)，输出最终 \(O\,[b, s_q, h_q, d_v]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="32" y="328" width="560" height="72" as="geometry" />
        </mxCell>

        <mxCell id="sm100_box" value="FlashMLA@395cb3af（SM100 稀疏）&lt;br&gt;\(d_{qk}=512\)，528B FP8 / 288B FP4&lt;br&gt;topk &gt; 640 时启用 Split-KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="424" width="296" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ascend_box" value="昇腾 Ascend（vllm-ascend / 950）&lt;br&gt;64 头×1C2V，UB 累加 + skip-scale&lt;br&gt;片上一次扫完（无 Split-KV）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="328" y="424" width="296" height="72" as="geometry" />
        </mxCell>

        <mxCell id="note" value="注：Hopper 576 维稠密内核已从 FlashMLA@395cb3af 主干移除，相关调度原理保留于 docs/。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="512" width="624" height="24" as="geometry" />
        </mxCell>

        <mxCell id="e_kv_tma" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=0.3787878787878788;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="kv_mem" target="tma_9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_q_sm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2f5783;strokeWidth=1.25;exitX=0.07142857142857142;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q_abs" target="seesaw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tma_sea" value="" style="endArrow=classic;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tma_9" target="seesaw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sea_out" value="" style="endArrow=classic;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="seesaw" target="part_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_out_comb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.25;exitX=0.5;exitY=1;entryX=0.8785714285714286;entryY=0;" edge="1" parent="1" source="part_out" target="combine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

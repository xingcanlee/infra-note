<mxfile host="wisp-diagram">
  <diagram id="online-softmax-walkthrough" name="手算实例：两块 B_c=2 瓦片完成在线 Softmax 与重缩放">
    <mxGraphModel dx="640" dy="544" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1_in" value="Tile 1 载入 SRAM（\(B_c=2\)）&lt;br&gt;\(s_1 = [1.0,\; 3.0]\)，\(V_1 = [[1,0],\;[0,2]]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="288" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t2_in" value="Tile 2 载入 SRAM（覆盖复用同一槽位）&lt;br&gt;\(s_2 = [5.0,\; 2.0]\)，\(V_2 = [[2,1],\;[0,4]]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="336" y="0" width="288" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t1_stat" value="① 记录 Tile 1 局部状态（不做除法）&lt;br&gt;\(m_1 = 3.0,\;\ell_1 = 1.135335\)&lt;br&gt;\(\tilde{o}_1 = [0.135335,\; 2.000000]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="96" width="288" height="88" as="geometry" />
        </mxCell>
        <mxCell id="t2_stat" value="② 计算 Tile 2 局部最大值与新片权重&lt;br&gt;\(\tilde{m}_2 = 5.0\)&lt;br&gt;\(\tilde{p}_2 = \exp(s_2 - 5.0)\)&lt;br&gt;\(= [1.000000,\; 0.049787]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="336" y="96" width="288" height="88" as="geometry" />
        </mxCell>
        <mxCell id="rescale" value="③ 刷新全局最大值与旧账重缩放系数&lt;br&gt;\(m_2 = \max(3.0,\; 5.0) = 5.0\)&lt;br&gt;\(\alpha = \exp(m_1 - m_2) = e^{-2} = 0.135335\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="216" width="384" height="72" as="geometry" />
        </mxCell>
        <mxCell id="accum" value="④ 历史累加器同步缩水 \(\alpha\) 倍并加上新片贡献&lt;br&gt;\(\ell_2 = \alpha\,\ell_1 + 1.049787 = 1.203438\)&lt;br&gt;\(\tilde{o}_2 = \alpha\,\tilde{o}_1 + \tilde{p}_2 V_2 = [2.018316,\; 1.469819]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="320" width="592" height="72" as="geometry" />
        </mxCell>
        <mxCell id="final_div" value="⑤ 全部瓦片扫完后只除一次：\(o = \tilde{o}_2 / \ell_2 = [1.677125,\; 1.221350]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="16" y="424" width="592" height="56" as="geometry" />
        </mxCell>
        <mxCell id="note" value="注：全局一次算 \(\operatorname{softmax}([1,3,5,2])\cdot V = [1.677125,\,1.221350]\)，结果完全一致且 SRAM 不存完整 \(S\)。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="496" width="624" height="32" as="geometry" />
        </mxCell>
        <mxCell id="e_t1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t1_in" target="t1_stat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_t2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t2_in" target="t2_stat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_1_res" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.25;exitX=0.75;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="t1_stat" target="rescale">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_2_res" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.25;exitX=0.25;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="t2_stat" target="rescale">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_1_acc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.16666666666666666;exitY=1;entryX=0.05405405405405406;entryY=0;" edge="1" parent="1" source="t1_stat" target="accum">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_2_acc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.8333333333333334;exitY=1;entryX=0.9459459459459459;entryY=0;" edge="1" parent="1" source="t2_stat" target="accum">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_res_acc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.25;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rescale" target="accum">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_acc_div" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="accum" target="final_div">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

<mxfile host="wisp-diagram">
  <diagram id="fa-evolution-arch" name="FlashAttention-2 到 FA-4 硬件瓶颈迁移与软硬协同演进">
    <mxGraphModel dx="640" dy="560" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="grp_fa2" value="FA-2（Ampere A100：BF16 MMA 312 TFLOPS vs 非矩阵 FP32 19.5 TFLOPS，差 16×）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="624" height="128" as="geometry" />
        </mxCell>
        <mxCell id="fa2_a" value="外循环切分 \(Q\)&lt;br&gt;并行度扩展到序列维&lt;br&gt;Warp 间免 SMEM 归约" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="32" width="184" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fa2_b" value="保留未归一化 \(\tilde{O}\)&lt;br&gt;内循环砍掉除法与缩放&lt;br&gt;收尾一次除以 \(\ell\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="32" width="176" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fa2_c" value="A100 利用率约 73%&lt;br&gt;遗留瓶颈：MMA 与&lt;br&gt;Softmax 仍同线程串行" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="424" y="32" width="184" height="80" as="geometry" />
        </mxCell>

        <mxCell id="grp_fa3" value="FA-3（Hopper H100：WGMMA 异步吞吐升至 4096 op/clk/SM，MUFU 指数单元仅 16 op/clk）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="168" width="624" height="128" as="geometry" />
        </mxCell>
        <mxCell id="fa3_a" value="TMA + WGMMA 异步&lt;br&gt;Producer/Consumer&lt;br&gt;Warpgroup 角色特化" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="200" width="184" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fa3_b" value="Ping-Pong 双片交错&lt;br&gt;WG-A 跑 WGMMA 时&lt;br&gt;WG-B 跑 Softmax" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="200" width="176" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fa3_c" value="FP8 块量化 + 降噪&lt;br&gt;新瓶颈：累加器占满&lt;br&gt;寄存器，难以扩大瓦片" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="424" y="200" width="184" height="80" as="geometry" />
        </mxCell>

        <mxCell id="grp_fa4" value="FA-4（Blackwell B200：MMA 翻倍至 8192 op/clk/SM，而 MUFU 仍为 16、SMEM 仍为 128 B/clk）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="336" width="624" height="144" as="geometry" />
        </mxCell>
        <mxCell id="fa4_a" value="256 KB TMEM + UMMA&lt;br&gt;\(128\times 128\) 异步写 TMEM&lt;br&gt;解放寄存器并增大瓦片" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="376" width="184" height="88" as="geometry" />
        </mxCell>
        <mxCell id="fa4_b" value="FMA 多项式 \(\operatorname{exp2}\)&lt;br&gt;10–25% 指数分流 FMA&lt;br&gt;+ 阈值跳过 rescale" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="224" y="376" width="176" height="88" as="geometry" />
        </mxCell>
        <mxCell id="fa4_c" value="2-CTA 反向 + CuTe-DSL&lt;br&gt;DSMEM 减半原子加&lt;br&gt;B200 达 1613 TFLOPS" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="424" y="376" width="184" height="88" as="geometry" />
        </mxCell>

        <mxCell id="note" value="注：B200 下 MMA 算力再翻倍但 SMEM 带宽与 MUFU 指数单元未同步翻倍，迫使 FA-4 用 FMA 逼近 exp2 并借 TMEM 解耦重缩放。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="496" width="624" height="32" as="geometry" />
        </mxCell>

        <mxCell id="e_2ab" value="" style="endArrow=classic;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fa2_a" target="fa2_b">

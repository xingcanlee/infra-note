<mxfile host="wisp-diagram">
  <diagram id="foundations-04-flashmla-hardware-pipelines" name="FlashMLA Multi-Hardware Pipeline Evolution">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr" value="多代硬件注意力执行流水线对比：从串行屏障到 H800 跷跷板、B200 TMEM 与昇腾 1C2V" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="688" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="1. 串行无重叠基线（有效重叠 &lt; 25%，搬运/矩阵/Softmax 依次等待气泡）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="8" y="32" width="672" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="s_tma" value="读 \(K_0/V_0\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="64" width="112" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_qk" value="GEMM \(QK^\top\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="152" y="64" width="112" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_sm" value="Softmax + 缩放" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="280" y="64" width="128" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_pv" value="GEMM \(P \cdot V\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="424" y="64" width="112" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_wo" value="写回 \(O\)（空等长）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="552" y="64" width="112" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="2. Hopper H800 FlashMLA 双 Warpgroup 跷跷板（65,536 reg 限制 → 劈半 \(O_L \mid O_R\)，660 TF / 3 TB/s）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="8" y="136" width="672" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="h_tma" value="&lt;b&gt;9 路 64×64 TMA&lt;/b&gt;&lt;br&gt;EVICT_FIRST 异步预取 576 维宽行" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="168" width="208" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="h_wg0" value="&lt;b&gt;WG0（\(O_L\;[64,256]\)，\(\le 128\) reg）&lt;/b&gt;：\(QK_0^\top\) → Softmax L → \(PV_L\)（与 WG1 交替让 Tensor Core）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="248" y="168" width="416" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="h_wg1" value="&lt;b&gt;WG1（\(O_R\;[64,256]\)）&lt;/b&gt;：错开一拍交替执行 \(QK_0^\top\) / Softmax R / \(PV_R\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="248" y="208" width="416" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="3. Blackwell B200 FA-4（1613 TF，71% 峰值）：专用 TMEM 释放寄存器并拆四路协同" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="8" y="272" width="672" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="b_tmem" value="&lt;b&gt;TMA + UMMA → 256 KB TMEM&lt;/b&gt;&lt;br&gt;就地持有 \(128\times 128\) 累加器" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="304" width="208" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="b_sm" value="&lt;b&gt;2× Softmax WG&lt;/b&gt;&lt;br&gt;3 次 FMA 多项式分流 10%–25% \(\text{exp2}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="248" y="304" width="216" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="b_corr" value="&lt;b&gt;1× Correction WG&lt;/b&gt;&lt;br&gt;\(\Delta m &gt; 8.0\) 才重缩放 TMEM" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="480" y="304" width="184" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="4. 昇腾 Ascend 950 1C2V（410 TF Prefill 95% / 360 TF Decode 83%）：Cube-MTE2-Vector Ping-Pong" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="8" y="392" width="672" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="a_mte" value="&lt;b&gt;MTE2（16 槽发射队列）&lt;/b&gt;&lt;br&gt;gather2 + ND2NZ 异步预取" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="424" width="184" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="a_cube" value="&lt;b&gt;1× Cube（4096 FMA/clk）&lt;/b&gt;&lt;br&gt;\(QK_i^\top \to 256\;\text{KB L0C}\) + 延迟 \(S_{i-1}V_{i-1}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="424" width="216" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="a_vec" value="&lt;b&gt;2× Vector（UB 持 \(\tilde{O}\)）&lt;/b&gt;&lt;br&gt;FixPipe 迁出 + RESCALE_THRES=6 跳过" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="456" y="424" width="208" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="e_s1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_tma" target="s_qk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_s2" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_qk" target="s_sm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_s3" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_sm" target="s_pv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_s4" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pv" target="s_wo">

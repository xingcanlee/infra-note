        <mxCell id="eq_box" value="\(\theta'_i = (1-\text{extrap}_i)\,\theta_i/s + \text{extrap}_i\,\theta_i\)   |   温度修正：\(\text{mscale} = 0.1\ln(s) + 1 \approx 1.37\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;dashed=1;dashPattern=4 4;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

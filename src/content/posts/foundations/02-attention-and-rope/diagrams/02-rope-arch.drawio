<mxfile host="wisp-diagram">
  <diagram id="d02-rope" name="02-rope-arch">
    <mxGraphModel dx="664" dy="432" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="664" pageHeight="432" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Top Panel: 2D Geometric Relative Property -->
        <mxCell id="top_box" value="&lt;b&gt;旋转位置编码的二维几何与相对不变性&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;spacingTop=8;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="632" height="176" as="geometry" />
        </mxCell>
        <mxCell id="rq" value="&lt;b&gt;位置 \(m\) 的查询 \(R_{\theta,m}\,q\)&lt;/b&gt;&lt;br&gt;二维平面逆时针旋转 \(m\theta_i\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="56" width="184" height="56" as="geometry" />
        </mxCell>
        <mxCell id="rk" value="&lt;b&gt;位置 \(n\) 的键 \(R_{\theta,n}\,k\)&lt;/b&gt;&lt;br&gt;二维平面逆时针旋转 \(n\theta_i\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="128" width="184" height="56" as="geometry" />
        </mxCell>
        <mxCell id="rdot" value="&lt;b&gt;内积仅取决于相对偏移 \(n-m\)&lt;/b&gt;&lt;br&gt;\((R_{\theta,m}\,q)^T(R_{\theta,n}\,k)=q^T R_{\theta,n-m}\,k\)&lt;br&gt;正交矩阵旋转不改变模长，平移 \(\Delta\) 完全抵消" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="280" y="64" width="352" height="104" as="geometry" />
        </mxCell>
        <mxCell id="erq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2f5783;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="rq" target="rdot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="erk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7b5518;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="rk" target="rdot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bottom Panel: Pairing Layouts -->
        <mxCell id="bot_box" value="&lt;b&gt;生产内存配对布局（\(d=8\) 通道为例）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;spacingTop=8;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="216" width="632" height="200" as="geometry" />
        </mxCell>
        <mxCell id="neox" value="&lt;b&gt;rotate_neox&lt;/b&gt;&lt;br&gt;前后半段跨区配对&lt;br&gt;\((x_0,x_4),\,(x_1,x_5)\)&lt;br&gt;\((x_2,x_6),\,(x_3,x_7)\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="264" width="152" height="136" as="geometry" />
        </mxCell>
        <mxCell id="gptj" value="&lt;b&gt;rotate_gptj / V3&lt;/b&gt;&lt;br&gt;奇偶相邻交错配对&lt;br&gt;\((x_0,x_1),\,(x_2,x_3)\)&lt;br&gt;\((x_4,x_5),\,(x_6,x_7)\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="256" y="264" width="152" height="136" as="geometry" />
        </mxCell>
        <mxCell id="dsv4" value="&lt;b&gt;DeepSeek-V4 尾切片&lt;/b&gt;&lt;br&gt;前 4 维 Nope 不旋转&lt;br&gt;后 4 维旋转 · 支持逆变&lt;br&gt;\(\text{offset}=h-d_{\text{rot}}\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="480" y="264" width="152" height="136" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

<mxfile host="wisp-diagram">
  <diagram id="d02-attn" name="02-attention-walkthrough">
    <mxGraphModel dx="664" dy="568" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="664" pageHeight="568" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Top Row: Q, K, V -->
        <mxCell id="qbox" value="&lt;b&gt;查询 \(Q\;[4,4]\)&lt;/b&gt;&lt;br&gt;\(t=3\) (上): \([1,0,1,1]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="168" height="72" as="geometry" />
        </mxCell>
        <mxCell id="kbox" value="&lt;b&gt;键 \(K\;[4,4]\)&lt;/b&gt;&lt;br&gt;4 个词元的索引键" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="248" y="16" width="168" height="72" as="geometry" />
        </mxCell>
        <mxCell id="vbox" value="&lt;b&gt;值 \(V\;[4,4]\)&lt;/b&gt;&lt;br&gt;待读取的语义向量" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="480" y="16" width="168" height="72" as="geometry" />
        </mxCell>

        <!-- Step 1: Scaled Dot Product -->
        <mxCell id="sbox" value="&lt;b&gt;1. 缩放打分 \(S = QK^T / \sqrt{4}\)&lt;/b&gt;&lt;br&gt;\(t=2\) (垫): \([0.5,\,1.0,\,0.5,\,\mathbf{1.0}]\)&lt;br&gt;\(t=3\) (上): \([1.0,\,0.5,\,0.5,\,1.0]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="128" width="368" height="80" as="geometry" />
        </mxCell>

        <!-- Step 2: Causal Mask -->
        <mxCell id="mbox" value="&lt;b&gt;2. 因果掩码 \(+\,M_{\text{triu}}\)（未来置 \(-\infty\)）&lt;/b&gt;&lt;br&gt;\(t=2\) (垫): \([0.5,\,1.0,\,0.5,\,-\infty]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="248" width="368" height="72" as="geometry" />
        </mxCell>

        <!-- Step 3: Softmax -->
        <mxCell id="pbox" value="&lt;b&gt;3. 逐行归一化 \(P = \text{Softmax}(S+M)\)&lt;/b&gt;&lt;br&gt;\(t=2\): \([0.2741,\,0.4519,\,0.2741,\,0]\)&lt;br&gt;\(t=3\): \([0.3112,\,0.1888,\,0.1888,\,0.3112]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="360" width="368" height="80" as="geometry" />
        </mxCell>

        <!-- Step 4: Output Readout -->
        <mxCell id="obox" value="&lt;b&gt;4. 加权聚合输出 \(O = P \cdot V\)&lt;/b&gt;&lt;br&gt;\(O_2=[0.4111,\,0.5889,\,0.4111,\,0.2259]\)&lt;br&gt;\(O_3=[0.4056,\,0.2832,\,0.5000,\,0.4056]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="128" y="480" width="520" height="72" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="eq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2f5783;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="qbox" target="sbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ek" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7b5518;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="kbox" target="sbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sbox" target="mbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="em" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mbox" target="pbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2f5783;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.169;entryY=0;" edge="1" parent="1" source="pbox" target="obox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ev" value="值矩阵直通 \(V\)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2c522d;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Inter;fontSize=12;fontColor=#2c522d;exitX=0.5;exitY=1;entryX=0.838;entryY=0;" edge="1" parent="1" source="vbox" target="obox">
          <mxGeometry x="0" y="-44" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

<mxfile host="wisp-diagram">
  <diagram id="dist-03-deepep-vs-mc2" name="DeepEP vs MC2">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="8" guides="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr" value="MoE EP 通信与算子卸载：GPU DeepEP 无阻塞 Kernel vs 昇腾 MC2 AIV-AICore-RDMA 全核融合" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="688" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="ep_left" value="NVIDIA DeepEP (EPBuffer) + vLLM" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2f5783;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="32" width="336" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="ep_right" value="华为昇腾 HCCL MC2 通算融合" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#0f766e;container=0;" vertex="1" parent="1">
          <mxGeometry x="352" y="32" width="336" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="l_ht" value="Prefill：High-Throughput (HT) 分层转发" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2f5783;container=0;" vertex="1" parent="1">
          <mxGeometry x="24" y="64" width="288" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="l_ht_body" value="RDMA 单份跨机中继 + NVLink 机内扇出&lt;br&gt;跨机只传 1 份副本，节省网卡带宽" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="256" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="l_ll" value="Decode：Low-Latency (LL) 纯 RDMA IBGDA" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#7b5518;container=0;" vertex="1" parent="1">
          <mxGeometry x="24" y="208" width="288" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l_ll_body" value="GPU Warp 直接写网卡 Doorbell (IBGDA)&lt;br&gt;绕过 CPU 与 Host 中转，压低启动延迟" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="256" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="l_v2" value="vLLM DeepEP v2 / Async Worker&lt;br&gt;• DeepEPV2PrepareAndFinalize (CUDA Graph / 异步)&lt;br&gt;• v1 HT/LL 路径提供 DBO recv_hook 双微批机制" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="360" width="288" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="r_disp" value="Dispatch：npu_moe_distribute_dispatch_v2" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#0f766e;container=0;" vertex="1" parent="1">
          <mxGeometry x="376" y="64" width="288" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="r_disp_body" value="AIV 向量核打包 + 窗口化 HCCS/SDMA/RDMA&lt;br&gt;通信与量化融合在单一融合算子内完成" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="392" y="96" width="256" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="r_gmm" value="AICore GroupedMatmul (GMM)&lt;br&gt;接收即算，按专家偏移直接启动矩阵计算" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="376" y="208" width="288" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r_comb" value="Combine：npu_moe_distribute_combine_v2" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#7b5518;container=0;" vertex="1" parent="1">
          <mxGeometry x="376" y="296" width="288" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="r_comb_body" value="专家回传后原地 Top-K 加权归约&lt;br&gt;省去独立 ReduceScatter 与临时缓冲" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="392" y="328" width="256" height="56" as="geometry"/>
        </mxCell>

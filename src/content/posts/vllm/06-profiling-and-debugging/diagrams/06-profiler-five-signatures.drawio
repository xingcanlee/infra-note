<mxfile host="wisp-diagram">
  <diagram id="vllm-07-profiler-five-signatures" name="Five Profiler Timeline Signatures">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr" value="nsys / torch_npu.profiler 五类线上时间线指纹诊断对照（Host 发射 / Device 计算 / HCCL·Copy 通信三轨）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="688" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;指纹 1 · 健康静态图重放（Device 利用 94%）&lt;/b&gt;&lt;br&gt;Host 轨仅有单根 ~0.08 ms GraphLaunch / aclmdlRI，紧接着异步筹备 Step N+1；Device 轨 Norm/Attn/MoE/Head 首尾紧贴，D2H 隐藏重叠" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="8" y="32" width="672" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;指纹 2 · 启动受限锯齿（Device 跌至 38% → 静默退回 Eager / NONE）&lt;/b&gt;&lt;br&gt;Host 排满逐算子宽发射块，Device 算子被碎片气泡切碎；先设 torch_profiler_with_stack=false 排除采集伪影，再查超桶 / splitting_ops" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="8" y="112" width="672" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;指纹 3 · Host 隐式同步排空墙（突发性全流停顿）&lt;/b&gt;&lt;br&gt;Host 出现长条 cudaStreamSynchronize / aclrtSynchronizeStream + 4 B D2H 拷贝（.item()/.cpu()），Device 队列排空空转；用 VLLM_GPU_SYNC_CHECK 拦截" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.25;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="8" y="192" width="672" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;指纹 4 · DP 跨卡长尾等待（Device 利用 58%）&lt;/b&gt;&lt;br&gt;快卡 Rank 0 早早算完却卡在 NCCL / HCCL All-to-All 长块等待；根因在同伴卡 Rank 1 承接长 Prefill Attn 或 dp_utils 负载不均" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="8" y="272" width="672" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;指纹 5 · 脏 Padding 尾部越界 / 异步 507011（表观紧凑无洞，输出乱码）&lt;/b&gt;&lt;br&gt;B=4 缩至 B=2 遗漏刷写 PAD_SLOT_ID=-1 或持久缓冲（sinks）提前回收，在无关同步点暴雷；开 LOGGING=DEBUG 核 data_ptr() 与 -1 槽" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="8" y="352" width="672" height="64" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
<mxfile host="wisp-diagram">
  <diagram id="vllm-05-dp-dispatch-consensus" name="DP Dispatch Consensus and Anti-Deadlock">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr" value="MoE（Attn DP + EP）跨卡模式对齐：未经同步的形状死锁 vs dispatch_cg_and_sync_dp 轻量共识" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="688" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="loc_box" value="&lt;b&gt;1. 本地负载与候选模式分化&lt;/b&gt;&lt;br&gt;Rank 0：4 tok 纯 Decode → FULL(2)，输出 (4, H)&lt;br&gt;Rank 1：19 tok Chunked Prefill → PIECEWISE(1)，桶 (20, H)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="8" y="32" width="328" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="dead_box" value="&lt;b&gt;2. 若无跨卡共识的后果：EP All-to-All 挂死&lt;/b&gt;&lt;br&gt;Rank 0 发 (4, H)、Rank 1 发 (20, H) 且图态错配&lt;br&gt;→ 集合通信缓冲无法对齐，直接超时 / 死锁" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.25;dashed=1;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="352" y="32" width="328" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="sync_grp" value="3. GPUModelRunner 前向入口纯主机侧共识（不阻塞 GPU 计算流）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="8" y="144" width="672" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="pack" value="&lt;b&gt;dispatch_cg_and_sync_dp 打包交换 (7, dp_size) CPU 张量&lt;/b&gt;&lt;br&gt;每卡填入 [num_tokens, cg_mode, uniform_qlen, max_qlen, ubatch, num_reqs, skip_draft] 后调 cpu_all_reduce_()" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="176" width="640" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="rule1" value="&lt;b&gt;模式取保守最小值&lt;/b&gt;&lt;br&gt;\(\min(\text{NONE}=0,\;\text{PW}=1,\;\text{FULL}=2)\)&lt;br&gt;结果：全组一致降级为 &lt;b&gt;PIECEWISE (1)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="248" width="208" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="rule2" value="&lt;b&gt;长度取最大并统一分桶&lt;/b&gt;&lt;br&gt;\(\max(4, 19) = 19 \to\) 共享档 &lt;b&gt;T = 20&lt;/b&gt;&lt;br&gt;uniform_qlen 分歧则置 None 退均匀径" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="248" y="248" width="216" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="rule3" value="&lt;b&gt;全组对称穿越 All-to-All&lt;/b&gt;&lt;br&gt;Rank 0/1 皆持对称 &lt;b&gt;(20, H)&lt;/b&gt;&lt;br&gt;O(1) 查 BatchExecutionDescriptor" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="480" y="248" width="184" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="wrap_note" value="&lt;b&gt;三层同心壳透传不变量&lt;/b&gt;：FULL 整图捕获设内层模式为 NONE 防嵌套捕获；PIECEWISE 重放纯张量子模块而 Attention 直走原生 Eager" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="24" y="336" width="640" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="e_r12" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rule1" target="rule2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_r23" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rule2" target="rule3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
        <mxCell id="e_05_06" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=0.5;exitY=1;entryX=0.757;entryY=0;" edge="1" parent="1" source="v05" target="v06">
          <mxGeometry relative="1" as="geometry"/>

<mxfile host="wisp-diagram">
  <diagram id="vllm-roadmap" name="vLLM 与昇腾推理引擎架构与排障路线图">
    <mxGraphModel dx="800" dy="680" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="hdr" value="vLLM 与昇腾引擎路线图：从显存分页到编译图、设备图与排障" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="640" height="32" as="geometry"/>
        </mxCell>

        <!-- Layer 1: Memory & Scheduler -->
        <mxCell id="l1" value="第一层 · 显存分页与请求级批调度（绿：KV 物理池与批预算）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="64" width="640" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="v_ds" value="接续系列一 · DeepSeek 14&lt;br&gt;单步算子已知，如何并发排批？" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="96" width="232" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="v01" value="01 PagedAttention 与连续批处理调度&lt;br&gt;BlockPool 块复用 · Prefix Caching · Chunked Prefill" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="280" y="96" width="360" height="48" as="geometry"/>
        </mxCell>

        <!-- Layer 2: Host Dispatch & torch.compile -->
        <mxCell id="l2" value="第二层 · 异步流队列与图编译融合（蓝：消除调度阻塞与逐元素访存）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="184" width="640" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="v02" value="02 异步执行模型与发射墙&lt;br&gt;AsyncOutput · .item() 排水陷阱" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="216" width="296" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="v03" value="03 torch.compile 与 Piecewise 编译&lt;br&gt;NoGuards · split_graph · Inductor 切分" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="344" y="216" width="296" height="56" as="geometry"/>
        </mxCell>

        <!-- Layer 3: Device Graphs (CUDA & Ascend) -->
        <mxCell id="l3" value="第三层 · 设备静态图捕获、嵌套分发与昇腾 NPU 适配（琥珀：边界控制与硬件下沉）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="312" width="640" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="v04" value="04 CUDA Graph 四道硬边界&lt;br&gt;指针冻结 · PAD_SLOT_ID · 多流闭合 · 池" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="344" width="296" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="v05" value="05 运行时分发与双模式嵌套&lt;br&gt;BatchExecutionDescriptor · FULL/PW · DP" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="344" y="344" width="296" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="v06" value="06 Ascend ACLGraph 与 npugraph_ex&lt;br&gt;CANN 调度墙 · UpdatableGraph 热更新 · ExternalEvent 跨流同步" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="416" width="608" height="56" as="geometry"/>
        </mxCell>

        <!-- Layer 4: Profiling & Debugging -->
        <mxCell id="l4" value="第四层 · 生产可观测性与五维故障定位" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="512" width="640" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="v07" value="07 性能观测与线上故障定位&lt;br&gt;nsys / msprof 四大轨迹指纹 · 静默降级 / DP 死锁 / Host Sync / 脏尾 / 图池 OOM 排障树" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#1d1d1f;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">

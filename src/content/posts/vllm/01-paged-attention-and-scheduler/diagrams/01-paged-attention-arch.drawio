  <diagram id="01-paged-attention-arch" name="PagedAttention and Prefix Caching Architecture">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Left Column: Logical Views & Prefix Hash -->
        <mxCell id="log_a" value="&lt;b&gt;Req A 逻辑块视图&lt;/b&gt;&lt;br&gt;L0: [101..104]（完整）&lt;br&gt;L1: [105,106,201,202]&lt;br&gt;L2: [decode ...]（部分）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="184" height="88" as="geometry" />
        </mxCell>
        <mxCell id="log_b" value="&lt;b&gt;Req B 逻辑块视图&lt;/b&gt;&lt;br&gt;L0: [101..104]（完整）&lt;br&gt;L1: [105,106,301,302]&lt;br&gt;L2: [303, 304, _, _]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="16" y="128" width="184" height="88" as="geometry" />
        </mxCell>
        <mxCell id="hash_box" value="&lt;b&gt;链式前缀哈希（Prefix）&lt;/b&gt;&lt;br&gt;h₀ = hash(NONE, L0)&lt;br&gt;h₁ = hash(h₀, L1, extra)&lt;br&gt;仅满块（size=B）进入哈希表" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="16" y="248" width="184" height="96" as="geometry" />
        </mxCell>

        <!-- Middle Column: Page Tables & BlockPool -->
        <mxCell id="bt_box" value="&lt;b&gt;BlockTable（页表映射）&lt;/b&gt;&lt;br&gt;逻辑下标 → 物理块号&lt;br&gt;• A: [ 0, 1, 3 ]&lt;br&gt;• B: [ 0, 2, 4 ]&lt;br&gt;（零复制，仅增 ref_cnt）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="256" y="16" width="176" height="128" as="geometry" />
        </mxCell>
        <mxCell id="pool_box" value="&lt;b&gt;BlockPool + FreeQueue&lt;/b&gt;&lt;br&gt;• 队首 popleft()：优先复&lt;br&gt;  用无哈希空白块 / 最旧缓存&lt;br&gt;• appendleft()：无哈希释放块&lt;br&gt;• append()：已封存缓存块&lt;br&gt;• 0 号保留为 null_block" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="256" y="176" width="176" height="168" as="geometry" />
        </mxCell>

        <!-- Right Column: Physical KV Pool & Device Kernel -->
        <mxCell id="hbm_grp" value="物理 HBM KV 块池（B × d_kv）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">

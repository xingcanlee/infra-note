        <mxCell id="kern_box" value="&lt;b&gt;Device KV 写入与查表计算&lt;/b&gt;&lt;br&gt;slot = phys_id × B + offset&lt;br&gt;• 写入：reshape_and_cache_flash&lt;br&gt;• 读取：Paged Attention 按&lt;br&gt;  block_table 离散拉取 K/V" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#1d1d1f;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">

  <diagram id="01-scheduler-runner-runtime" name="vLLM vs vllm-ascend Scheduler to Runner Runtime">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Top Control Plane -->
        <mxCell id="ctrl_grp" value="Host 调度层（vllm/v1/core）与昇腾扩展策略（vllm_ascend/core）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="664" height="128" as="geometry" />
        </mxCell>
        <mxCell id="sched_box" value="&lt;b&gt;Scheduler.schedule()&lt;/b&gt;&lt;br&gt;• 统一 token_budget 配额&lt;br&gt;• running → waiting 顺序&lt;br&gt;• LIFO 重算抢占" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="32" y="48" width="184" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kvc_box" value="&lt;b&gt;KVCacheManager&lt;/b&gt;&lt;br&gt;• get_computed_blocks 查缓存&lt;br&gt;• allocate_slots 追加块&lt;br&gt;• BlockPool 维护 ref_cnt" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="248" y="48" width="192" height="80" as="geometry" />
        </mxCell>
        <mxCell id="asc_sched" value="&lt;b&gt;Ascend scheduler_cls&lt;/b&gt;&lt;br&gt;• 默认复用上游 Scheduler&lt;br&gt;• 可选 Recompute / DyntraLB&lt;br&gt;  ShortReqFirst / ProfilingChunk" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">

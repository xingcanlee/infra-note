          <mxGeometry x="632" y="240" width="32" height="64" as="geometry" />
        </mxCell>

        <!-- Bottom Stage: Preemption and Prefix Cache Recovery -->
        <mxCell id="s26" value="&lt;b&gt;step = 26：块池耗尽触发 LIFO 抢占&lt;/b&gt;&lt;br&gt;• A 推进到 c=33 需第 9 块，free_q 为空&lt;br&gt;• 淘汰队尾 B：释放 B 的 8 块；blk 0 仍留给 A（ref: 2→1）&lt;br&gt;• 未封存块 [4, 5, ...] 插到 free_q 队首；已封存 blk 2 退至队尾&lt;br&gt;• A 从队首取走 blk 4，blk 2 哈希缓存完好保留" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#1d1d1f;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="352" width="312" height="144" as="geometry" />
        </mxCell>
        <mxCell id="s27" value="&lt;b&gt;step = 27：B 恢复调度并双命中缓存&lt;/b&gt;&lt;br&gt;• A 续跑 decode；B 自 waiting 队首优先接入&lt;br&gt;• B 查表双命中 blk 0（ref→2）与未逐出的 blk 2（ref=1）&lt;br&gt;• 10 tok prompt 仅重算尾部 2 tokens（new=2 → blk 5）&lt;br&gt;• step 30 A 结束释放全部块，step 54 B 完结" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="368" y="352" width="312" height="144" as="geometry" />
        </mxCell>
        <mxCell id="e26_27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="s26" target="s27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mid_down" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="pool_grp" target="s26">

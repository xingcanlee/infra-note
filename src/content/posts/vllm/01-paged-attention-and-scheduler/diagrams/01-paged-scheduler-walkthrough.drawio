          <mxGeometry x="472" y="240" width="32" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p12" value="12&lt;br&gt;A" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

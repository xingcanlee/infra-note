<mxfile host="app.diagrams.net" modified="2026-11-15T02:20:00.000Z" agent="wisp" version="24.0.0" type="device">
  <diagram id="01-paged-scheduler-walkthrough" name="Paged Scheduler Walkthrough">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Top Stage: Step 0, Step 1, Step 2 -->
        <mxCell id="s0" value="&lt;b&gt;step = 0（chunk prefill）&lt;/b&gt;&lt;br&gt;A 到达：8 prompt tokens&lt;br&gt;调度 +6（budget=6）&lt;br&gt;A: [0, 1]（blk 0 封存, ref=1）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;step = 1（Prefix Hit 共享）&lt;/b&gt;&lt;br&gt;A 续算 +2 完结 prefill（c=8）&lt;br&gt;余 budget=4 接入 B（10 tok）&lt;br&gt;B 命中 blk 0（ref=2）+4 → [0, 2]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="248" y="16" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;step = 2（P+D 混批）&lt;/b&gt;&lt;br&gt;A 进入 decode +1（c=9）→ 分配 blk 3&lt;br&gt;B 补齐 prefill +2（c=10）→ blk 4&lt;br&gt;live = 5 / 16 块（本步共耗 3 tok）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="16" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="e01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="s0" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Middle Stage: Step 25 Full 16 Physical Blocks -->
        <mxCell id="pool_grp" value="step = 25：16 个物理块全部占满（live = 16 / 16，总容量 64 tokens）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="152" width="664" height="168" as="geometry" />
        </mxCell>
        <mxCell id="bt_a" value="Req A 页表（c=32）：[0, 1, 3, 6, 8, 10, 12, 14]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="32" y="184" width="312" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bt_b" value="Req B 页表（c=33）：[0, 2, 4, 5, 7, 9, 11, 13, 15]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="352" y="184" width="312" height="40" as="geometry" />
        </mxCell>


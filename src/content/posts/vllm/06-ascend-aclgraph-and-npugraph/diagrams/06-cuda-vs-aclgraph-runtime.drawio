        <mxCell id="nv1" value="&lt;b&gt;1. 编译: TorchInductor + Triton&lt;/b&gt;&lt;br&gt;原生代码生成 PTX / CUBIN 融合算子" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

<mxfile host="app.diagrams.net" modified="2026-11-15T02:25:00.000Z" agent="wisp" version="24.0.0" type="device">
  <diagram id="02-launch-wall-arch" name="PyTorch Launch Stack and Two Orthogonally Addressed Overheads">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Top Stage: 4-Stage Dispatch Stack -->
        <mxCell id="stack_grp" value="PyTorch Eager 单算子发射链（每次小算子重复 ~15–30us Host 开销 vs ~5–15us 设备算子执行）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="664" height="128" as="geometry" />
        </mxCell>
        <mxCell id="st_py" value="&lt;b&gt;1. Python 层&lt;/b&gt;&lt;br&gt;Module.__call__&lt;br&gt;动态构造 Tensor / 校验" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="48" width="136" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_disp" value="&lt;b&gt;2. C++ Dispatcher&lt;/b&gt;&lt;br&gt;DispatchKeySet 解析&lt;br&gt;Autograd / Backend 路由" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="192" y="48" width="144" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_rt" value="&lt;b&gt;3. Runtime 入队&lt;/b&gt;&lt;br&gt;cudaLaunchKernel /&lt;br&gt;CANN aclnn 异步压入流" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="360" y="48" width="144" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_dev" value="&lt;b&gt;4. Device 流执行&lt;/b&gt;&lt;br&gt;CUDA / Ascend 流&lt;br&gt;实际运行 ~8us" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="528" y="48" width="136" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="st_py" target="st_disp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="st_disp" target="st_rt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="st_rt" target="st_dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bottom Left: Inter-step Control Overhead -> Chapter 2 Solution -->
        <mxCell id="b_left" value="&lt;b&gt;瓶颈 A：步间调度与回传等待（本章解决）&lt;/b&gt;&lt;br&gt;• Scheduler.schedule() 组批 + 块表维护&lt;br&gt;• ModelRunner.prepare_inputs() 填张量&lt;br&gt;• 步尾采样 D2H 拷贝（等待 GPU 结果再算下一步）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="16" y="176" width="312" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s_left" value="&lt;b&gt;解法：Async Scheduling + 预分配缓冲&lt;/b&gt;&lt;br&gt;• step_with_batch_queue 与 AsyncScheduler 提前排布 step t+1&lt;br&gt;• AsyncOutput 在独立 copy_stream 异步 D2H&lt;br&gt;• InputBuffers 常驻显存避免步间反复 malloc" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="16" y="304" width="312" height="104" as="geometry" />
        </mxCell>
        <mxCell id="el_down" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#2f5783;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="b_left" target="s_left">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bottom Right: Intra-step Launch Wall -> Next Chapters -->
        <mxCell id="b_right" value="&lt;b&gt;瓶颈 B：步内逐算子发射墙（本章无法单独消除）&lt;/b&gt;&lt;br&gt;• 每次 decode 仍需在 forward() 跑 300+ 次 Python/C++&lt;br&gt;• 320 ops × ~20us = 6.4ms CPU，远超 2.56ms 设备计算&lt;br&gt;• 单开 Async Scheduling 仍受限（加速比仅 1.00x）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="368" y="176" width="312" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s_right" value="&lt;b&gt;后续解法（第 03–06 篇）：算子融合与图重放&lt;/b&gt;&lt;br&gt;• torch.compile + Piecewise 编译整合 Python 碎块&lt;br&gt;• CUDA Graph / ACLGraph 整步仅 1 次 ~45us 发射&lt;br&gt;• 与 Async Scheduling 叠加：提速 2.63x，利用率 97.6%" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="368" y="304" width="312" height="104" as="geometry" />
        </mxCell>
        <mxCell id="er_down" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#984646;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="b_right" target="s_right">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_stack_l" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.25;endArrow=block;endFill=1;" edge="1" parent="1" source="st_disp" target="b_left">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="160" />
              <mxPoint x="172" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_stack_r" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.25;endArrow=block;endFill=1;" edge="1" parent="1" source="st_disp" target="b_right">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="296" y="160" />
              <mxPoint x="524" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>

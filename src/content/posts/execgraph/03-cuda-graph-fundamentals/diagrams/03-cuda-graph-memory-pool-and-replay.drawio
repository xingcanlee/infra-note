<mxfile host="wisp-diagram">
  <diagram id="aclgraph-03-mempool-replay" name="CUDA Graph Memory Pool and Replay">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="8" guides="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cap_grp" value="1. Capture 捕获期：B_cap = 8 地址硬编码进图节点" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Inter, Noto Sans SC;fontSize=12;fontStyle=1;fontColor=#2f5783;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="688" height="168" as="geometry" />
        </mxCell>
        <mxCell id="c_buf" value="static_x 静态输入槽&lt;br&gt;固定指针 0x7f00_1000" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="40" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c_dag" value="cudaGraph_t 静态 DAG&lt;br&gt;固化 Kernel 指针与参数" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="216" y="40" width="216" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c_pool" value="global_graph_pool&lt;br&gt;桶间互斥复用中间页" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;shadow=0;container=0;align=center;verticalAlign=middle;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="472" y="32" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c_note" value="结尾调用 weak_ref_outputs() 释放强引用，避免几十个分桶把整卡显存长期锁死" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter, Noto Sans SC;fontSize=11;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="16" y="120" width="656" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ec1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=10;" edge="1" parent="1" source="c_buf" target="c_dag">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=10;" edge="1" parent="1" source="c_dag" target="c_pool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rep_grp" value="2. Replay 重放期（真实批量 B_real = 6，对齐桶 B_cap = 8）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Inter, Noto Sans SC;fontSize=12;fontStyle=1;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="200" width="688" height="224" as="geometry" />
        </mxCell>
        <mxCell id="ok_box" value="正确路径：原地覆写与安全填充" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Inter, Noto Sans SC;fontSize=12;fontStyle=1;fontColor=#2c522d;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="232" width="320" height="176" as="geometry" />
        </mxCell>
        <mxCell id="ok_1" value="static_x[:6].copy_(real_x)&lt;br&gt;内容写入固化地址 0x7f00_1000" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="264" width="288" height="48" as="geometry" />
        </mxCell>
        <mxCell id="ok_2" value="尾槽 6..7：slot_mapping = -1&lt;br&gt;is_padding = True 防脏写 KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="336" width="288" height="56" as="geometry" />
        </mxCell>
        <mxCell id="eo1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=6;" edge="1" parent="1" source="ok_1" target="ok_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="err_box" value="典型踩坑：静默读旧值与脏写" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Inter, Noto Sans SC;fontSize=12;fontStyle=1;fontColor=#7b5518;container=0;" vertex="1" parent="1">
          <mxGeometry x="352" y="232" width="320" height="176" as="geometry" />
        </mxCell>
        <mxCell id="err_1" value="直接重赋值 x = new_tensor&lt;br&gt;新地址 0x7f00_9999 被图忽略" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="368" y="264" width="288" height="48" as="geometry" />
        </mxCell>
        <mxCell id="err_2" value="静态图仍从 0x7f00_1000 读旧数据&lt;br&gt;尾槽未清零则会写坏其他请求 KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="368" y="336" width="288" height="56" as="geometry" />
        </mxCell>
        <mxCell id="ee1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=6;" edge="1" parent="1" source="err_1" target="err_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

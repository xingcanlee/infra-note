<mxfile host="wisp-diagram">
  <diagram id="csa-pipeline" name="CSA：重叠压缩、稀疏选择、窗口补洞与 MQA 输出">
    <mxGraphModel dx="1900" dy="1000" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="CSA：先按 \(m\) 压缩，再在压缩条目上做稀疏选择" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="32" y="16" width="1200" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="subnote" value="压缩把序列缩短 \(m\) 倍；indexer 在压缩序列上取 top-\(k\)；窗口分支补回当前块的近邻细节。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="32" y="56" width="960" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="H" value="hidden state&lt;br&gt;\(\mathbf H\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="128" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="projA" value="当前块：内容 + 权重&lt;br&gt;\(C^a=HW^{aKV}\)&lt;br&gt;\(Z^a=HW^{aZ}\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="256" y="80" width="256" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="projB" value="前一块：内容 + 权重&lt;br&gt;\(C^b=HW^{bKV}\)&lt;br&gt;\(Z^b=HW^{bZ}\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="256" y="184" width="256" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="overlap" value="重叠读取当前块 + 前一块&lt;br&gt;\(2m\) 个元素一起 Softmax&lt;br&gt;\([S^a;S^b]=\mathrm{Softmax}(\cdot)\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="576" y="104" width="320" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="comp" value="$$C_i^{\mathrm{Comp}}=\sum_j S_j^a\odot C_j^a+\sum_j S_j^b\odot C_j^b$$&lt;br&gt;\(n/m\) 个压缩条目" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="960" y="120" width="240" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="compnote" value="每个条目看 \(2m\) 个 token&lt;br&gt;但序列只缩到 \(1/m\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="576" y="248" width="304" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="cQ" value="query latent&lt;br&gt;\(c_t^Q=h_tW^{DQ}\)&lt;br&gt;主注意力与 indexer 共用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="256" y="376" width="208" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="qbox" value="indexer query / head 权重&lt;br&gt;\(q_t^I=c_t^QW^{IUQ}\)&lt;br&gt;\(w_t^I=h_tW^w\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="528" y="376" width="256" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="K" value="indexer key&lt;br&gt;\(K_s^{\mathrm{IComp}}\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="896" y="288" width="224" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="score" value="$$I_{t,s}=\sum_{h=1}^{n_h^I}w_{t,h}^I\mathrm{ReLU}\big(q_{t,h}^I\cdot K_s^{\mathrm{IComp}}\big)$$" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="848" y="360" width="320" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="topk" value="Top-\(k\)&lt;br&gt;\(k=512\,/\,1024\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="1224" y="372" width="176" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="sel" value="\(\mathcal C_t^{\mathrm{SprsComp}}\)&lt;br&gt;选中的压缩条目&lt;br&gt;只传下标" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="1448" y="368" width="224" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="recent" value="最近 \(n_{\mathrm{win}}=128\) 个&lt;br&gt;未压缩 token 的 K/V" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="256" y="552" width="336" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="core" value="Core attention（MQA）&lt;br&gt;选中压缩条目 + 最近窗口&lt;br&gt;所有 query head 共享 KV" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="960" y="544" width="336" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="proj" value="分组输出投影（\(g\) 组）&lt;br&gt;控制输出矩阵参数量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="1360" y="552" width="224" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="out" value="输出&lt;br&gt;\(\mathbf o_t\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="1648" y="560" width="144" height="64" as="geometry"/>
        </mxCell>

        <mxCell id="corenode" value="压缩严格因果：当前块还没压完，query 读不到同块近邻；窗口分支补这个洞。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#b45309;" vertex="1" parent="1">
          <mxGeometry x="960" y="680" width="560" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="KV 存储：RoPE 维度 BF16，其余维度 FP8。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="32" y="728" width="1200" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="e_H_projA" value="" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="H" target="projA">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="224" y="148"/>
              <mxPoint x="224" y="116"/>

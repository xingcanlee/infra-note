          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_cQ_core" value="\(\mathbf q_t\)" style="endArrow=classic;html=1;strokeColor=#1d4ed8;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.25;exitY=1;entryX=0.5;entryY=1;fontFamily=Inter;fontSize=12;fontColor=#1d4ed8;" edge="1" parent="1" source="cQ" target="core">

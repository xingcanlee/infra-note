        <mxCell id="e_H_recent" value="" style="endArrow=classic;html=1;strokeColor=#b45309;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.3;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="H" target="recent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="80" y="592"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_sel_core" value="只传下标" style="endArrow=classic;html=1;strokeColor=#15803d;strokeWidth=1.5;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.35;exitY=1;entryX=0.5;entryY=0;fontFamily=Inter;fontSize=12;fontColor=#15803d;" edge="1" parent="1" source="sel" target="core">

<mxfile host="wisp-diagram"><diagram id="p" name="CSA：先按 m 压缩，再在压缩条目上做稀疏选择"><mxGraphModel dx="1900" dy="1040" grid="1" gridSize="8" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CSA：先按 m 压缩，再在压缩条目上做稀疏选择" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="16" width="1200" height="32" as="geometry"/></mxCell><mxCell id="H" value="hidden state H" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="32" y="128" width="160" height="64" as="geometry"/></mxCell><mxCell id="wa" value="C^a = H·W^aKV" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="256" y="96" width="176" height="80" as="geometry"/></mxCell><mxCell id="wb" value="C^b = H·W^bKV" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="256" y="224" width="176" height="80" as="geometry"/></mxCell><mxCell id="za" value="Z^a&lt;br&gt;压缩权重" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="480" y="96" width="144" height="80" as="geometry"/></mxCell><mxCell id="zb" value="Z^b&lt;br&gt;压缩权重" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="480" y="224" width="144" height="80" as="geometry"/></mxCell><mxCell id="overlap" value="重叠取区间&lt;br&gt;第 i 个条目取 C^a[mi:m(i+1)−1]&lt;br&gt;与 C^b[m(i−1):mi−1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="688" y="128" width="272" height="112" as="geometry"/></mxCell><mxCell id="overnote" value="每个条目看 2m 个 token，&lt;br&gt;序列只缩到 1/m" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#15803d;" vertex="1" parent="1"><mxGeometry x="688" y="256" width="272" height="48" as="geometry"/></mxCell><mxCell id="soft" value="加可学习位置偏置 B^a/B^b&lt;br&gt;在 2m 个元素上 Softmax" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="960" y="136" width="224" height="96" as="geometry"/></mxCell><mxCell id="comp" value="C^Comp&lt;br&gt;n/m 个压缩条目" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1208" y="144" width="192" height="80" as="geometry"/></mxCell><mxCell id="ik" value="再压一次：indexer key K^IComp" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1192" y="288" width="208" height="80" as="geometry"/></mxCell><mxCell id="li" value="Lightning Indexer&lt;br&gt;打分" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1440" y="288" width="176" height="80" as="geometry"/></mxCell><mxCell id="tk" value="Top-k 压缩条目&lt;br&gt;k=512/1024" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1440" y="432" width="176" height="80" as="geometry"/></mxCell><mxCell id="recent" value="最近 n_win=128 个&lt;br&gt;未压缩 token 的 KV" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="944" y="640" width="248" height="96" as="geometry"/></mxCell><mxCell id="rnote" value="压缩严格因果：读不到自己块内&lt;br&gt;其他 token，这条分支补这个洞。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1040" y="752" width="320" height="48" as="geometry"/></mxCell><mxCell id="core" value="共享 KV 的 MQA core attention" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1192" y="640" width="240" height="80" as="geometry"/></mxCell><mxCell id="proj" value="分组输出投影（g 组）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1440" y="640" width="176" height="80" as="geometry"/></mxCell><mxCell id="out" value="输出" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1440" y="784" width="176" height="64" as="geometry"/></mxCell><mxCell id="note" value="注：KV 存储：RoPE 维度 BF16，其余 FP8" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1"><mxGeometry x="32" y="880" width="1600" height="24" as="geometry"/></mxCell><mxCell id="e_H_wa" value="" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=1.5;" edge="1" parent="1" source="H" target="wa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id
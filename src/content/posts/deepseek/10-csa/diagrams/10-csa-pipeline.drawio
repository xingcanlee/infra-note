        </mxCell>
        <mxCell id="e_projB_overlap" value="" style="endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="projB" target="overlap">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="544" y="220"/>

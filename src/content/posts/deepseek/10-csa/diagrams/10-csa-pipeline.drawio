        <mxCell id="e_qbox_score" value="" style="endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="qbox" target="score">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_comp_K" value="" style="endArrow=classic;html=1;strokeColor=#b45309;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="comp" target="K">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_K_score" value="" style="endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="K" target="score">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_score_topk" value="" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="score" target="topk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

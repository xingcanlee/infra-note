        <mxCell id="e_core_proj" value="" style="endArrow=classic;html=1;strokeColor=#1d4ed8;strokeWidth=2.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="core" target="proj">

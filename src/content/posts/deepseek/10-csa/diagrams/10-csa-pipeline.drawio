<mxfile host="wisp-diagram">
  <diagram id="csa-pipeline" name="CSA：先按 m 压缩，再在压缩条目上做稀疏选择">
    <mxGraphModel dx="800" dy="900" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="H" value="hidden state \(\mathbf H\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="232" y="0" width="176" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="projA" value="当前块&lt;br&gt;\(C^a=HW^{aKV}\)&lt;br&gt;\(Z^a=HW^{aZ}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="64" width="128" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="projB" value="前一块&lt;br&gt;\(C^b=HW^{bKV}\)&lt;br&gt;\(Z^b=HW^{bZ}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="64" width="128" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="overlap" value="重叠读取当前块 + 前一块&lt;br&gt;\(2m\) 个元素一起 Softmax&lt;br&gt;\([S^a;S^b]=\mathrm{Softmax}(\cdot)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="152" width="280" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="comp" value="\(C_i^{\mathrm{Comp}}=\sum_j\big(S_j^a\odot C_j^a+S_j^b\odot C_j^b\big)\)&lt;br&gt;\(n/m\) 个压缩条目" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="240" width="280" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="K" value="indexer key \(K_s^{\mathrm{IComp}}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="336" width="280" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="cQ" value="query latent \(c_t^Q=h_tW^{DQ}\)&lt;br&gt;主注意力与 indexer 共用" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="336" y="152" width="280" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="qbox" value="indexer query / head 权重&lt;br&gt;\(q_t^I=c_t^QW^{IUQ}\)&lt;br&gt;\(w_t^I=h_tW^w\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="336" y="240" width="280" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="score" value="\(\displaystyle I_{t,s}=\sum_{h=1}^{n_h^I}w_{t,h}^I\,\mathrm{ReLU}\big(q_{t,h}^I\cdot K_s^{\mathrm{IComp}}\big)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="408" width="592" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="topk" value="Top-\(k\)，\(k=512\,/\,1024\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="512" width="200" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="sel" value="\(\mathcal C_t^{\mathrm{SprsComp}}\)&lt;br&gt;选中的压缩条目，只传下标" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="296" y="512" width="288" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="recent" value="最近 \(n_{\mathrm{win}}=128\) 个&lt;br&gt;未压缩 token 的 K/V" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="600" width="200" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="core" value="Core attention（MQA）&lt;br&gt;选中压缩条目 + 最近窗口&lt;br&gt;所有 query head 共享 KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="296" y="600" width="288" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="qlabel" value="\(\mathbf q_t\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#2f5783;" vertex="1" parent="1">
          <mxGeometry x="592" y="608" width="40" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="proj" value="分组输出投影（\(g\) 组）&lt;br&gt;控制输出矩阵参数量" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="296" y="696" width="288" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="out" value="输出 \(\mathbf o_t\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="360" y="776" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="压缩：每个条目看 \(2m\) 个 token，但序列只缩到 \(1/m\)；indexer 在压缩序列上取 top-\(k\)。&lt;br&gt;窗口分支：压缩严格因果，当前块还没压完时 query 读不到同块近邻，由最近窗口补上。&lt;br&gt;KV 存储：RoPE 维度 BF16，其余维度 FP8。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="832" width="640" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="e1_H_projA" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#5c6067;strokeWidth=1.25;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="H" target="projA">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_H_projB" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#5c6067;strokeWidth=1.25;exitX=0.0909;exitY=1;exitDx=0;exitDy=0;entryX=0.5625;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="H" target="projB">

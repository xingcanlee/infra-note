        <mxCell id="e_H_projB" value="" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="H" target="projB">
          <mxGeometry relative="1" as="geometry">

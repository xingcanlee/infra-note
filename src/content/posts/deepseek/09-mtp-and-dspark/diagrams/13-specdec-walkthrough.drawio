<mxfile host="app.diagrams.net">
  <diagram id="13-specdec-walkthrough" name="投机采样 3 词表无损验证演练">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="q_box" value="&lt;b&gt;草稿分布 \(q(x)\)&lt;/b&gt;&lt;br&gt;A: 0.40 &amp;nbsp;|&amp;nbsp; B: 0.45 &amp;nbsp;|&amp;nbsp; C: 0.15" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="208" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p_box" value="&lt;b&gt;目标分布 \(p(x)\)&lt;/b&gt;&lt;br&gt;A: 0.50 &amp;nbsp;|&amp;nbsp; B: 0.20 &amp;nbsp;|&amp;nbsp; C: 0.30" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="16" width="208" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule_box" value="&lt;b&gt;无损拒绝判定&lt;/b&gt;&lt;br&gt;采样 \(x \sim q\)，\(r \sim U(0,1)\)&lt;br&gt;\(r \le \min(1,\, p(x)/q(x))\) 则接收" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="464" y="16" width="216" height="80" as="geometry" />
        </mxCell>

        <mxCell id="grp_verify" value="按草稿候选分流验证（单步期望接受率 β = 0.40 + 0.20 + 0.15 = 0.75）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8b9098;fontColor=#1d1d1f;strokeWidth=1.25;dashed=1;dashPattern=6 4;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="16" y="128" width="664" height="152" as="geometry" />
        </mxCell>

        <mxCell id="br_ac" value="&lt;b&gt;草稿为 A 或 C（0.55）&lt;/b&gt;&lt;br&gt;\(p(x) \ge q(x) \Rightarrow\) 100% 接收&lt;br&gt;贡献：A = 0.40，C = 0.15" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="32" y="176" width="184" height="88" as="geometry" />
        </mxCell>
        <mxCell id="br_b_acc" value="&lt;b&gt;草稿为 B 且接收（0.20）&lt;/b&gt;&lt;br&gt;\(p/q = 0.20 / 0.45 = 4/9\)&lt;br&gt;贡献：B = 0.45 × 4/9 = 0.20" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="232" y="176" width="200" height="88" as="geometry" />
        </mxCell>
        <mxCell id="br_b_rej" value="&lt;b&gt;草稿为 B 且拒绝（0.25）&lt;/b&gt;&lt;br&gt;拒绝率 \(1 - 4/9 = 5/9\)&lt;br&gt;重分配多出的 0.25 权重" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="448" y="176" width="216" height="88" as="geometry" />
        </mxCell>

        <mxCell id="res_box" value="&lt;b&gt;残差恢复分布 \(p'(x) = \mathrm{norm}(\max(0,\, p(x) - q(x)))\)&lt;/b&gt;&lt;br&gt;\(p - q = [+0.10,\; -0.25,\; +0.15]\)&lt;br&gt;\(\Rightarrow p'(x) = [0.40,\; 0.00,\; 0.60]\)&lt;br&gt;补回：A +0.25×0.40 (+0.10) &amp;nbsp;|&amp;nbsp; C +0.25×0.60 (+0.15)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="336" y="304" width="344" height="96" as="geometry" />
        </mxCell>

        <mxCell id="final_box" value="&lt;b&gt;最终输出边际分布严格等于目标分布 \(p(x)\)&lt;/b&gt;&lt;br&gt;A: \(0.40 + 0.10 = 0.50\) &amp;nbsp;|&amp;nbsp; B: \(0.20\) &amp;nbsp;|&amp;nbsp; C: \(0.15 + 0.15 = 0.30\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="432" width="664" height="64" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="q_box" target="grp_verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p_box" target="grp_verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="rule_box" target="grp_verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7b5518;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="br_b_rej" target="res_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2c522d;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="br_ac" target="final_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="124" y="344" />
              <mxPoint x="124" y="432" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2c522d;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="br_b_acc" target="final_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="344" />
              <mxPoint x="320" y="432" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7b5518;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="res_box" target="final_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="512" y="416" />
              <mxPoint x="512" y="432" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="注：残差分布 p'(x) 只把高估词 B 多出的 0.25 权重补回给缺口词 A 与 C，从而在数学上实现零偏差采样。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#5c6067;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="16" y="504" width="664" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
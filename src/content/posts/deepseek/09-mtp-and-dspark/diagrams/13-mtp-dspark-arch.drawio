<mxfile host="app.diagrams.net">
  <diagram id="13-mtp-dspark-arch" name="DeepSeek-V3 因果串联 MTP 与 V4.1 DSpark 半自回归架构对比">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="col_mtp" value="DeepSeek-V3：因果串联 MTP（串行 K 步）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8b9098;fontColor=#1d1d1f;strokeWidth=1.25;dashed=1;dashPattern=6 4;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="16" width="304" height="448" as="geometry" />
        </mxCell>
        <mxCell id="mtp_1" value="&lt;b&gt;1. 双路 RMSNorm 输入&lt;/b&gt;&lt;br&gt;\(\mathrm{hnorm}(h^{k-1}_i)\) 与 \(\mathrm{enorm}(\mathrm{Emb}(t_{i+k}))\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="64" y="64" width="272" height="64" as="geometry" />
        </mxCell>
        <mxCell id="mtp_2" value="&lt;b&gt;2. 线性拼合降维（eh_proj: 2H → H）&lt;/b&gt;&lt;br&gt;融合前步隐状态与上一步已知词元" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="64" y="160" width="272" height="64" as="geometry" />
        </mxCell>
        <mxCell id="mtp_3" value="&lt;b&gt;3. 第 k 级 Transformer 块（mtp_block）&lt;/b&gt;&lt;br&gt;因果注意力更新并写入草稿 KV Cache" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="64" y="256" width="272" height="64" as="geometry" />
        </mxCell>
        <mxCell id="mtp_4" value="&lt;b&gt;4. 共享输出头 &amp; 串行推进（k = 1..K）&lt;/b&gt;&lt;br&gt;经 SharedHead 采样 \(t_{i+k+1}\)，喂给第 k+1 步；&lt;br&gt;草稿总时延随 K 线性累加" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="64" y="352" width="272" height="96" as="geometry" />
        </mxCell>

        <mxCell id="col_dspark" value="V4.1 DSpark：半自回归并行 + 轻链" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8b9098;fontColor=#1d1d1f;strokeWidth=1.25;dashed=1;dashPattern=6 4;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="368" y="16" width="312" height="448" as="geometry" />
        </mxCell>
        <mxCell id="ds_1" value="&lt;b&gt;1. 目标多层隐状态投影注入&lt;/b&gt;&lt;br&gt;\(H_{\mathrm{ctx}}\) 经 context_wkv_proj 写入 SWA KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="384" y="64" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ds_2" value="&lt;b&gt;2. 并行块主干（3 层 SWA W=128，γ=5）&lt;/b&gt;&lt;br&gt;Anchor + (γ-1) Mask 单次输出 \(U_{1..\gamma}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5eef9;strokeColor=#4d335c;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="384" y="160" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ds_3" value="&lt;b&gt;3. 低秩马尔可夫序列头（r = 256）&lt;/b&gt;&lt;br&gt;\(L_k = U_k + W_1[x_{k-1}]W_2\) 补齐词间转移" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="384" y="256" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ds_4" value="&lt;b&gt;4. 置信度头 &amp; 硬件感知前缀调度&lt;/b&gt;&lt;br&gt;\(c_k = \sigma(w^\top [h_k;\, W_1[x_{k-1}]])\) 估存活率；&lt;br&gt;按批容量动态裁剪各请求前缀长度 \(\ell_r\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="384" y="352" width="280" height="96" as="geometry" />
        </mxCell>

        <mxCell id="m_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="mtp_1" target="mtp_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="mtp_2" target="mtp_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="mtp_3" target="mtp_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2f5783;strokeWidth=1.25;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mtp_4" target="mtp_1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="32" y="400" />
              <mxPoint x="32" y="96" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="loop_lbl" value="步进&lt;br&gt;k+1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#5c6067;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="232" width="32" height="32" as="geometry" />
        </mxCell>

        <mxCell id="d_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="ds_1" target="ds_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="ds_2" target="ds_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="ds_3" target="ds_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="注：两者都共享主干词表 embed_tokens / lm_head；DSpark 将昂贵的 K 步重型块前向压缩为 1 次并行，序列依赖交由低秩轻链完成。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#5c6067;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="16" y="472" width="664" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
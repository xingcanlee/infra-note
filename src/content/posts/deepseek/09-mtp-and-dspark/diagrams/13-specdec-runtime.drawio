<mxfile host="app.diagrams.net">
  <diagram id="13-specdec-runtime" name="vLLM MRV2 与昇腾 V2 推测解码生产运行时对比">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="top_verify" value="&lt;b&gt;Target Verify 主干验证 &amp;amp; 无损拒绝采样（RejectionSampler）&lt;/b&gt;&lt;br&gt;TargetDependentARSpeculator / MTPSpeculator 统一填充至 1 + γ → _verify_in_chunks 输出 num_sampled 与 num_rejected" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="664" height="72" as="geometry" />
        </mxCell>

        <mxCell id="col_gpu" value="NVIDIA GPU：vLLM MRV2" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8b9098;fontColor=#1d1d1f;strokeWidth=1.25;dashed=1;dashPattern=6 4;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="16" y="120" width="320" height="272" as="geometry" />
        </mxCell>
        <mxCell id="gpu_1" value="&lt;b&gt;FULL CUDA Graph 均匀填充&lt;/b&gt;&lt;br&gt;get_uniform_decode_token_count 固定 1+γ，&lt;br&gt;保留被拒槽位以复用 Target 注意力元数据" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="32" y="168" width="288" height="64" as="geometry" />
        </mxCell>
        <mxCell id="gpu_2" value="&lt;b&gt;CSA/DSA 稀疏索引跨步复用&lt;/b&gt;&lt;br&gt;index_share_for_mtp_iteration 第 0 步写 topk，&lt;br&gt;第 1+ 步调用 set_skip_topk(True)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="32" y="240" width="288" height="64" as="geometry" />
        </mxCell>
        <mxCell id="gpu_3" value="&lt;b&gt;DSpark TP 词表分片链式采样&lt;/b&gt;&lt;br&gt;all_to_all_vocab_shards 切分 batch 后本地串联" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="32" y="312" width="288" height="64" as="geometry" />
        </mxCell>

        <mxCell id="col_npu" value="昇腾 NPU：vLLM-Ascend V2" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8b9098;fontColor=#1d1d1f;strokeWidth=1.25;dashed=1;dashPattern=6 4;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="352" y="120" width="328" height="272" as="geometry" />
        </mxCell>
        <mxCell id="npu_1" value="&lt;b&gt;ACLGraph 包装与 PCP 元数据对齐&lt;/b&gt;&lt;br&gt;AscendTargetDependentARSpeculator + sp_padding_mask&lt;br&gt;草稿预填充绕开 FULL 图，截断至真实槽位" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="368" y="168" width="296" height="64" as="geometry" />
        </mxCell>
        <mxCell id="npu_2" value="&lt;b&gt;LM Head TP 集合通信尺寸对齐&lt;/b&gt;&lt;br&gt;LmheadTPDraftSamplingMixin 统一 pad/trim，&lt;br&gt;消除跨步采样时的静默形状错配" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="368" y="240" width="296" height="64" as="geometry" />
        </mxCell>
        <mxCell id="npu_3" value="&lt;b&gt;PD 分离 P 侧上下文 &amp;amp; 昇腾拒绝核&lt;/b&gt;&lt;br&gt;initialize_local_context；禁 fp64 与水印，&lt;br&gt;支持基于信息熵的变体拒绝核验" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="368" y="312" width="296" height="64" as="geometry" />
        </mxCell>

        <mxCell id="bot_budget" value="&lt;b&gt;AdaptiveVerificationManager 动态草稿预算分配&lt;/b&gt;&lt;br&gt;按 t-2 步滞后容量上限 K（满足非预期因果律）对全批累积存活率 a_{r,j} 排序，分配每请求前缀长度 ℓ_r" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="424" width="664" height="64" as="geometry" />
        </mxCell>

        <mxCell id="e_top_gpu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="top_verify" target="col_gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_top_npu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="top_verify" target="col_npu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gpu_bot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="col_gpu" target="bot_budget">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_npu_bot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="col_npu" target="bot_budget">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="注：两条后端共享 MRV2 状态机契约，差异聚焦在设备图捕获边界、TP 集合通信对齐与 NPU 算子精度约束。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#5c6067;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="16" y="496" width="664" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
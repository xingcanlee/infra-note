<mxfile host="wisp-diagram">
  <diagram id="indexer-arch" name="Lightning Indexer Architecture and Warmup">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="688" pageHeight="456" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="闪电索引器算子（MQA 单头 Key + FP8 ReLU）" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1.25;dashed=1;dashPattern=6 4;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="656" height="208" as="geometry" />
        </mxCell>
        <mxCell id="3" value="索引 Query 投影&lt;br&gt;\(q_{t,j}^I \in \mathbb{R}^{128}\)（64 头）" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="32" y="56" width="152" height="56" as="geometry" />
        </mxCell>
        <mxCell id="4" value="1 头共享 Key 缓存&lt;br&gt;\(k_s^I\) FP8 + ue8m0&lt;br&gt;（132 B/tok）" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="32" y="136" width="152" height="64" as="geometry" />
        </mxCell>
        <mxCell id="5" value="内积与 ReLU 激活&lt;br&gt;\(\operatorname{ReLU}(q_{t,j}^I \cdot k_s^I)\)&lt;br&gt;非负稀疏，免 Softmax" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="232" y="80" width="160" height="88" as="geometry" />
        </mxCell>
        <mxCell id="6" value="头权重 \(w_{t,j}^I\)（线性投影自隐状态）" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="440" y="56" width="216" height="48" as="geometry" />
        </mxCell>
        <mxCell id="7" value="加权求和输出索引分&lt;br&gt;\(I_{t,s} = \sum_{j=1}^{H^I} w_{t,j}^I \operatorname{ReLU}(\dots)\)&lt;br&gt;取 Top-k（k=2048）" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="128" width="216" height="72" as="geometry" />
        </mxCell>
        <mxCell id="8" value="两阶段稀疏化训练（对齐稠密 MLA 注意力分布）" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1.25;dashed=1;dashPattern=6 4;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="16" y="248" width="656" height="192" as="geometry" />
        </mxCell>
        <mxCell id="9" value="阶段一：Dense Warm-up（2.1B 词元）&lt;br&gt;• 冻结主模型，保留全量稠密 MLA&lt;br&gt;• 聚合各头分布并 L1 归一化为目标 \(p_{t,:}\)&lt;br&gt;• 仅用 KL 散度训索引器：&lt;br&gt;\(\mathbb{D}_{\mathrm{KL}}(p_{t,:} \,\|\, \operatorname{Softmax}(I_{t,:}))\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="32" y="288" width="280" height="136" as="geometry" />
        </mxCell>
        <mxCell id="10" value="阶段二：Sparse Training（k=2048）&lt;br&gt;• 启用 Top-2048，主模型仅算选中子集 \(S_t\)&lt;br&gt;• 语言模型 Loss 只更新主模型参数&lt;br&gt;• 索引器仅在 \(S_t\) 上训 KL 散度&lt;br&gt;• Detach 切断梯度回传，双向互不干扰" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="376" y="288" width="280" height="136" as="geometry" />
        </mxCell>
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f5783;strokeWidth=1.25;endArrow=block;endFill=1;" edge="1" parent="1" source="3" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=1.25;endArrow=block;endFill=1;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=1.25;endArrow=block;endFill=1;" edge="1" parent="1" source="5" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f5783;strokeWidth=1.25;endArrow=block;endFill=1;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c6067;strokeWidth=1.25;endArrow=block;endFill=1;" edge="1" parent="1" source="9" target="10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

<mxfile host="wisp-diagram">
  <diagram id="nsa-sram-runtime" name="NSA GQA组中心SRAM调度对比与vLLM/Ascend生产演进坐标">
    <mxGraphModel dx="640" dy="440" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bad_hdr" value="反例：按头独立选块 / 逐 token 散读" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#984646;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="296" height="24" as="geometry" />
        </mxCell>
        <mxCell id="good_hdr" value="NSA：以 GQA 组为中心的 SRAM 调度" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#2c522d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="328" y="0" width="296" height="24" as="geometry" />
        </mxCell>
        <mxCell id="bad_1" value="GQA 组内 \(G_q\) 个头各自挑选 Top-\(n\)&lt;br&gt;HBM 被迫拉取所有头选块的并集&lt;br&gt;16 头选块并集几乎退回全量扫描" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="32" width="296" height="80" as="geometry" />
        </mxCell>
        <mxCell id="good_1" value="Grid 外循环按 \((t,\text{GQA 组})\) 分派&lt;br&gt;整组 \(G_q\) 个查询头一次进 SRAM&lt;br&gt;\(\mathbf{Q}_g \in \mathbb{R}^{G_q \times d_k}\)（如 \(G_q = 16\)）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="328" y="32" width="296" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bad_2" value="若按单个词元/单头算点积（\(M=1\)）&lt;br&gt;无法填满 Tensor Core 矩阵瓦片&lt;br&gt;零散随机读毁掉 TMA 合并访存" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="144" width="296" height="80" as="geometry" />
        </mxCell>
        <mxCell id="good_2" value="内循环按共享 \(\mathcal{I}_t\) 顺序读连续块&lt;br&gt;载入 \(\mathbf{K}_b [B_k,d_k],\,\mathbf{V}_b [B_k,d_v]\)&lt;br&gt;满载 MMA：\([G_q, d_k] \times [d_k, B_k]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="328" y="144" width="296" height="80" as="geometry" />
        </mxCell>
        <mxCell id="grp_eco" value="上游生产代码生态现状（vllm@bb23c0a8 与 vllm-ascend@3649b8ff）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="256" width="624" height="128" as="geometry" />
        </mxCell>
        <mxCell id="eco_swa" value="已上线：SWA 与可学习 Sink&lt;br&gt;vllm：flash_attn.py（window_size, s_aux）&lt;br&gt;Ascend：attention_v1.py（learnable_sink）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="288" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eco_mla" value="演进：从 GQA-NSA 转向 1 头 MLA 稀疏&lt;br&gt;V3.2 DSA（Indexer）与 V4/V4.1 CSA/SWA&lt;br&gt;全员共享 1 个潜在 KV 头，天然满足 \(M=128\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="328" y="288" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note" value="注：NSA 论文在 A100 Triton 下于 64K 长度实现 9.0× 前向与 6.0× 反向加速；当前上游 vLLM 主干未单独内置 GQA 版 NSA 内核。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="400" width="624" height="32" as="geometry" />
        </mxCell>
        <mxCell id="e_b12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#984646;strokeWidth=1.25;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bad_1" target="bad_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="good_1" target="good_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

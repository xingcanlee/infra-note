        <mxCell id="s_grid" value="1. Grid Outer Loop：驻留全组查询&lt;br&gt;\(Q_g\;[G=16, d_k]\) + 共享索引 \(\mathcal{I}_t\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

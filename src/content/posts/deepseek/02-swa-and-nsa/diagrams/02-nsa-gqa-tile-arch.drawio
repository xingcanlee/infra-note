        <mxCell id="g_sram" value="On-Chip SRAM / UB 硬件对齐 Kernel（Group-Centric）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2f5783;container=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="0" width="328" height="344" as="geometry"/>
        </mxCell>
        <mxCell id="s_grid" value="1. Grid Outer Loop：按时间步 t 与 GQA 组调度&lt;br&gt;一次驻留全组查询 Q_g [G=16, d_k] + 索引 I_t" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="376" y="40" width="296" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s_load" value="2. Inner Loop：顺序 TMA / 异步预取连续块&lt;br&gt;K_tile [B_k=64, d_k], V_tile [B_k=64, d_v]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="376" y="112" width="296" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s_mma" value="3. TensorCore / 达芬奇 Cube 满阵计算&lt;br&gt;[M=16, d_k] @ [d_k, N=64] + Online Softmax&lt;br&gt;（16 个头分摊 1 份 KV 访存，跨过算术强度拐点）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="376" y="184" width="296" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="s_out" value="4. 与 cmp / win 分支汇总 → Sigmoid 门控融合输出&lt;br&gt;o_t* = g_cmp·O_cmp + g_slc·O_slc + g_win·O_win" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

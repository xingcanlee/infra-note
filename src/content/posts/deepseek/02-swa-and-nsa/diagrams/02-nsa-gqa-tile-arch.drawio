        </mxCell>
        <mxCell id="s_mma" value="3. TensorCore / Cube 满阵 MMA&lt;br&gt;\([M=16, d_k]\times[d_k, 64]\) + Online Softmax" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

          <mxGeometry x="152" y="208" width="120" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="gd_mem" value="整组只读 n 块连续 KV（带宽降至 1/4 ~ 1/11.6）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

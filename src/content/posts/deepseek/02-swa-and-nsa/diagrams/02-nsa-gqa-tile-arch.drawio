          <mxGeometry x="0" y="168" width="288" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="gd_sum" value="p_slc&#x27; = Sum_h p_slc^(h)&lt;br&gt;整组 G=16 汇总选块分" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="208" width="120" height="56" as="geometry"/>
        </mxCell>

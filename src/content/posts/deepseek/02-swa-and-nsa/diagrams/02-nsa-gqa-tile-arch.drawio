        </mxCell>
        <mxCell id="s_out" value="4. 与 cmp / win 分支 Sigmoid 门控融合&lt;br&gt;\(o_t^* = g_{\text{cmp}}O_{\text{cmp}} + g_{\text{slc}}O_{\text{slc}} + g_{\text{win}}O_{\text{win}}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="b3_out" value="近邻精细建模 → \(O_{\text{win}}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="344" y="344" width="168" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Sigmoid 门控融合&lt;/b&gt;&lt;br&gt;\(g_t^{\text{cmp}}, g_t^{\text{slc}}, g_t^{\text{win}}\in(0,1)\)&lt;br&gt;&lt;br&gt;\(\mathbf{o}_t^* = \sum_c g_t^c O_c\)&lt;br&gt;&lt;br&gt;等效读 65,536 → 5,632&lt;br&gt;（&lt;b&gt;11.6×&lt;/b&gt; 访存降幅）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

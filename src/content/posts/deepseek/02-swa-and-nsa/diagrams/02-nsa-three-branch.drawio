        </mxCell>
        <mxCell id="b3_grp" value="分支 3 · 独立局部滑窗 win（\(w = 512\)，独立 \(W_K^{\text{win}}, W_V^{\text{win}}\) 隔离局部句法梯度）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#7b5518;container=0;" vertex="1" parent="1">

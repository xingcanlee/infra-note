        <mxCell id="hdr" value="DeepSeek NSA 三分支硬件对齐稀疏架构：64K 上下文 KV 访存降至 1/11.6，A100 相比 FA-2 前向 9.0× 加速" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="688" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="in_qkv" value="&lt;b&gt;当前查询 \(\mathbf{q}_t\)&lt;/b&gt;&lt;br&gt;+ 历史 \(K, V\)&lt;br&gt;（\(64\text{K},\; G=16\)&lt;br&gt;共享 KV 组）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#1d1d1f;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="8" y="136" width="96" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="b1_grp" value="分支 1 · 粗粒度块压缩 cmp（\(l=32\)，步长 \(d=16\) → 50% 重叠折叠，缩 16×）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2f5783;container=0;" vertex="1" parent="1">
          <mxGeometry x="128" y="32" width="400" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="b1_mlp" value="MLP \(\varphi\) 折叠&lt;br&gt;\(\tilde{K}^{\text{cmp}}, \tilde{V}^{\text{cmp}}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#2f5783;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="144" y="64" width="128" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="b1_out" value="压缩打分 \(\mathbf{p}_t^{\text{cmp}}\)&lt;br&gt;→ 产出 \(O_{\text{cmp}}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="344" y="64" width="168" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="b2_grp" value="分支 2 · GQA 组共享连续块精筛 slc（\(l'=64,\; n=16\) 连续块，彻底消除 16×16 并集膨胀）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2c522d;container=0;" vertex="1" parent="1">
          <mxGeometry x="128" y="168" width="400" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="b2_acc" value="空间重叠累加&lt;br&gt;\(\mathbf{p}_t^{\text{slc}}[j] = \sum \mathbf{p}_t^{\text{cmp}}\)&lt;br&gt;（零额外打分权重）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#2c522d;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="144" y="208" width="160" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="b2_top" value="整组 \(G=16\) 求和选块&lt;br&gt;\(\mathcal{I}_t = \operatorname{Top-}n(\bar{\mathbf{p}}_t^{\text{slc}})\) → \(O_{\text{slc}}\)&lt;br&gt;\(M=16\) 填满 Cube/TC" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

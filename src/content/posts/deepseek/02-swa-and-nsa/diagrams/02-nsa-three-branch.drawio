        </mxCell>
        <mxCell id="b3_kv" value="独立滑窗 KV 投影&lt;br&gt;\(K_{t-w:t}^{\text{win}}, V_{t-w:t}^{\text{win}}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#7b5518;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

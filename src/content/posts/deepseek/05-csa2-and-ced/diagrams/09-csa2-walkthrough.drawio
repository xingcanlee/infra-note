        <!-- Cross-layer shared buses (labels cleanly above the arrow lines, never crossed by strokes) -->
        <mxCell id="e-kv-ab" value="共享 KV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;strokeColor=#2f5783;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#2f5783;verticalAlign=bottom;verticalLabelPosition=top;labelBackgroundColor=none;html=1;" edge="1" parent="1" source="kv-full" target="kv-reidx">

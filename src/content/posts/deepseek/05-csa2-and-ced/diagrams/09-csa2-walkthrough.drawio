        </mxCell>
        <mxCell id="kv-reidx" value="复用 Layer A 主 KV&lt;br&gt;复用 Layer A Indexer K" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="248" y="104" width="168" height="48" as="geometry" />
        </mxCell>
        <mxCell id="kv-reuse" value="复用 Layer A 主 KV&lt;br&gt;复用 Layer A Indexer K" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="480" y="104" width="168" height="48" as="geometry" />
        </mxCell>

        <!-- Step 2: Sparse Indexing (y=184..232) -->
        <mxCell id="idx-full" value="全扫 16 槽位，输出&lt;br&gt;Top-2 块与 Top-4" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="184" width="168" height="48" as="geometry" />
        </mxCell>
        <mxCell id="idx-reidx" value="仅重算 Top-2 块（8 槽）&lt;br&gt;产出新 Top-4 索引" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="248" y="184" width="168" height="48" as="geometry" />
        </mxCell>
        <mxCell id="idx-reuse" value="0 次索引打分&lt;br&gt;读 Top-k 缓冲区" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="480" y="184" width="168" height="48" as="geometry" />
        </mxCell>

        <!-- Step 3: Sparse Attention + SWA (y=264..312) -->
        <mxCell id="out-full" value="本层 Q + SWA KV&lt;br&gt;稀疏注意力输出" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="264" width="168" height="48" as="geometry" />

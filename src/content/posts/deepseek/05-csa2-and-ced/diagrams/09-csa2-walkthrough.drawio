        <mxCell id="out-reidx" value="本层 Q + SWA KV&lt;br&gt;稀疏注意力输出" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="248" y="264" width="168" height="48" as="geometry" />

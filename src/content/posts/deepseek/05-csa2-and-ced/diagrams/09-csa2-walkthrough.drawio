  <diagram id="csa2-walkthrough" name="CSA2 三种模式与两级分层稀疏索引示例">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="664" pageHeight="496" math="1" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Column Headers (y=16..56) -->
        <mxCell id="h-full" value="&lt;b&gt;Layer A：Full Mode&lt;/b&gt;&lt;br&gt;is_kv_source = True" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="168" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h-reidx" value="&lt;b&gt;Layer B：Reindex Mode&lt;/b&gt;&lt;br&gt;is_index_source = True" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="248" y="16" width="168" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e-hsi-12" value="8 候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;strokeColor=#7b5518;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#7b5518;verticalAlign=bottom;verticalLabelPosition=top;labelBackgroundColor=none;html=1;" edge="1" parent="1" source="hsi-s1" target="hsi-s2">

        <!-- Bottom Container: 2-Stage Hierarchical Sparse Indexer Trace (y=344..488) -->
        <mxCell id="hsi-box" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;container=0;" vertex="1" parent="1">

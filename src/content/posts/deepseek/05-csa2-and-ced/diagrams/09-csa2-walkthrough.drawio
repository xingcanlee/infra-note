        <mxCell id="hsi-hdr" value="两级分层稀疏索引数值走查（16 个压缩槽位 = 4 个粗块 × 每块 4 槽）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="24" y="352" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hsi-s1" value="&lt;b&gt;Stage 1（Layer A）&lt;/b&gt;&lt;br&gt;全扫 4 块（16 槽位）&lt;br&gt;块最大值 Top-2：块 1、3" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="384" width="152" height="88" as="geometry" />

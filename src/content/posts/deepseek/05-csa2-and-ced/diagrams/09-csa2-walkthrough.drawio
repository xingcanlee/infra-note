          <mxGeometry x="480" y="16" width="168" height="40" as="geometry" />
        </mxCell>

        <!-- Step 1: Global KV + Indexer K (y=104..152, 48px channel above for bus+label) -->
        <mxCell id="kv-full" value="压缩生成主 KV&lt;br&gt;投影生成 Indexer K" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">

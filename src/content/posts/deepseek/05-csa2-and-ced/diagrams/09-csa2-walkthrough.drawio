        <mxCell id="hsi-s2" value="&lt;b&gt;Stage 2（Layer B）&lt;/b&gt;&lt;br&gt;只重打分块 1、块 3（8 槽）&lt;br&gt;精筛本层 Top-4 索引" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="256" y="384" width="160" height="88" as="geometry" />
        </mxCell>
        <mxCell id="hsi-s3" value="&lt;b&gt;Reuse（Layer C）&lt;/b&gt;&lt;br&gt;跳过两级索引计算&lt;br&gt;直接复用 Layer B Top-4" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="488" y="384" width="144" height="88" as="geometry" />

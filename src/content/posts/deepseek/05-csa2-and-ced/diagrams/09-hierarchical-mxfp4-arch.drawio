<mxfile host="app.diagrams.net" modified="2026-11-15T01:55:00.000Z" agent="wisp" version="24.0.0" type="device">
  <diagram id="hierarchical-mxfp4-arch" name="CSA2 三维压缩与 890B MXFP4 账本拆解">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="672" pageHeight="448" math="1" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Top Container: Dimension 1 (Sequence m) x Dimension 2 (Cross-layer Reuse) -->
        <mxCell id="top-box" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="640" height="168" as="geometry" />
        </mxCell>
        <mxCell id="top-hdr" value="维度一（序列压缩 \(m\)）× 维度二（跨层复用）：40 层收敛到 2.5 份全局 KV / token" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="24" y="24" width="600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="topo-swa" value="&lt;b&gt;L0–L1（2 层）&lt;/b&gt;&lt;br&gt;纯 SWA&lt;br&gt;全局 KV：0 份" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="56" width="120" height="112" as="geometry" />
        </mxCell>
        <mxCell id="topo-enc" value="&lt;b&gt;Encoder L2–L19（18 层）&lt;/b&gt;&lt;br&gt;3 组 × 6 层，压缩比 \(m = 2\)&lt;br&gt;每组 1 Full + 5 Reuse&lt;br&gt;全局 KV：\(3 \times \frac{1}{2} = 1.5\) 份" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="56" width="224" height="112" as="geometry" />
        </mxCell>
        <mxCell id="topo-dec" value="&lt;b&gt;Decoder L20–L39（20 层）&lt;/b&gt;&lt;br&gt;5 组 × 4 层，压缩比 \(m = 1\)&lt;br&gt;G1 Full；G2–5 Reindex&lt;br&gt;全局 KV：\(1 \times 1 = 1.0\) 份" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="424" y="56" width="216" height="112" as="geometry" />
        </mxCell>

        <!-- Bottom Left Container: Dimension 3 Bit-width & Byte Layout -->
        <mxCell id="byte-box" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="216" width="392" height="216" as="geometry" />
        </mxCell>
        <mxCell id="byte-hdr" value="维度三（FP4 量化）：单份全局 KV 字节组成（288 + 68 = 356 B）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="24" y="224" width="376" height="24" as="geometry" />
        </mxCell>

        <mxCell id="main-payload" value="&lt;b&gt;主 KV 载荷（512 维）&lt;/b&gt;&lt;br&gt;448 NoPE + 64 RoPE，E2M1&lt;br&gt;\(512 \times 0.5 = 256\text{ B}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="256" width="232" height="72" as="geometry" />
        </mxCell>
        <mxCell id="main-scale" value="&lt;b&gt;E4M3 缩放&lt;/b&gt;&lt;br&gt;每 16 维 1B&lt;br&gt;\(32\text{ B}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="272" y="256" width="120" height="72" as="geometry" />
        </mxCell>

        <mxCell id="idx-payload" value="&lt;b&gt;Indexer K 载荷（128 维）&lt;/b&gt;&lt;br&gt;由主 KV 投影，MXFP4&lt;br&gt;\(128 \times 0.5 = 64\text{ B}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="344" width="232" height="72" as="geometry" />
        </mxCell>
        <mxCell id="idx-scale" value="&lt;b&gt;UE8M0 缩放&lt;/b&gt;&lt;br&gt;每 32 维 1B&lt;br&gt;\(4\text{ B}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=12;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="272" y="344" width="120" height="72" as="geometry" />
        </mxCell>

        <!-- Final Total Ledger Box -->
        <mxCell id="total-box" value="&lt;b&gt;全局 KV 总账本&lt;/b&gt;&lt;br&gt;&lt;br&gt;主 KV：\(2.5 \times 288 = 720\text{ B}\)&lt;br&gt;索引 K：\(2.5 \times 68 = 170\text{ B}\)&lt;br&gt;&lt;br&gt;&lt;b&gt;890 B / token&lt;/b&gt;&lt;br&gt;（约为 V4-Flash 的 1/4）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="472" y="232" width="184" height="184" as="geometry" />
        </mxCell>

        <!-- Arrows into Total Ledger (labels cleanly above arrow lines, exact ports) -->
        <mxCell id="e-main-tot" value="288 B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;strokeColor=#2f5783;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#2f5783;verticalAlign=bottom;verticalLabelPosition=top;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.33;html=1;" edge="1" parent="1" source="main-scale" target="total-box">
          <mxGeometry y="4" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-idx-tot" value="68 B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;strokeColor=#7b5518;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#7b5518;verticalAlign=bottom;verticalLabelPosition=top;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.80;html=1;" edge="1" parent="1" source="idx-scale" target="total-box">
          <mxGeometry y="4" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

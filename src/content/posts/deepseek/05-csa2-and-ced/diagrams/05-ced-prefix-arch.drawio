<mxfile host="wisp-diagram">
  <diagram id="ds-05-ced-prefix" name="05-ced-prefix">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="8" guides="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="g_ced" value="Causal Encoder-Decoder（CED）Prefill 算力减半" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2f5783;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="328" height="376" as="geometry"/>
        </mxCell>
        <mxCell id="enc" value="Causal Encoder（L0..L19，激活 ~8B）&lt;br&gt;处理完整长度 N · L2–19 (m=2) 生成 1.5 份全局 KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="40" width="296" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="hl2" value="编码器顶层隐状态 H_{L/2}（一次性投影源）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="136" width="296" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="proj" value="直接投影 L20..L39 全局 KV：C_l = H_{L/2} W_l^{KV}&lt;br&gt;只需在 L20 写入 1.0 份 m=1 主 KV，免跑上层 MoE" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="208" width="296" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="dec_swa" value="DecoderReplayLayers（L20..L39，末尾 n_win=128）&lt;br&gt;只对最后 128 个 token 跑局部 SWA&lt;br&gt;Prefill 降至 O(NL/2)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="296" width="296" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ce1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="enc" target="hl2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce2" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hl2" target="proj">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce3" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="proj" target="dec_swa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="g_tier" value="智能体多轮分级存储与 SWA 有界重放（§3.2）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2c522d;container=0;" vertex="1" parent="1">
          <mxGeometry x="352" y="0" width="336" height="376" as="geometry"/>
        </mxCell>
        <mxCell id="ssd" value="SSD 持久化前缀池（TTL &amp;gt;= 72 小时）&lt;br&gt;只存全局 KV（890 B/tok），体积仅为 V4 的 1/8&lt;br&gt;剔除短寿命 SWA KV，命中后直接恢复长前缀全局 KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="368" y="40" width="304" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="dram" value="Host DRAM 热缓冲池（10% RAM · 分钟级 TTL）&lt;br&gt;只缓存 Prompt 尾与输出尾两处 SWA 快照&lt;br&gt;活跃多轮直接命中，过期即刻回收给新会话" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="368" y="144" width="304" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="miss" value="全局命中但 SWA 过期时的兜底策略&lt;br&gt;Encoder SWA Bounded Replay：&lt;br&gt;仅回放命中点前最后 n_win=128 个 token 恢复 SWA&lt;br&gt;（无需全网重跑 L×n_win=5120 步）&lt;br&gt;随后仅对新增短后缀生成全局 KV + SWA KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="368" y="248" width="304" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="te1" value="全局命中" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="ssd" target="dram">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="te2" value="SWA 过期" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="dram" target="miss">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

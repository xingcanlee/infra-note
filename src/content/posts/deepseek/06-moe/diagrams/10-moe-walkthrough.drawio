<mxfile host="wisp-diagram">
  <diagram id="moe-walkthrough" name="MoE Walkthrough: 4 Tokens to 8 Routed + 1 Shared Expert">
    <mxGraphModel dx="672" dy="688" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="672" pageHeight="688" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="input_tokens" value="输入 4 个词元 \(X = [t_0, t_1, t_2, t_3]\)&lt;br&gt;路由打分 \(s = \mathrm{Sigmoid}(W_g X)\) · \(N_{\text{routed}}=8\)&lt;br&gt;（节点 0：E0..E3，节点 1：E4..E7）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="416" height="72" as="geometry" />
        </mxCell>

        <mxCell id="shared_expert" value="共享专家 \(E_s\)&lt;br&gt;（\(N_{\text{shared}}=1\)）&lt;br&gt;4 词元常驻并行" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="496" y="16" width="160" height="72" as="geometry" />
        </mxCell>

        <mxCell id="grp_step1" value="① 无辅助损失负载均衡：选路与加权解耦（以词元 t2 为例）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="16" y="120" width="416" height="144" as="geometry" />
        </mxCell>

        <mxCell id="bias_select" value="选路判定（加偏置 \(b_i\)）&lt;br&gt;E1: \(0.60 - 0.25 = 0.35\)&lt;br&gt;E6: \(0.58 + 0.15 = 0.73\)&lt;br&gt;改选 Top-2：(E0, E6)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceee4;strokeColor=#762f06;strokeWidth=1;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="152" width="184" height="96" as="geometry" />
        </mxCell>

        <mxCell id="unbiased_weight" value="门控加权（读原始 \(s_{i,t}\)）&lt;br&gt;\(g_0 = 0.62 / 1.20 = 0.517\)&lt;br&gt;\(g_6 = 0.58 / 1.20 = 0.483\)&lt;br&gt;梯度不受 \(b_i\) 扰动" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="232" y="152" width="184" height="96" as="geometry" />
        </mxCell>

        <mxCell id="align_blocks" value="② moe_align_block_size(block_size=4) 块对齐&lt;br&gt;原始 8 槽：E0×2 · E4×3 · E6×3（其余 5 个专家为 0）&lt;br&gt;Block 0 (E0)：[t0, t2, pad, pad]（2 实 + 2 填充）&lt;br&gt;Block 1 (E4)：[t0, t1, t3, pad]（3 实 + 1 填充）&lt;br&gt;Block 2 (E6)：[t1, t2, t3, pad]（3 实 + 1 填充）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="312" width="416" height="128" as="geometry" />
        </mxCell>

        <mxCell id="grouped_gemm" value="③ Grouped GEMM 并行计算 3 个 4×H 定长块（SwiGLU）&lt;br&gt;跳过 pad 槽位，按原词元位置 Gather 乘以权重 \(g_{i,t}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="472" width="416" height="64" as="geometry" />
        </mxCell>

        <mxCell id="final_output" value="④ 残差输出融合：\(h'_t = x_t + E_s(x_t) + \sum_{i \in \mathrm{Top2}} g_{i,t} E_i(x_t)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="576" width="640" height="56" as="geometry" />
        </mxCell>

        <mxCell id="note" value="注：4 词元共产生 K·T = 8 个路由槽位，经 block_size=4 补齐为 12 槽以适配 Tensor Core；pad 槽不写回最终输出。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="16" y="648" width="640" height="24" as="geometry" />
        </mxCell>

        <mxCell id="e_in_step1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" edge="1" parent="1" source="input_tokens" target="grp_step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_step1_align" value="4 词元共 8 个稀疏路由索引" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" edge="1" parent="1" source="grp_step1" target="align_blocks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_align_gemm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" edge="1" parent="1" source="align_blocks" target="grouped_gemm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gemm_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" edge="1" parent="1" source="grouped_gemm" target="final_output">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="224" y="556" />
              <mxPoint x="224" y="556" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_shared_out" value="常驻旁路直连融合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#5c6067;strokeWidth=1.25;dashed=1;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" edge="1" parent="1" source="shared_expert" target="final_output">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="576" y="556" />
              <mxPoint x="576" y="556" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

          <mxGeometry x="424" y="432" width="128" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="kr" value="k_s^R&lt;br&gt;位置分支（64）&lt;br&gt;apply RoPE R_s&lt;br&gt;所有 head 共享一份" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="624" y="520" width="288" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="wuv" value="W^UK_h / W^UV_h = wkv_b&lt;br&gt;每个 head 一份&lt;br&gt;与位置无关" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="1000" y="400" width="248" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="absorb" value="与 t、s 无关 → 可被吸收进 Query" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="1000" y="504" width="320" height="48" as="geometry"/>

        <mxCell id="plus" value="+" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="624" y="728" width="64" height="64" as="geometry"/>

        <mxCell id="wqa" value="wq_a： \(W_a^{DQ}\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="48" y="96" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="qnorm" value="q_norm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="48" y="160" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="wqb" value="wq_b： \(W^{UQ}\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="48" y="224" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="qc" value="内容 query \(\mathbf q_t^{C,h}\)&lt;br&gt;\(d_{\mathrm{nope}}=128\)&lt;br&gt;不做 RoPE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="304" width="136" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="qr" value="位置 query \(\mathbf q_t^{R,h}\)&lt;br&gt;\(d_r=64\)&lt;br&gt;施加 \(\mathrm{RoPE}(R_t)\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="160" y="304" width="136" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="xs" value="hidden state \(\mathbf x_s\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="392" y="32" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="wkva" value="wkv_a： \(W^{DKV}\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="392" y="96" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="kvnorm" value="kv_norm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="392" y="160" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ckv" value="内容 latent \(\mathbf c_s^{KV}\)&lt;br&gt;\(d_c=512\)&lt;br&gt;不做 RoPE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="352" y="304" width="136" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="kr" value="位置 key \(\mathbf k_s^R\)&lt;br&gt;\(d_r=64\)，共享&lt;br&gt;施加 \(\mathrm{RoPE}(R_s)\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="496" y="304" width="136" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="score" value="\(\displaystyle e_{t,s}^{h}=(\mathbf q_t^{C,h})^{\top}\mathbf W_h^{UK}\mathbf c_s+(\mathbf q_t^{R,h})^{\top}\mathbf k_s^R\)&lt;br&gt;内容项 + RoPE 位置项" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="448" width="640" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="param_note" value="共享投影 \(W_h^{UK}\)、\(W_h^{UV}\) 与 \(t,s\) 无关，可以预先吸收进 Query / Value" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="168" y="552" width="472" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="softmax" value="softmax" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="592" width="120" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="aggregate" value="按权重聚合 latent&lt;br&gt;\(z_t^h=\sum_s \alpha_{t,s}^h\mathbf c_s\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="168" y="592" width="232" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="out" value="输出&lt;br&gt;\(\mathbf o_t^h=\mathbf W_h^{UV}\mathbf z_t^h\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="448" y="592" width="192" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="只有位置分支承担 RoPE；内容分支走共享 latent，上投影矩阵与位置无关，因此可以被吸收。缓存里每个历史 token 只存 \(\mathbf c_s^{KV}\) 与 \(\mathbf k_s^R\)，位置 key 在所有 head 间共享。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="664" width="640" height="40" as="geometry"/>

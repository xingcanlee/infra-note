        <mxCell id="qnorm" value="q_norm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="368" y="120" width="112" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="wqb" value="wq_b" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="512" y="120" width="120" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="qc" value="q_t^C&lt;br&gt;内容分支&lt;br&gt;qk_nope_head_dim = 128&lt;br&gt;不做 RoPE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="688" y="80" width="224" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="qr" value="q_t^R&lt;br&gt;位置分支&lt;br&gt;qk_rope_head_dim = 64&lt;br&gt;apply RoPE R_t" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="688" y="224" width="224" height="96" as="geometry"/>
        </mxCell>

        <mxCell id="wkv_a" value="W^DKV = wkv_a" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="432" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ckv" value="c_s^KV&lt;br&gt;共享 latent&lt;br&gt;kv_lora_rank = 512" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">

<mxfile host="wisp-diagram">
  <diagram id="decoupled-rope" name="MLA：解耦 RoPE 与矩阵吸收">
    <mxGraphModel dx="1600" dy="1040" grid="1" gridSize="8" guides="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="MLA：解耦 RoPE 与矩阵吸收" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="16" width="960" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="cache" value="缓存的全部内容：d_c + d_r = 512 + 64 = 576 个数 / token / 层" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;fillOpacity=25;strokeColor=#15803d;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontFamily=Inter;fontSize=12;fontColor=#15803d;container=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="360" width="360" height="296" as="geometry"/>
        </mxCell>


<mxfile host="wisp-diagram">
  <diagram id="decoupled-rope" name="MLA：解耦 RoPE 与矩阵吸收">
    <mxGraphModel dx="800" dy="900" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="query_label" value="Query 侧（当前 token \(t\)）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="296" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="kv_label" value="Key / Value 侧（历史 token \(s\)）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="344" y="0" width="296" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="cache" value="latent KV cache" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.5;dashed=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="344" y="264" width="296" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="xt" value="hidden state \(\mathbf x_t\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">

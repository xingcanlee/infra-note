<mxfile host="wisp-diagram">
  <diagram id="decoupled-rope" name="MLA：解耦 RoPE 与矩阵吸收">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="MLA：解耦 RoPE 与矩阵吸收" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="32" y="16" width="960" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="query_label" value="Query 侧：拆成内容与位置两条分支" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="32" y="56" width="360" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="kv_label" value="Key / Value 侧" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="32" y="344" width="200" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="cache_label" value="MLA latent KV cache&lt;br&gt;每个历史 token 缓存 \(c_s^{KV}\) 与 \(k_s^R\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="560" y="328" width="400" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="xt" value="hidden state&lt;br&gt;\(\mathbf x_t\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="80" width="144" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="wqa" value="wq_a&lt;br&gt;\(W_a^{DQ}\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="208" y="80" width="128" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="qnorm" value="q_norm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="368" y="80" width="112" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="wqb" value="wq_b&lt;br&gt;\(W^{UQ}\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="512" y="80" width="128" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="qc" value="内容 query&lt;br&gt;\(\mathbf q_t^{C,h}\)，\(d_{\mathrm{nope}}=128\)&lt;br&gt;不做 RoPE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="688" y="64" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="qr" value="位置 query&lt;br&gt;\(\mathbf q_t^{R,h}\)，\(d_r=64\)&lt;br&gt;施加 \(\mathrm{RoPE}(R_t)\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="688" y="176" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="xs" value="hidden state&lt;br&gt;\(\mathbf x_s\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="400" width="144" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="wkva" value="wkv_a&lt;br&gt;\(W^{DKV}\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="208" y="400" width="160" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="kvnorm" value="kv_norm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="400" y="400" width="112" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ckv" value="共享内容 latent&lt;br&gt;\(\mathbf c_s^{KV}\)，\(d_c=512\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="560" y="384" width="336" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="kr" value="共享位置 key&lt;br&gt;\(\mathbf k_s^R\)，\(d_r=64\)&lt;br&gt;所有 head 共享，施加 \(\mathrm{RoPE}(R_s)\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="560" y="496" width="336" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="score" value="$$e_{t,s}^{h}=(\mathbf q_t^{C,h})^{\top}\mathbf W_h^{UK}\mathbf c_s+(\mathbf q_t^{R,h})^{\top}\mathbf k_s^R$$&lt;br&gt;内容项 + RoPE 位置项" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="248" width="400" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="softmax" value="softmax" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="1504" y="296" width="128" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="aggregate" value="按权重聚合 latent&lt;br&gt;\(z_t^h=\sum_s \alpha_{t,s}^h\mathbf c_s\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="1680" y="296" width="208" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="out" value="输出&lt;br&gt;\(\mathbf o_t^h=\mathbf W_h^{UV}\mathbf z_t^h\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="1936" y="296" width="176" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="param_note" value="共享投影 \(W_h^{UK}\) / \(W_h^{UV}\)&lt;br&gt;与 \(t,s\) 无关，可预吸收进 Query / Value" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="1056" y="456" width="448" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="只有位置分支承担 RoPE；内容分支走共享 latent，因此上投影矩阵与位置无关，可以被吸收。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="32" y="632" width="1600" height="32" as="geometry"/>
        </mxCell>


<mxfile host="app.diagrams.net">
  <diagram id="mhc-arch" name="Birkhoff 流形约束与 mHC 架构">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="688" pageHeight="448" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pnl_cmp" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="8" y="8" width="248" height="192" as="geometry" />
        </mxCell>
        <mxCell id="hdr_cmp" value="① 残差演进：单流 → HC" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="232" height="24" as="geometry" />
        </mxCell>
        <mxCell id="box_std" value="标准残差（\(n=1\)，带宽 \(C\)）&lt;br&gt;\(\mathbf{x}_{l+1} = \mathbf{x}_l + \mathcal{F}(\mathbf{x}_l)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="16" y="48" width="232" height="48" as="geometry" />
        </mxCell>
        <mxCell id="box_hc" value="无约束 HC（\(n=4\)，带宽 \(4C\)）&lt;br&gt;\(\mathbf{x}_{l+1} = \mathcal{H}_l^{\mathrm{res}}\mathbf{x}_l + (\mathcal{H}_l^{\mathrm{post}})^\top\mathcal{F}(\mathcal{H}_l^{\mathrm{pre}}\mathbf{x}_l)\)&lt;br&gt;自由混合矩阵 → 深层连乘崩溃" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="16" y="104" width="232" height="88" as="geometry" />
        </mxCell>

        <mxCell id="pnl_birk" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="8" y="208" width="248" height="232" as="geometry" />
        </mxCell>
        <mxCell id="hdr_birk" value="③ Birkhoff 流形三大保证" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontStyle=1;fontColor=#2c522d;" vertex="1" parent="1">
          <mxGeometry x="16" y="216" width="232" height="24" as="geometry" />
        </mxCell>
        <mxCell id="birk_1" value="双随机多面体（置换矩阵凸包）&lt;br&gt;\(\mathcal{H}_l^{\mathrm{res}}\mathbf{1}_n=\mathbf{1}_n,\;\mathbf{1}_n^\top\mathcal{H}_l^{\mathrm{res}}=\mathbf{1}_n^\top\)（\(\ge 0\)）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="16" y="248" width="232" height="64" as="geometry" />
        </mxCell>
        <mxCell id="birk_2" value="乘法封闭且非扩张&lt;br&gt;\(\prod \mathcal{H}_i^{\mathrm{res}}\) 仍双随机，\(\|\mathcal{H}_l^{\mathrm{res}}\|_2 \le 1\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="16" y="320" width="232" height="48" as="geometry" />
        </mxCell>
        <mxCell id="birk_3" value="非负聚合与写回：防正负抵消&lt;br&gt;\(\mathcal{H}^{\mathrm{pre}}=\sigma(\cdot),\;\mathcal{H}^{\mathrm{post}}=2\sigma(\cdot)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="16" y="376" width="232" height="56" as="geometry" />
        </mxCell>

        <mxCell id="pnl_mhc" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="272" y="8" width="408" height="432" as="geometry" />
        </mxCell>
        <mxCell id="hdr_mhc" value="② 原始 mHC 单层计算图（arXiv:2512.24880）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontStyle=1;fontColor=#2f5783;" vertex="1" parent="1">
          <mxGeometry x="288" y="16" width="376" height="24" as="geometry" />
        </mxCell>

        <mxCell id="mhc_in" value="多分支状态 \(\mathbf{x}_l \in \mathbb{R}^{n \times C}\)（默认 \(n = 4\)）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;fontStyle=1;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="360" y="48" width="232" height="40" as="geometry" />
        </mxCell>

        <mxCell id="mhc_pred" value="系数预测与流形投影&lt;br&gt;\(\mathrm{RMSNorm}(\mathrm{vec}(\mathbf{x}_l)) \to \tilde{\mathcal{H}}\)&lt;br&gt;\(\mathcal{H}^{\mathrm{res}} = \mathrm{SK}_{20}(\exp(\tilde{\mathcal{H}}^{\mathrm{res}}))\)&lt;br&gt;\(\mathcal{H}^{\mathrm{pre}}=\sigma(\cdot),\;\mathcal{H}^{\mathrm{post}}=2\sigma(\cdot)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="288" y="112" width="184" height="88" as="geometry" />
        </mxCell>

        <mxCell id="lbl_hres" value="\(\mathcal{H}_l^{\mathrm{res}}\)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#2c522d;" vertex="1" parent="1">
          <mxGeometry x="384" y="216" width="40" height="24" as="geometry" />
        </mxCell>

        <mxCell id="mhc_pre" value="Pre 聚合（\(4 \to 1\) 流）&lt;br&gt;\(\hat{x}_l = \mathcal{H}_l^{\mathrm{pre}}\mathbf{x}_l \in \mathbb{R}^C\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="496" y="112" width="168" height="48" as="geometry" />
        </mxCell>

        <mxCell id="mhc_fn" value="主干层算子 \(\mathcal{F}_l(\hat{x}_l)\)&lt;br&gt;（MLA 注意力 或 MoE）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="496" y="184" width="168" height="48" as="geometry" />
        </mxCell>

        <mxCell id="mhc_post" value="Post 写回（\(1 \to 4\) 流）&lt;br&gt;\((\mathcal{H}_l^{\mathrm{post}})^\top \mathcal{F}_l(\hat{x}_l)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="496" y="256" width="168" height="48" as="geometry" />
        </mxCell>

        <mxCell id="mhc_res" value="双随机残差混合&lt;br&gt;\(\mathcal{H}_l^{\mathrm{res}}\mathbf{x}_l \in \mathbb{R}^{4 \times C}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="288" y="256" width="184" height="48" as="geometry" />
        </mxCell>

        <mxCell id="mhc_add" value="残差合流输出 \(\mathbf{x}_{l+1} = \mathcal{H}_l^{\mathrm{res}}\mathbf{x}_l + (\mathcal{H}_l^{\mathrm{post}})^\top\mathcal{F}_l(\hat{x}_l)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;fontColor=#2c522d;fontFamily=Inter;fontSize=12;fontStyle=1;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="304" y="352" width="344" height="48" as="geometry" />
        </mxCell>

        <mxCell id="e_in_pred" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f5783;strokeWidth=1.25;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_in" target="mhc_pred">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_in_pre" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#464e57;strokeWidth=1.25;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_in" target="mhc_pre">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_in_res" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2c522d;strokeWidth=1.25;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_in" target="mhc_res">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="68" />
              <mxPoint x="280" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_pred_res" style="rounded=1;html=1;strokeColor=#2c522d;strokeWidth=1.25;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_pred" target="mhc_res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pred_pre" style="rounded=1;html=1;strokeColor=#2f5783;strokeWidth=1.25;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_pred" target="mhc_pre">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pred_post" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f5783;strokeWidth=1.25;endArrow=block;endFill=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_pred" target="mhc_post">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="440" y="216" />
              <mxPoint x="480" y="216" />
              <mxPoint x="480" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_pre_fn" style="rounded=1;html=1;strokeColor=#464e57;strokeWidth=1.25;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_pre" target="mhc_fn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fn_post" style="rounded=1;html=1;strokeColor=#464e57;strokeWidth=1.25;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_fn" target="mhc_post">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_res_add" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2c522d;strokeWidth=1.25;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_res" target="mhc_add">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_post_add" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f5783;strokeWidth=1.25;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mhc_post" target="mhc_add">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

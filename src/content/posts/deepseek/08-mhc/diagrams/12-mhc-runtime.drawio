<mxfile host="app.diagrams.net">
  <diagram id="mhc-runtime" name="V4.1 Single-Pass Mega-mHC 与生产融合">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="688" pageHeight="456" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pnl_multi" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="8" y="8" width="672" height="96" as="geometry" />
        </mxCell>
        <mxCell id="hdr_multi" value="原始 Multi-Pass mHC（eq. 2–5）：层内数据依赖迫使反复读写 HBM" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#7b5518;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mp_1" value="Kernel 1：读 \(X_l\)&lt;br&gt;全局归约算 \((A_l,B_l,C_l)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="16" y="48" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="mp_2" value="Kernel 2：再读 \(X_l\)&lt;br&gt;算 \(A_l X_l + \mathrm{Norm}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="192" y="48" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="mp_3" value="Kernel 3：三读 \(X_l\)&lt;br&gt;\(B_l X_l + C_l \mathcal{F}_l(\cdot)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="368" y="48" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="mp_io" value="激活访存总量&lt;br&gt;\((4n+4)d = 20d\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;fontColor=#7b5518;fontFamily=Inter;fontSize=12;fontStyle=1;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="544" y="48" width="128" height="48" as="geometry" />
        </mxCell>

        <mxCell id="pnl_sp" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="8" y="112" width="672" height="112" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sp" value="V4.1 Single-Pass mHC（eq. 6）：用上层 \(A_{l-1}\) 解除依赖，Mega-mHC 单遍读写" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="16" y="120" width="560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sp_in" value="边界输入 \((X_{l-1}, Y_{l-1})\)&lt;br&gt;\((A_{l-1},B_{l-1},C_{l-1})\) 已就绪" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="16" y="152" width="160" height="64" as="geometry" />
        </mxCell>
        <mxCell id="sp_mega" value="Mega-mHC 单核分块融合（寄存器一次过）：&lt;br&gt;① \(X_l = B_{l-1}X_{l-1}+C_{l-1}Y_{l-1}\)&lt;br&gt;② \(A_{l-1}X_l+\mathrm{Norm+FP8}\) · ③ 累加 \(\mathcal{H}(X_l)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="192" y="152" width="336" height="64" as="geometry" />
        </mxCell>
        <mxCell id="sp_io" value="单读单写最优下界&lt;br&gt;\((2n+2)d = 10d\)（2×）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;fontColor=#0f766e;fontFamily=Inter;fontSize=12;fontStyle=1;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="544" y="152" width="128" height="64" as="geometry" />
        </mxCell>


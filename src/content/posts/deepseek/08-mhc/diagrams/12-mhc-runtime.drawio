        <mxCell id="std_fused" value="&lt;b&gt;跨层融合核 mhc_shifted_post_pre&lt;/b&gt;&lt;br&gt;TP Lamport AllReduce + prev_post + next_pre&lt;br&gt;SM100 走 DeepGEMM / CuTe 16-CTA DSMEM" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;fontColor=#1d1d1f;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">

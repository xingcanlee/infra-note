        <mxCell id="hc_l20" value="第 20 层 \((H_2 H_1)^{10}\mathbf{x}_0\)：&lt;br&gt;\([3146.7,\; 2702.6,\; 2800.1,\; 2657.0]^\top\)&lt;br&gt;&lt;b&gt;复合 Amax：前向 \(3121.9\times\) · 反向 \(3184.0\times\)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;fontColor=#984646;fontFamily=Inter;fontSize=12;strokeWidth=1.25;" vertex="1" parent="1">

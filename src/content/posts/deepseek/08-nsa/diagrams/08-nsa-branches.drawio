<mxfile host="wisp-diagram">
  <diagram id="nsa-branches" name="NSA：压缩、选块、窗口三分支与门控融合">
    <mxGraphModel dx="800" dy="900" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="qnote" value="三条分支共享同一个 query \(\mathbf q_t\)，K/V 投影各自独立" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="640" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="hist" value="历史 K/V 序列" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="40" width="192" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="branch_cmp" value="压缩分支" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#2c522d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="104" width="192" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="branch_slc" value="选块分支" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#7b5518;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="224" y="104" width="192" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="branch_win" value="窗口分支" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#7b5518;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="448" y="104" width="192" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="kvp_cmp" value="K/V 投影 \(W^{cmp}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="144" width="192" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="blockify" value="每 \(l=32\) 个 K/V&lt;br&gt;聚合成一个块" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="216" width="192" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="phi" value="\(\varphi\)：可学习 MLP&lt;br&gt;带块内位置编码" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5eef9;strokeColor=#4d335c;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="288" width="192" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="comp" value="压缩 K/V&lt;br&gt;\(d=16\)，相邻块重叠" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="360" width="192" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="kvp_slc" value="K/V 投影 \(W^{slc}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="360" width="192" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="score" value="块分数 \(\mathbf p_t^{cmp}=\)&lt;br&gt;\(\mathrm{Softmax}(\mathbf q_t^{\top}\tilde K_t^{cmp})\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="432" width="192" height="56" as="geometry"/>
        </mxCell>

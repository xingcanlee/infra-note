        </mxCell>
        <mxCell id="qnote" value="三条分支共享同一个 query &#160;\(\mathbf q_t\)&#160;；但各自使用独立的 K/V 投影" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">

          <mxGeometry x="448" y="680" width="192" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="门控融合 \(\mathbf o_t^*=\sum_c g_t^c\,\mathbf o_t^c\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5eef9;strokeColor=#4d335c;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">

<mxfile host="wisp-diagram"><diagram id="p" name="NSA：压缩、选块、窗口三分支与门控融合"><mxGraphModel dx="1900" dy="1000" grid="1" gridSize="8" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="NSA：压缩、选块、窗口三分支与门控融合" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="16" width="1280" height="32" as="geometry"/></mxCell><mxCell id="q" value="当前 Query q_t" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="32" y="112" width="160" height="64" as="geometry"/></mxCell><mxCell id="hist" value="历史 K/V 序列" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="32" y="736" width="160" height="64" as="geometry"/></mxCell><mxCell id="cp" value="K/V 投影" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="256" y="96" width="160" height="64" as="geometry"/></mxCell><mxCell id="ca" value="每 l=32 个 key&lt;br&gt;聚合成 1 个压缩 key" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="464" y="96" width="192" height="64" as="geometry"/></mxCell><mxCell id="phi" value="φ：可学习 MLP&lt;br&gt;带块内位置编码" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="704" y="96" width="192" height="64" as="geometry"/></mxCell><mxCell id="ckv" value="压缩 K/V&lt;br&gt;stride d=16，相邻块重叠" st
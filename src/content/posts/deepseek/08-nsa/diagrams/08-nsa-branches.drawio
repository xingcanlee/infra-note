        <mxCell id="gate" value="门控融合&lt;br&gt;\(\mathbf o_t^*=\sum_c g_t^c\,\mathbf o_t^c\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">

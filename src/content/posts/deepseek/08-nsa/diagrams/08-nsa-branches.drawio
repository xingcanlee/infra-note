          <mxGeometry x="224" y="512" width="192" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="topn" value="Top-\(n\) 选块，\(n=16\)&lt;br&gt;固定起始 / 局部块&lt;br&gt;读原始 K/V，\(l^{\prime}=64\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">

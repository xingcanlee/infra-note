        <mxCell id="title" value="NSA：压缩、选块、窗口三分支与门控融合" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">

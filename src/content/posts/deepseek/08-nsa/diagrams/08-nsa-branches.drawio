        </mxCell>
        <mxCell id="out" value="输出 \(\mathbf o_t^*\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="240" y="840" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="虚线：选块分数直接复用压缩分支的 softmax，边际成本为 0。三条分支使用各自独立的 K/V 投影，避免局部捷径与梯度干扰（§3.3.3）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">

<mxfile host="wisp-diagram">
  <diagram id="prefetch-overlap" name="跨层预取与多流重叠">
    <mxGraphModel dx="640" dy="520" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tok_top" value="本步输入 token IDs（第 0 层启动前即可确定所有 Engram 层的查表行号）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="48" y="0" width="528" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1_hdr" value="主计算流（HBM / Tensor Core）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#2f5783;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="56" width="232" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s2_hdr" value="预取流（GPU / NPU 异步流）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#2c522d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="328" y="56" width="296" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c_l0" value="第 0 层：MLA 注意力 + Dense FFN" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="96" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c_prev" value="第 \(1 \dots \ell-1\) 层前向计算&lt;br&gt;（充当主机内存预取的掩蔽窗口）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="176" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_wait" value="主流等待完成事件&lt;br&gt;GPU: wait_stream | NPU: ExternalEvent" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="328" width="280" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c_ll" value="第 \(\ell\) 层：Engram 门控投影 + Attention + MoE&lt;br&gt;直接消费已就绪的查表缓冲" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="400" width="496" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p_hash" value="整批确定性哈希 + DP 索引交换&lt;br&gt;每个 step 仅执行 1 次" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="328" y="96" width="296" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p_uva" value="主机内存表异步聚行 / PCIe 传输&lt;br&gt;Pinned / CANN 注册大页 → 设备缓冲" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="328" y="176" width="296" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p_ev" value="记录预取完成事件&lt;br&gt;GPU: cuda.Event | NPU: ExternalEvent" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="328" y="272" width="296" height="48" as="geometry" />
        </mxCell>
        <mxCell id="e_t_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2f5783;strokeWidth=1.25;exitX=0.2878787878787879;exitY=1.0;exitDx=0;exitDy=0;entryX=0.7142857142857143;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="tok_top" target="c_l0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_t_p" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=0.6666666666666666;exitY=1.0;exitDx=0;exitDy=0;entryX=0.24324324324324326;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="tok_top" target="p_hash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2f5783;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="c_l0" target="c_prev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2f5783;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="c_prev" target="c_wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2f5783;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.28225806451612906;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="c_wait" target="c_ll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="p_hash" target="p_uva">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="p_uva" target="p_ev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ev_wait" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;dashed=1;" edge="1" parent="1" source="p_ev" target="c_wait">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="304" y="296" />
              <mxPoint x="304" y="352" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_buf_ll" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.35135135135135137;exitY=1.0;exitDx=0;exitDy=0;entryX=0.8709677419354839;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="p_ev" target="c_ll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="vllm-decode" name="单步查表与分布式交换">
    <mxGraphModel dx="640" dy="520" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_in" value="本步输入 input_ids \([T]\) + 三级历史回溯补齐前 2 个上下文 token&lt;br&gt;（GPU 请求表 → KV Block 哈希逆查 → 模型 Runner 侧表）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="0" width="560" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d_hash" value="整批一次性计算两层哈希索引 \([2,\,T,\,16]\)&lt;br&gt;压缩词表映射 + 奇乘数异或 + 16 质数取模" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="464" height="48" as="geometry" />
        </mxCell>
        <mxCell id="d_peer" value="同机小批量快路径（\(\mathrm{slot} \le 128\)）&lt;br&gt;对称共享内存（Symmetric Memory）&lt;br&gt;Peer 跨卡直读，零集合通信开销" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="160" width="296" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d_a2a" value="大批量或跨节点路径&lt;br&gt;all_to_all_single 散射哈希行号&lt;br&gt;查表后再反向归集行向量" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="328" y="160" width="296" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d_gather" value="头分片嵌入表聚行与反量化（\([\mathrm{TP} \times \mathrm{DP}]\) 切分 16 个头）&lt;br&gt;GPU：Pinned 主机大页 UVA 直读 ｜ NPU：CANN HostRegister + \(2^{22}\) 行分块指针表" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="256" width="592" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d_wkv" value="本地 TP 切分 wkv 投影（MXFP8 权重量化）+ TP AllReduce&lt;br&gt;一次产出共享 Value \([T,\,d]\) 与四分支 Key \([T,\,4,\,d]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="48" y="344" width="528" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d_gate" value="四分支融合门控核（RMSNorm 点积 → 有符号开方 → Sigmoid）&lt;br&gt;原位更新 \(\mathbf{H} \in \mathbb{R}^{T \times 4 \times d}\) 后交回 mhc_pre" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="432" width="528" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e_d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="d_in" target="d_hash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_l" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=0.14655172413793102;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="d_hash" target="d_peer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_r" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=0.853448275862069;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="d_hash" target="d_a2a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d3_l" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.22297297297297297;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="d_peer" target="d_gather">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d3_r" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.777027027027027;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="d_a2a" target="d_gather">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="d_gather" target="d_wkv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.25;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=12;fontColor=#5c6067;labelBackgroundColor=#fcfcfb;" edge="1" parent="1" source="d_wkv" target="d_gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

        </mxCell>
        <mxCell id="b_tok" value="① 词表归一映射规范 ID（\(t = 5\) 落在「首」）&lt;br&gt;[公司(614), 新任(729), 的(12), 首(88)]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

        <mxCell id="hdr_b" value="语境 B：「公司 新任 的 首」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#984646;fontStyle=1;" vertex="1" parent="1">

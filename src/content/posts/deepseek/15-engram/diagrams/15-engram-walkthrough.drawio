        <mxCell id="b_ctx" value="第 1 层 \(\mathbf{h}_B\)&lt;br&gt;语境：公司·新任" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="512" y="184" width="112" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_gate" value="④ 门控点积同向：\(\alpha_A = 0.90\)（开门放行）&lt;br&gt;\(\mathbf{u}_A = 0.90\,\mathbf{v}_A\)，保留「首都」记忆" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="264" width="296" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b_gate" value="④ 门控点积冲突：\(\alpha_B = 0.09\)（关门掐断）&lt;br&gt;\(\mathbf{u}_B \approx \mathbf{0}\)，屏蔽「首都」干扰" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="328" y="264" width="296" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_out" value="⑤ 短卷积 + 残差写回 \(\mathbf{h}_A + \mathbf{y}_A\)&lt;br&gt;浅层直接补全实体 → 下文预测「都」" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="344" width="296" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b_out" value="⑤ 短卷积 + 残差写回 \(\mathbf{h}_B + \mathbf{y}_B\)&lt;br&gt;主干语义免受污染 → 下文推理「席执行官」" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="328" y="344" width="296" height="56" as="geometry" />
        </mxCell>
        <mxCell id="wt_note" value="两句话在「首」处的 2-gram 哈希行号完全相同（FLOPs \(= 0\)），全靠主干上下文门控 \(\alpha_t\) 在第 ④ 步分道扬镳。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">

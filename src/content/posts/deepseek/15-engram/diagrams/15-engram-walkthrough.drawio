        <mxCell id="a_ctx" value="第 1 层 \(\mathbf{h}_A\)&lt;br&gt;语境：北京·中国" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="184" width="112" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_mem" value="③ 查 16 行 → \(\mathbf{k}_A,\,\mathbf{v}_A\)&lt;br&gt;记忆强偏向「首都」" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="120" y="184" width="176" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b_mem" value="③ 查 16 行 → \(\mathbf{k}_B,\,\mathbf{v}_B\)&lt;br&gt;共用 8 头仍带入「首都」" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

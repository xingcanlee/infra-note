        <mxCell id="hdr_a" value="语境 A：「北京 是 中国 的 首」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#2c522d;fontStyle=1;" vertex="1" parent="1">

<mxfile host="wisp-diagram">
  <diagram id="engram-decode" name="decode 数据流">
    <mxGraphModel dx="800" dy="1000" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="runner" value="runner 输入&lt;br&gt;input_ids [T] · positions · lookback" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="0" width="288" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="hash" value="哈希 _hash_ids_kernel&lt;br&gt;二分定位请求与 chunk 起点&lt;br&gt;shape [T] → [T, 2 层, 16 列]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="112" width="288" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="hashes" value="engram_hashes [T, 2 层, 16 列]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="224" width="288" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="dp" value="DP 交换（EngramBatch）&lt;br&gt;slot&lt;128：peer SHM 互读&lt;br&gt;否则 all_to_all 打包 FP8&lt;br&gt;行 [T·DP, 16, 80]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceee4;strokeColor=#762f06;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="304" width="288" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="hosttable" value="主机内存表&lt;br&gt;（DP 共享，UVA）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5eef9;strokeColor=#4d335c;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="424" width="144" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="lookup" value="查表 lookup：UVA 直读主机表&lt;br&gt;（行数 \(\ge 36864\) 先排序）&lt;br&gt;行 [T·DP, 16, 80] → [T, 1280]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5eef9;strokeColor=#4d335c;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="424" width="288" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="wkv" value="wkv：MXFP8 GEMM&lt;br&gt;[T, 1280] → [T, 5d]（4 份 K + 1 份 V）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5eef9;strokeColor=#4d335c;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="536" width="288" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="融合门控 kernel&lt;br&gt;RMS 点积 → signed-sqrt → \(\sigma\)&lt;br&gt;\([T, 4, d] + [T, 5d] \to [T, 4, d]\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="632" width="288" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="out" value="residual → mhc_pre&lt;br&gt;[T, 4, d]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="744" width="288" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="注：行号均指 engram.py——哈希 291-423、peer / all_to_all 1612-1650、lookup 1258-1312、门控 1862-1890；GB200 阈值（93-102）：查表行数 \(\ge 36864\) 先按表序排序，token \(\ge 4096\) 时查表改在主流内联。&lt;br&gt;查表可在共享预取流上先行执行（1768-1789），到 Engram 层仅需等待事件；specialized decode 再把整条 WKV 链提前（rows \(\le 16\)，prefetch.py）。&lt;br&gt;哈希的三级 lookback：本 chunk → runner 传入的 lookback 窗口 → V1 的 slot 缓存（V2 用设备侧 token 历史，无需缓存）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="832" width="640" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="runner" target="hash">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hash" target="hashes">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#762f06;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hashes" target="dp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#762f06;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp" target="lookup">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#4d335c;strokeWidth=1.25;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hosttable" target="lookup">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#4d335c;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lookup" target="wkv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wkv" target="gate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2f5783;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="engram-overlap" name="预取与多流重叠">
    <mxGraphModel dx="800" dy="800" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="grpA" value="上游 vLLM（GPU：共享一条 cuda 预取流，两层轮流查表）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="632" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="a_main1" value="哈希 → 计算层 0 … ℓ−1（主流）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="272" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="a_main2" value="Engram 层&lt;br&gt;等 event → wkv + 门控" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="408" y="40" width="200" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="a_pre1" value="查表 + FP8 打包（共享预取流，后台）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="120" y="128" width="272" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="grpB" value="vllm-ascend（NPU：共享一条生产者流，生产者可捕获进图）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="232" width="632" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="b_main1" value="计算层 0 …（主流）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="120" y="272" width="272" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="b_main2" value="第 1 个 Engram 层&lt;br&gt;wait_lookup" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="408" y="272" width="200" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="b_pre1" value="哈希 + 查表 + DP/TP 交换（_engram_prepare_stream）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="120" y="360" width="272" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="注：时间从左到右。上游每层的查表先在共享预取流上执行（engram.py:1768-1789；GB200 上 token \(\ge 4096\) 改主流内联），specialized decode 再把整条 WKV 链提前（rows \(\le 16\)）。&lt;br&gt;Ascend 将哈希、查表、DP/TP 交换整段调度到共享 npu 生产者流，消费者在第一个 Engram 层 wait_lookup；FULL 图回放经 torch.npu.ExternalEvent 等待，V2 runner 可把生产者本身捕获进图（model.py:1311-1543）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="456" width="632" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="ae1" value="event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;dashed=1;fontFamily=Inter;fontSize=12;fontColor=#2c522d;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_pre1" target="a_main2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="504" y="152"/>
              <mxPoint x="504" y="112"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="be1" value="ExternalEvent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;dashed=1;fontFamily=Inter;fontSize=12;fontColor=#2c522d;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_pre1" target="b_main2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="504" y="384"/>
              <mxPoint x="504" y="344"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

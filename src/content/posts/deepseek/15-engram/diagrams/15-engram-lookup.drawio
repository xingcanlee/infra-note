      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="engram-gate" name="查表与门控：shape 变换">
    <mxGraphModel dx="800" dy="900" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lookup" value="查表 \(\mathbf E_{n,k}[\text{行}]\)&lt;br&gt;16 行 × 80 维&lt;br&gt;shape [16] → [16, 80]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="288" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="hid" value="当前 hidden state \(\mathbf h_t^{(m)}\)&lt;br&gt;shape [4, d]（mHC 残差流）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="352" y="0" width="288" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="concat" value="拼接 \(\mathbf e_t\)&lt;br&gt;shape [16, 80] → [1280]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="104" width="288" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="wkv" value="wkv 投影（式 (3)）&lt;br&gt;shape [1280] → [5d]&lt;br&gt;= 4 份 \(\mathbf k^{(m)}\) [4, d] + 1 份共享 \(\mathbf v\) [d]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="200" width="288" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="门控 \(\alpha_t^{(m)}\)（式 (4)/(6)，每分支一个标量）&lt;br&gt;\(\alpha=\sigma\big(\mathrm{RMSNorm}(\mathbf h)\cdot\mathrm{RMSNorm}(\mathbf k)/\sqrt d\big)\)&lt;br&gt;shape [4, d]·[4, d] → [4]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="96" y="312" width="448" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="uv" value="\(\mathbf u_t^{(m)}=\alpha_t^{(m)}\mathbf v_t\)&lt;br&gt;shape [4] × [d] → [4, d]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="424" width="288" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="conv" value="RMSNorm → 因果卷积（k=4，膨胀 3）→ SiLU&lt;br&gt;序列维：[T, 4, d] → \(\mathbf Y\) [T, 4, d]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="512" width="288" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="add" value="\(\mathbf H\leftarrow\mathbf H+\mathbf Y\)&lt;br&gt;shape [4, d] + [4, d]（随后 Attention、MoE）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="176" y="608" width="288" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="注：本页是论文式 (1)–(6) 的 shape 流——\(1280 = 16\times 80\)，\(d\) 为 hidden size，4 为 mHC 分支数。&lt;br&gt;vLLM 实现的差别：wkv 是单个 MXFP8 GEMM（\(1280 \to d\times(\mathrm{hc\_mult}+1)\)，恰好对应「4 份 K + 1 份共享 V」）；门控带逐维 q/k 权重与 signed-sqrt；没有卷积支路，输出即为 \(h+\alpha\mathbf v\)。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="696" width="632" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lookup" target="concat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#5c6067;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="concat" target="wkv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wkv" target="gate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="Query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#2f5783;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hid" target="gate">

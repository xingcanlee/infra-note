        <mxCell id="lbl3" value="\(n=3\) 的 8 个质数桶：偏移 800452 … 1501619（同一序列的 3-gram 行落在另一组桶里）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">

        <mxCell id="b37" value="100207" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="560" y="672" width="72" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="shape" value="输出 shape：[T] token → [T, 2 层, 16] 行号（engram_hashes，整 batch 一次计算完成）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="744" width="632" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="注：左列为加载时一次性的初始化——token_map、乘数与质数桶均为确定性构造，各 rank 一致、无需广播；桶内各行是 checkpoint 加载的 embedding 权重（FP8）。乘数上界（int64 上限 ÷ 压缩词表 ÷ 2）保证 \(id\times m\) 不溢出 int64。&lt;br&gt;数值均按 vLLM 算法实算（engram.py:138-246、413-423）：示例表每桶约 10 万行（Engram-27B 约 226 万）；同一 N-gram 永远命中同一行——序列已知即可预取。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="800" width="632" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e_tok" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tokwin" target="ngram">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_gram" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ngram" target="hash">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_hash" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#2c522d;strokeWidth=1.25;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hash" target="result">

<mxfile host="wisp-diagram">
  <diagram id="engram-hash" name="哈希执行：初始化与逐 token 流程">
    <mxGraphModel dx="800" dy="1000" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="initlbl" value="初始化——模型加载时执行一次" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="288" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="runlbl" value="执行——decode 时对每个 token 重复" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="352" y="0" width="288" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="init1" value="压缩表 token_map&lt;br&gt;加载时对 tokenizer 全词表&lt;br&gt;做 NFKC / 小写折叠&lt;br&gt;128k → 约 98k（−23%）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="32" width="288" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="init2" value="奇乘数 \(m_0, m_1, m_2\)&lt;br&gt;每层一个 RNG：种子 \(10007\times\) 层号&lt;br&gt;随机整数 ×2+1（保证为奇数）&lt;br&gt;按 (层, lookback) 各取一个&lt;br&gt;本层实例：\(m_0 = 59860354330255\)&lt;br&gt;\(m_1 = 25354002604791\)&lt;br&gt;\(m_2 = 3850607830581\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="152" width="288" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="init3" value="质数桶与偏移（EngramLayout）&lt;br&gt;从 engram_vocab_size−1 起&lt;br&gt;逐个取不重复质数，每桶一表&lt;br&gt;偏移 = 前桶行数的前缀和&lt;br&gt;（构建过程详见图 15-11）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="336" width="288" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="tokwin" value="token 窗口（压缩 id）&lt;br&gt;… 医(51107) · 张(51820)&lt;br&gt;仲(46113) · 景(52755，当前 t=3)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="352" y="32" width="288" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ngram" value="后缀 N-gram&lt;br&gt;2-gram：(仲, 景)&lt;br&gt;3-gram：(张, 仲, 景)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="352" y="144" width="288" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="hash" value="rolling 哈希（XOR 累乘）&lt;br&gt;\(h \leftarrow 52755\times m_0\)&lt;br&gt;\(h \leftarrow h\oplus(46113\times m_1)\)，得 \(h_2\)&lt;br&gt;\(h \leftarrow h\oplus(51820\times m_2)\)，得 \(h_3\)&lt;br&gt;\(h_2 = 4317436631837993802\)&lt;br&gt;\(h_3 = 4120365438788803350\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="352" y="240" width="288" height="136" as="geometry"/>
        </mxCell>
        <mxCell id="result" value="行号 \(z = h \bmod M + \mathrm{off}\)（16 行）&lt;br&gt;\(h_2 \bmod 100003 + 0 = 15064\)&lt;br&gt;\(h_2 \bmod 100019 + 100003 = 199342\)&lt;br&gt;\(h_3 \bmod 100129 + 800452 = 845363\)&lt;br&gt;\(h_3 \bmod 100151 + 900581 = 942465\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="352" y="408" width="288" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="lbl2" value="\(n=2\) 的 8 个质数桶：从 engram_vocab_size−1 起依次取不重复质数，偏移 0 … 700343（命中桶标绿）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="560" width="632" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="b20" value="100003&lt;br&gt;行 15064" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="592" width="72" height="40" as="geometry"/>

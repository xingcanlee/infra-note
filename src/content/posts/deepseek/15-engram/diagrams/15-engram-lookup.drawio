        <mxCell id="a3" value="桶与偏移" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;dashed=1;fontFamily=Inter;fontSize=12;fontColor=#7b5518;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="init3" target="result">

          <mxGeometry x="328" y="104" width="296" height="48" as="geometry" />
        </mxCell>
        <mxCell id="mix2" value="奇乘数异或混合（层种子隔离）&lt;br&gt;\(h_2 = (7721 \cdot m_1) \oplus (5509 \cdot m_0)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="176" width="296" height="56" as="geometry" />
        </mxCell>

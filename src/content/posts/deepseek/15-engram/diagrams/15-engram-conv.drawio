        <mxCell id="sp2" value="词组块 3&lt;br&gt;\((t-5,\,t-4,\,t-3)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="320" y="32" width="144" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sp3" value="当前词组块 4&lt;br&gt;\((t-2,\,t-1,\,t)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="32" width="144" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pad0" value="左补零&lt;br&gt;\(\mathrm{pad}=9\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="96" width="56" height="48" as="geometry" />
        </mxCell>
        <mxCell id="tap0" value="抽头 0&lt;br&gt;\(\hat{\mathbf{u}}_{t-9}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="96" width="80" height="48" as="geometry" />
        </mxCell>
        <mxCell id="skp1" value="跳过&lt;br&gt;2 步" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="96" width="56" height="48" as="geometry" />
        </mxCell>
        <mxCell id="tap1" value="抽头 1&lt;br&gt;\(\hat{\mathbf{u}}_{t-6}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="224" y="96" width="80" height="48" as="geometry" />
        </mxCell>
        <mxCell id="skp2" value="跳过&lt;br&gt;2 步" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="96" width="56" height="48" as="geometry" />
        </mxCell>
        <mxCell id="tap2" value="抽头 2&lt;br&gt;\(\hat{\mathbf{u}}_{t-3}\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="384" y="96" width="80" height="48" as="geometry" />
        </mxCell>
        <mxCell id="skp3" value="跳过&lt;br&gt;2 步" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="96" width="56" height="48" as="geometry" />
        </mxCell>
        <mxCell id="tap3" value="抽头 3&lt;br&gt;\(\hat{\mathbf{u}}_t\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="544" y="96" width="80" height="48" as="geometry" />
        </mxCell>
        <mxCell id="conv_op" value="② 深度可分离因果卷积 Depthwise Conv1D（\(\mathrm{groups} = d\)，每 token 仅 \(4d\) 次乘加）&lt;br&gt;输入先经 RMSNorm 稳住通道尺度；卷积核权重全零初始化（冷启动输出恒为 \(0\)）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="64" y="176" width="560" height="56" as="geometry" />
        </mxCell>
        <mxCell id="silu_op" value="③ SiLU 逐元素激活：补充跨词组非线性（\(\mathrm{SiLU}(0) = 0\)）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="64" y="256" width="328" height="48" as="geometry" />
        </mxCell>
        <mxCell id="u_bypass" value="原门控记忆 \(\mathbf{u}_t = \alpha_t \mathbf{v}_t\)&lt;br&gt;（当前位置残差直通支路）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="408" y="256" width="216" height="48" as="geometry" />
        </mxCell>
        <mxCell id="conv_out" value="④ 输出 \(\mathbf{y}_t = \mathrm{SiLU}(\mathrm{Conv1D}(\hat{\mathbf{u}})) + \mathbf{u}_t\)（训练第 0 步严格恒等于 \(\mathbf{u}_t\)）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="112" y="328" width="464" height="48" as="geometry" />
        </mxCell>
        <mxCell id="conv_note" value="对比紧密卷积（\(\delta = 1\) 仅覆盖 6 个 token 且重叠），\(\delta = 3\) 恰好跨过 3-gram 长度，免去大阶哈希碰撞。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="392" width="624" height="24" as="geometry" />
        </mxCell>

          <mxGeometry x="0" y="32" width="144" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sp1" value="词组块 2&lt;br&gt;\((t-8,\,t-7,\,t-6)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

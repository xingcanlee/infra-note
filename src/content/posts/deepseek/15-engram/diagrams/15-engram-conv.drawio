<mxfile host="wisp-diagram">
  <diagram id="engram-conv" name="膨胀因果短卷积 ShortConv：跨词组无重叠拼装与零初始化恒等">
    <mxGraphModel dx="640" dy="440" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_rf" value="① 序列感受野：核宽 \(w = 4\)、膨胀率 \(\delta = 3\)，把 4 段相邻 3-gram 零重叠拼成 12-token 窗口" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#7b5518;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="624" height="24" as="geometry" />
        </mxCell>

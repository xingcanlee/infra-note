        <mxCell id="e-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f5783;strokeWidth=1.25;endArrow=classic;endFill=1;" edge="1" parent="1" source="a-q" target="a-absorb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4d335c;strokeWidth=1.25;endArrow=classic;endFill=1;" edge="1" parent="1" source="a-absorb" target="a-mqa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7b5518;strokeWidth=1.25;endArrow=classic;endFill=1;exitX=0.5;exitY=0;entryX=0.235;entryY=1;" edge="1" parent="1" source="a-c" target="a-mqa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4d335c;strokeWidth=1.25;endArrow=classic;endFill=1;exitX=0.765;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a-mqa" target="a-vup"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="示例取 n_h=2, d_c=3, d_h=4。两路径逐位等价，但吸收路径不再在推理时还原历史多头 K/V。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">

          <mxGeometry x="16" y="16" width="656" height="144" as="geometry" />
        </mxCell>
        <mxCell id="t-naive" value="Naive 路径（Prefill）：先把潜在向量 c_s 解压为多头 K_s，再算点积" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter;fontSize=14;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="24" width="560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n-c" value="压缩缓存 \(c_s\)&lt;br&gt;形状 \([S, 3]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="56" width="144" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-up" value="乘上投影 \(W_{UK}\ [3, 2, 4]\)&lt;br&gt;还原多头 \(K_s = c_s W_{UK}\)&lt;br&gt;物化大张量 \([S, 2, 4]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#f5eef9;strokeColor=#4d335c;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="216" y="56" width="216" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-dot" value="常规 2 头点积打分&lt;br&gt;\(q_t \cdot K_s^\top\)&lt;br&gt;（头维 \(d_h = 4\)）" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="472" y="56" width="184" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e-n1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#464e57;strokeWidth=1.25;endArrow=classic;endFill=1;" edge="1" parent="1" source="n-c" target="n-up"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-n2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#464e57;strokeWidth=1.25;endArrow=classic;endFill=1;" edge="1" parent="1" source="n-up" target="n-dot"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="g-abs" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="16" y="192" width="656" height="200" as="geometry" />
        </mxCell>
        <mxCell id="t-abs" value="矩阵吸收路径（Decode）：结合律把 W_UK 吸进 Query，变回 1 头 MQA" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter;fontSize=14;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="200" width="584" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a-q" value="查询 \(q_t\)&lt;br&gt;\([2, 4]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="232" width="96" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a-absorb" value="预先吸收 \(W_{UK}^\top\)&lt;br&gt;\(q_t^{\text{abs}} = q_t W_{UK}^\top\ [2, 3]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#f5eef9;strokeColor=#4d335c;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="160" y="232" width="192" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a-mqa" value="1 头 MQA 打分与汇聚&lt;br&gt;\(q_t^{\text{abs}} c_s^\top \Rightarrow p_t c_s\ [2, 3]\)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="384" y="232" width="272" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a-c" value="直读缓存 \(c_s\ [S, 3]\)&lt;br&gt;（零解压膨胀）" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="384" y="320" width="128" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a-vup" value="后乘 \(W_{UV}\)&lt;br&gt;\([2, 3] \to [2, 4]\) 输出" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#f5eef9;strokeColor=#4d335c;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

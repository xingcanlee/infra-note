  <diagram id="absorb-walkthrough" name="MLA 矩阵吸收数值示例">
    <mxGraphModel dx="640" dy="440" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="688" pageHeight="440" math="1" shadow="0">
      <root>

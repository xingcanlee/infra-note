        <mxCell id="gpu-reg" value="SM 寄存器硬约束&#xa;单份 64×512 FP32 输出&#xa;占 32,768 / 65,536 寄存器&#xa;纵向切分方能双 WG 掩蔽" style="rounded=1;whiteSpace=wrap;html=1;spacing=6;fontSize=11;strokeWidth=2;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;" vertex="1" parent="1">

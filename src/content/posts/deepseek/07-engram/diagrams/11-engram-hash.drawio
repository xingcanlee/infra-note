        <mxCell id="g_build" value="阶段一：构造全局互异素数分桶与 1D 扁平物理表（K=2 头示例）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="8" width="688" height="192" as="geometry"/>
        </mxCell>
        <mxCell id="b_prime" value="1. 递增寻素 + seen_primes 去重&lt;br&gt;2-gram: [5, 7]&lt;br&gt;3-gram: [11, 13]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="40" width="208" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="b_off" value="2. 累加前缀首址 offsets&lt;br&gt;[0, 5, 12, 23]&lt;br&gt;总槽位 = 5+7+11+13 = 36" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="208" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="b_mult" value="3. 逐层生成有界奇乘数&lt;br&gt;\(m_i \in [1, 2^{31}-1]\) 奇数&lt;br&gt;防止乘 \(2^k\) 丢弃低位" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

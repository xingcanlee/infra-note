        </mxCell>
        <mxCell id="ring" value="&lt;b&gt;未满块环形缓存（Circular Ring）&lt;/b&gt;&lt;br&gt;新词元 t8 暂存 [kv, score]&lt;br&gt;凑满 G=4 词元才写回 Main KV" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

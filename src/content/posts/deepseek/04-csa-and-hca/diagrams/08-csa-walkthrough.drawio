        <mxCell id="swa" value="&lt;b&gt;SWA 局部滑窗（n_win=4）&lt;/b&gt;&lt;br&gt;直接存最近 4 条未压缩 KV：&lt;br&gt;[t4, t5, t6, t7] 或 [t5..t8]&lt;br&gt;防因果遮挡 + 保逐词精确召回" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

<mxfile host="wisp-diagram">
  <diagram id="csa-hca-arch" name="DeepSeek-V4 CSA vs HCA and Dual RoPE">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="672" pageHeight="480" math="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="grp-csa" value="CSA 层（压缩稀疏注意力，步长 m=4）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;dashed=1;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="312" height="208" as="geometry" />
        </mxCell>
        <mxCell id="grp-hca" value="HCA 层（重度压缩注意力，步长 m'=128）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;dashed=1;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="344" y="16" width="312" height="208" as="geometry" />
        </mxCell>
        <mxCell id="csa-fold" value="&lt;b&gt;双窗重叠门控折块（2m=8 → 1）&lt;/b&gt;&lt;br&gt;Ca, Cb + 门控 Za, Zb + 位置偏置 Ba, Bb" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="48" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="csa-idx" value="&lt;b&gt;压缩态闪电索引器（FP4）&lt;/b&gt;&lt;br&gt;ReLU(q_I · K_IComp) → 精选 Top-k（512/1024）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="120" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="csa-note" value="4× 序列压缩 + 稀疏检索，保高分辨率细节" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="32" y="184" width="280" height="32" as="geometry" />
        </mxCell>
        <mxCell id="hca-fold" value="&lt;b&gt;单窗非重叠门控折块（m'=128 → 1）&lt;/b&gt;&lt;br&gt;C = HW_KV, Z = HW_Z + 偏置 B 逐维 Softmax" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="360" y="48" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="hca-dense" value="&lt;b&gt;无索引器・全块稠密注意力&lt;/b&gt;&lt;br&gt;1M 上下文仅约 7,812 块，直接全读无漏选风险" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="hca-note" value="128× 序列压缩，与 CSA 交错堆叠降低存储" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="360" y="184" width="280" height="32" as="geometry" />
        </mxCell>
        <mxCell id="rope-comp" value="&lt;b&gt;压缩支 RoPE（末尾 64 维 GPT-J 旋转）&lt;/b&gt;&lt;br&gt;compress_rope_theta + deepseek_yarn 长上下文外推" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="248" width="312" height="56" as="geometry" />
        </mxCell>
        <mxCell id="rope-swa" value="&lt;b&gt;局部 SWA 支（n_win=128，不压缩）&lt;/b&gt;&lt;br&gt;rope_theta + factor=1.0（mscale=0，is_neox_style=False）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="344" y="248" width="312" height="56" as="geometry" />
        </mxCell>
        <mxCell id="core-mqa" value="&lt;b&gt;Shared KV MQA 核心注意力 + Attention Sink&lt;/b&gt;&lt;br&gt;Q 与 KV 均经 RMSNorm；同一条目兼作 Key 与 Value" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=13;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="328" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="inv-rope" value="&lt;b&gt;输出逆旋转 Inverse RoPE（位置 -t）→ 分组输出投影 wo_a, wo_b&lt;/b&gt;&lt;br&gt;消除 Value 共用 KV 带来的绝对位置编码，还原相对位置依赖（k_pos - q_pos）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcedec;strokeColor=#984646;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="408" width="640" height="56" as="geometry" />

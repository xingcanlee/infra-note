        </mxCell>
        <mxCell id="csa_box" value="CSA（m = 4，重叠 2m = 8 窗）&lt;br&gt;双投影 C^a/C^b + Z^a/Z^b + B^a/B^b&lt;br&gt;沿 2m 行做逐通道 Softmax 加权&lt;br&gt;+ FP4 闪电索引器筛选 Top-k 块" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="40" width="200" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="hca_box" value="HCA（m&#x27; = 128，无重叠单窗）&lt;br&gt;单投影 C, Z + B，序列缩至 1/128&lt;br&gt;1M 上下文仅余约 7,812 条压缩块&lt;br&gt;取消索引器，直接全块稠密读取" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="ring_box" value="FP32 定长 StateCache（环形缓冲）&lt;br&gt;暂存未闭合尾部词元&lt;br&gt;+ SWA (n_win=128)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">

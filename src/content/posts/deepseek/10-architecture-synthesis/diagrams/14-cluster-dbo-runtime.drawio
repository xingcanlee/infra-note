        <mxCell id="grp_p" value="Prefill 集群（算力受限 Compute-Bound）" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8b9098;fontColor=#1d1d1f;strokeWidth=1.25;dashed=1;dashPattern=6 4;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">

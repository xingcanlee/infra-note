<mxfile host="app.diagrams.net">
  <diagram id="14-v41-step-walkthrough" name="DeepSeek-V4.1 单层全链路前向步进">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s1" value="&lt;b&gt;1. 输入扩展与异步预取（层入口）&lt;/b&gt;&lt;br&gt;input x [B, H] → hc_expand → streams [B, 4, H]；同时异步启动 Engram 哈希查表" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="664" height="56" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;2. 注意力前 mHC 折叠（mhc_pre_delayed）&lt;/b&gt;&lt;br&gt;Sinkhorn-Knopp 双随机系数（4 流，20 次迭代）折叠为单流 [B, H] 并做 attn_norm" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5eef9;strokeColor=#4d335c;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="96" width="664" height="56" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;3. 混合稀疏注意力（DeepseekV4Attention / V41Attention）&lt;/b&gt;&lt;br&gt;按层路由至 SWA (W=128) 或 CSA2 + CED（288 B NVFP4 缓存）+ 逆 RoPE / FlashMLA Mega-Attn → x_attn [B, H]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="176" width="664" height="64" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;4. 平移边界（mhc_shifted_post_pre）与 Engram 条件记忆注入&lt;/b&gt;&lt;br&gt;将 x_attn 写回 4 路残差 [B, 4, H]；第 1、14 层在此等待 engram_pending，门控融合后再折叠出 ffn_in [B, H]" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5eef9;strokeColor=#4d335c;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="264" width="664" height="64" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;5. 稀疏专家前馈（DeepSeekMoE / MegaMoE + ffn_norm）&lt;/b&gt;&lt;br&gt;sqrt(softplus) 路由（首 3 层哈希）→ Dispatch All-to-All → 路由专家 + 共享专家 → Combine" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="352" width="664" height="64" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="&lt;b&gt;6. 末层收束与 DSpark 验证（hc_collapse + RejectionSampler）&lt;/b&gt;&lt;br&gt;hc_collapse [B, 4, H] → [B, H] + RMSNorm；抽取 aux_hidden_states 喂给 DSpark 起草并核验" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;fontColor=#1d1d1f;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="16" y="440" width="664" height="64" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c6067;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="注：所有层间残差都在 4 路流 [B, 4, H] 上传递，序列并行（SP）时仅在注意力前后切分/聚合全批 token 维度。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#5c6067;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="16" y="512" width="664" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
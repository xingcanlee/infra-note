        <mxCell id="e_idx_topk" value="" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="idx" target="topk">

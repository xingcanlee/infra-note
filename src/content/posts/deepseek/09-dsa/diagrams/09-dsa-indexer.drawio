<mxfile host="wisp-diagram">
  <diagram id="dsa-indexer" name="DSA：Lightning Indexer 在 MLA 之上做 top-k 选择">
    <mxGraphModel dx="800" dy="900" grid="1" gridSize="8" guides="1" page="0" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cheap" value="便宜的打分路" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#7b5518;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="200" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="h_q" value="当前 \(\mathbf h_t\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="128" y="32" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hs" value="历史 \(\mathbf h_s\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaedf2;strokeColor=#464e57;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="464" y="32" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="qi" value="\(\mathbf q^I_{t,j}\)&lt;br&gt;\(H^I\) 个小 head" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="104" width="192" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="wi" value="\(\mathbf w^I_{t,j}\)&lt;br&gt;标量权重" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="104" width="192" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ki" value="\(\mathbf k^I_s\)&lt;br&gt;indexer key" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="448" y="104" width="192" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="idx" value="\(\displaystyle I_{t,s}=\sum_{j=1}^{H^I} w^I_{t,j}\,\mathrm{ReLU}\!\left(\mathbf q^I_{t,j}\cdot\mathbf k^I_s\right)\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5f3;strokeColor=#0f766e;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="0" y="192" width="640" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="head 数少 · ReLU 代替 exp · 可用 FP8" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="336" y="304" width="304" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="topk" value="Top-\(k\)，\(k=2048\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5eef9;strokeColor=#4d335c;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="344" width="192" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="main" value="昂贵的主注意力路" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#2f5783;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="400" width="200" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="selnote" value="只选下标，不改写 latent" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="336" y="400" width="304" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="cache" value="MLA latent KV cache：全部历史条目 \(\mathbf c_s\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.25;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontFamily=Inter;fontSize=12;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="440" width="640" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c0" value="\(\mathbf c_1\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="24" y="480" width="104" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="\(\mathbf c_2\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="144" y="480" width="104" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="\(\mathbf c_3\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="264" y="480" width="104" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="\(\mathbf c_4\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="384" y="480" width="104" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="\(\mathbf c_5\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="504" y="480" width="104" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="mla" value="MLA attention（MQA 模式）&lt;br&gt;latent 在所有 query head 间共享" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="96" y="592" width="448" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="u" value="输出 \(\mathbf u_t\)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="240" y="680" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="粗边是被 top-\(k\) 选中的条目，只有它们进入主注意力。indexer 仍为 \(O(L^2)\)，但常数很小；主注意力从 \(O(L^2)\) 降到 \(O(Lk)\)。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="0" y="736" width="640" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e1_h_q_qi" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h_q" target="qi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_h_q_wi" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7b5518;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h_q" target="wi">
          <mxGeometry relative="1" as="geometry"/>

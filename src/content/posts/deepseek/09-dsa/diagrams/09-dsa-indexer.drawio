<mxfile host="wisp-diagram"><diagram id="p" name="DSA：Lightning Indexer 在 MLA 之上做 top-k 选择"><mxGraphModel dx="1600" dy="960" grid="1" gridSize="8" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DSA：Lightning Indexer 在 MLA 之上做 top-k 选择" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="16" width="1360" height="32" as="geometry"/></mxCell><mxCell id="cheap" value="便宜的打分路" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#b45309;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="64" width="240" height="24" as="geometry"/></mxCell><mxCell id="main" value="昂贵的主注意力路" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#1d4ed8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="408" width="300" height="24" as="geometry"/></mxCell><mxCell id="h_q" value="h_t" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="32" y="112" width="112" height="56" as="geometry"/></mxCell><mxCell id="qi" value="q^I_{t,j}&lt;br&gt;H^I 个小 head" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="208" y="96" width="176" height="80" as="geometry"/></mxCell><mxCell id="wi" value="w^I_{t,j}&lt;br&gt;标量权重" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="432" y="96" width="176" height="80" as="geometry"/></mxCell><mxCell id="hs" value="历史 h_s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="32" y="240" width="112" height="56" as="geometry"/></mxCell><mxCell id="ki" value="k^I_s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="208" y="224" width="176" height="80" as="geometry"/></mxCell><mxCell id="idx" value="I_{t,s} = Σ_j w^I_{t,j} ·&lt;br&gt;ReLU(q^I_{t,j} · k^I_s)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="640" y="144" width="288" height="96" as="geometry"/></mxCell><mxCell id="topk" value="Top-k&lt;br&gt;k=2048" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="992" y="160" width="160" height="80" as="geometry"/></mxCell><mxCell id="n1" value="head 数少" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1"><mxGeometry x="640" y="264" width="112" height="32" as="geometry"/></mxCell><mxCell id="n2" value="用 ReLU 不是 exp&lt;br&gt;（为吞吐）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1"><mxGeometry x="768" y="264" width="152" height="48" as="geometry"/></mxCell><mxCell id="n3" value="可用 FP8" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1"><mxGeometry x="944" y="264" width="112" height="32" as="geometry"/></mxCell><mxCell id="c0" value="c_1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometr
ry"/></mxCell><mxCell id="sellabel" value="选中的 latent 条目" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#15803d;" vertex="1" parent="1"><mxGeometry x="752" y="496" width="208" height="32" as="geometry"/></mxCell><mxCell id="mla" value="MLA attention&lt;br&gt;MQA mode：latent 在所有 query head 间共享" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="992" y="536" width="280" height="96" as="geometry"/></mxCell><mxCell id="u" value="输出 u_t" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2.5;fontFamily=Inter;fontSize=14;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1320" y="544" width="128" height="80" as="geometry"/></mxCell><mxCell id="rn" value="indexer 仍是 O(L²)，但常数很小；&lt;br&gt;主注意力从 O(L²) 降到 O(Lk)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#5c6067;" vertex="1" parent="1"><mxGeometry x="992" y="672" width="400" height="56" as="geometry"/></mxCell><mxCell id="e_hq_qi" value="" style="endArrow=classic;html=1;strokeColor=#b45309;strokeWidth=1.5;" edge="1" parent="1" source="h_q" target="qi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_hq_wi" value="" style="endArrow=classic;html=1;strokeColor=#b45309;strokeWidth=1.5;" edge="1" parent="1" source="h_q" target="wi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="144" y="140"/><mxPoint x="176" y="140"/><mxPoint x="176" y="136"/><mxPoint x="432" y="136"/></Array></mxGeometry></mxCell><mxCell id="e_hs_ki" value="" style="endArrow=classic;html=1;strokeColor=#b45309;strokeWidth=1.5;" edge="1" parent="1" source="hs" target="ki"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_qi_idx" value="" style="endArrow=classic;html=1;strokeColor=#b45309;strokeWidth=1.5;" edge="1" parent="1" source="qi"
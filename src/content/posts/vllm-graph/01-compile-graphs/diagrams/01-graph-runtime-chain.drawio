    </mxCell>
    <mxCell id="labelN" value="NVIDIA" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=28;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1">

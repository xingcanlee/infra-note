    <mxCell id="a2" value="&lt;b&gt;_check_and_update_cudagraph_mode&lt;/b&gt;&lt;br&gt;resolve mode / sizes&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;set_graph_params(capture_sizes)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="672" y="440" width="368" height="144" as="geometry" />
    </mxCell>
    <mxCell id="a3" value="&lt;b&gt;NPUWorker.load_model&lt;/b&gt;&lt;br&gt;capture_model()&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;GPUModelRunner.capture_model(self)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">

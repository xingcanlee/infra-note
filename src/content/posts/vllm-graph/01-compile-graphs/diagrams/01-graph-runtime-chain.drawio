      <mxGeometry x="88" y="312" width="152" height="32" as="geometry" />
    </mxCell>
    <mxCell id="n1" value="&lt;b&gt;GPUModelRunner.load_model&lt;/b&gt;&lt;br&gt;CUDA GraphWrapper&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;FULL / PIECEWISE&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">

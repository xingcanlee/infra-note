    </mxCell>
    <mxCell id="a4" value="&lt;b&gt;ACLGraphWrapper._call_&lt;/b&gt;&lt;br&gt;key 未命中 + capturing&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;UpdatableGraph + torch.npu.graph&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="1488" y="440" width="368" height="144" as="geometry" />
    </mxCell>
    <mxCell id="s2title" value="每次 forward：派发与重放" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=30;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1">
      <mxGeometry x="88" y="640" width="700" height="40" as="geometry" />
    </mxCell>
    <mxCell id="s2note" value="dispatcher 只给出 mode + padded key；wrapper 信任 context 并执行" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontColor=#5c6067;" vertex="1" parent="1">
      <mxGeometry x="1080" y="640" width="880" height="40" as="geometry" />
    </mxCell>
    <mxCell id="rule2" style="endArrow=none;html=1;strokeColor=#e2e2dd;strokeWidth=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">

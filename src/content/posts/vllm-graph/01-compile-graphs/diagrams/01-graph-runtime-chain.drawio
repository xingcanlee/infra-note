        <mxPoint x="1960" y="696" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="f1" value="&lt;b&gt;execute_model()&lt;/b&gt;&lt;br&gt;准备 batch&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;num_tokens / reqs / LoRA 状态&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="264" y="728" width="368" height="144" as="geometry" />
    </mxCell>
    <mxCell id="f2" value="&lt;b style=&quot;font-size:16px&quot;&gt;_determine_batch_execution_and_padding&lt;/b&gt;&lt;br&gt;判断 uniform decode&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;整理 dispatch 输入&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="672" y="728" width="368" height="144" as="geometry" />
    </mxCell>
    <mxCell id="f3" value="&lt;b&gt;CudagraphDispatcher.dispatch&lt;/b&gt;&lt;br&gt;返回 (mode, padded BatchDescriptor)&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;或 (NONE, 原始 descriptor)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="1080" y="728" width="368" height="144" as="geometry" />
    </mxCell>
    <mxCell id="f4" value="&lt;b&gt;set_forward_context&lt;/b&gt;&lt;br&gt;set_ascend_forward_context&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;cudagraph_runtime_mode&lt;br&gt;batch_descriptor&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="1488" y="728" width="368" height="144" as="geometry" />
    </mxCell>
    <mxCell id="wb2" value="&lt;b&gt;CUDAGraphWrapper._call_&lt;/b&gt;&lt;br&gt;NONE / mode 不匹配 → 直接调用 runnable&lt;br&gt;key 未命中 → torch.cuda.graph 首次捕获&lt;br&gt;key 命中 → cudagraph.replay()" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="264" y="928" width="776" height="216" as="geometry" />
    </mxCell>
    <mxCell id="wa2" value="&lt;b&gt;ACLGraphWrapper._call_&lt;/b&gt;&lt;br&gt;NONE / mode 不匹配 → 直接调用 runnable&lt;br&gt;FULL + updatable → resolve tasks → update / replay（顺序随 ENPU）&lt;br&gt;其他 FULL → NPUGraph.replay()；attention 参数另行更新" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="1080" y="928" width="776" height="216" as="geometry" />
    </mxCell>
    <mxCell id="share" value="共享：CudagraphDispatcher + ForwardContext，平台分叉在 wrapper 与设备 API；编译缓存命中不代表设备图已捕获。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#e2e2dd;strokeWidth=1.5;fontFamily=Inter;fontSize=22;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="112" y="1192" width="1840" height="96" as="geometry" />
    </mxCell>

      <mxGeometry x="88" y="200" width="600" height="40" as="geometry" />
    </mxCell>
    <mxCell id="s1note" value="解析模式 → 初始化 capture keys → 预热 → 按 descriptor 捕获" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Inter;fontSize=18;fontColor=#5c6067;" vertex="1" parent="1">
      <mxGeometry x="1184" y="200" width="776" height="40" as="geometry" />

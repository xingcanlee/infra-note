    </mxCell>
    <mxCell id="n2" value="&lt;b&gt;_check_and_update_cudagraph_mode&lt;/b&gt;&lt;br&gt;resolve mode / sizes&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;initialize_cudagraph_keys&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="672" y="272" width="368" height="144" as="geometry" />
    </mxCell>
    <mxCell id="n3" value="&lt;b&gt;Worker.load_model (GPU)&lt;/b&gt;&lt;br&gt;capture_model()&lt;br&gt;get_capture_descs →&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;_warmup_and_capture&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="1080" y="272" width="368" height="144" as="geometry" />
    </mxCell>
    <mxCell id="n4" value="&lt;b&gt;CUDAGraphWrapper._call_&lt;/b&gt;&lt;br&gt;key 未命中 + capturing&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;torch.cuda.graph(...)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">

      <mxGeometry x="88" y="480" width="152" height="32" as="geometry" />
    </mxCell>
    <mxCell id="a1" value="&lt;b&gt;NPUModelRunner.load_model&lt;/b&gt;&lt;br&gt;ACLGraphWrapper&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;BreakableACLGraphWrapper&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.5;fontFamily=Inter;fontSize=18;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">

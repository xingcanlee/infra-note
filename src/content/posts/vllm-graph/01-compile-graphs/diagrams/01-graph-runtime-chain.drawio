<mxfile host="app.diagrams.net"><diagram id="01-graph-runtime-chain" name="vLLM 图调用链：CUDA Graph 与 ACLGraph"><mxGraphModel adaptiveColors="auto" grid="0" gridSize="8" page="0" background="#FFFFFF">
  <root>
    <mxCell id="0" />

    </mxCell>
    <mxCell id="subtitle" value="启动时按 batch key 捕获；每次 forward 先 dispatch，再由 wrapper 决定 replay、首次捕获或普通执行。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=24;fontColor=#5c6067;" vertex="1" parent="1">

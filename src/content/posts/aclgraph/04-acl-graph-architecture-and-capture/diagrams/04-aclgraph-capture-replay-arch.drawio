          <mxGeometry x="560" y="40" width="112" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c_note" value="IsSoftwareSqEnable 使捕获期间零驱动执行 · 副流未汇回抛 RT_ERROR_STREAM_UNJOINED (0x0703001F)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter, Noto Sans SC;fontSize=11;fontColor=#5c6067;" vertex="1" parent="1">

<mxfile host="wisp-diagram">
  <diagram id="aclgraph-04-flow" name="ACL Graph Capture and Replay">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="8" guides="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cap_grp" value="Capture 阶段：只建逻辑队列与参数备份，设备侧零执行" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2f5783;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="688" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="u1" value="用户流&lt;br&gt;CaptureBegin&lt;br&gt;进入捕获模式" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="32" width="136" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="rec" value="Shadow Stream (影子流)&lt;br&gt;1. 保存 Task 与 LogicSQ&lt;br&gt;2. D2D 备份 Kernel Args&lt;br&gt;3. 保持原序，设备零执行" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="184" y="32" width="232" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="endg" value="CaptureEnd 收尾&lt;br&gt;1. Fork-Join 拓扑校验&lt;br&gt;2. 追加 EndGraph Notify&lt;br&gt;3. 冻结逻辑流产出 modelRI" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="448" y="32" width="224" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="ec1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1" target="rec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ec2" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="endg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rep_grp" value="Replay 阶段：物理队列懒绑定与单次 Trigger 连续运行" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Inter;fontSize=12;fontStyle=1;fontColor=#2c522d;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="200" width="688" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="pre" value="PreModelExecute&lt;br&gt;1. BuildSqCq 分配物理队列&lt;br&gt;2. UpdateNotifyId 绑资源&lt;br&gt;3. Refresh 外部与条件状态" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="232" width="176" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="usr_rep" value="ExecuteAsync 用户流&lt;br&gt;向用户执行流下发：&lt;br&gt;• model exe 触发指令&lt;br&gt;• notify wait 阻断后文" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="216" y="232" width="192" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="mdl_run" value="影子队列满载直通&lt;br&gt;memcpy -&amp;gt; aclnnMul&lt;br&gt;零间隙跑完发 Notify&lt;br&gt;唤醒用户流 Task n" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="480" y="232" width="192" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="er1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pre" target="usr_rep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="er2" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="usr_rep" target="mdl_run">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_trig" value="Trigger" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="408" y="256" width="72" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e_cr" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cap_grp" target="rep_grp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_mri" value="冻结图句柄：modelRI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="200" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

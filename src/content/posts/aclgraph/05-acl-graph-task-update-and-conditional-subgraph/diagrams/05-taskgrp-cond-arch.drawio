<mxfile host="wisp-diagram">
  <diagram id="aclgraph-05-taskgrp-cond" name="TaskGrp Hot Update and Conditional Subgraph">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="8" guides="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="upd_grp" value="1. 局部参数热更新：TaskGrp 划槽 + update_stream + ExternalEvent 护栏" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Inter, Noto Sans SC;fontSize=12;fontStyle=1;fontColor=#2f5783;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="688" height="200" as="geometry" />
        </mxCell>
        <mxCell id="u_stream" value="update_stream (非捕获流)&lt;br&gt;重算新 seq_kv Tiling 参数" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="40" width="208" height="56" as="geometry" />
        </mxCell>
        <mxCell id="u_patch" value="TaskUpdateBegin/End&lt;br&gt;isUpdateSinkSqe=1 原地覆写" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="256" y="40" width="208" height="56" as="geometry" />
        </mxCell>
        <mxCell id="u_evt" value="ExternalEvent.record()&lt;br&gt;放行主图并防步间踩踏" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="496" y="40" width="176" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p_prev" value="前驱静态算子&lt;br&gt;Norm / QKV 保持不变" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="16" y="128" width="168" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p_wait" value="Event Wait + Reset&lt;br&gt;清标志防下步误放行" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=1.25;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="128" width="168" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p_slot" value="TaskGrp 可覆写槽&lt;br&gt;运行最新 PA / FIA SQE" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="432" y="128" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="eu1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=10;" edge="1" parent="1" source="u_stream" target="u_patch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eu2" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=10;" edge="1" parent="1" source="u_patch" target="u_evt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=10;" edge="1" parent="1" source="p_prev" target="p_wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep2" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=10;" edge="1" parent="1" source="p_wait" target="p_slot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eu_wait" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#2c522d;strokeWidth=1.5;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_evt" target="p_wait">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="584" y="112" />
              <mxPoint x="308" y="112" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="cond_grp" value="2. 设备侧条件子图：CondHandle 8 字节条件字与共享 subModelNotify_" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1.25;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Inter, Noto Sans SC;fontSize=12;fontStyle=1;fontColor=#5c6067;container=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="224" width="688" height="192" as="geometry" />
        </mxCell>
        <mxCell id="c_hdl" value="CondHandle (8B devAddr_)&lt;br&gt;PreExecute H2D 复位默认值" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#fbf2df;strokeColor=#7b5518;strokeWidth=1.25;shadow=0;container=0;align=center;verticalAlign=middle;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="16" y="264" width="184" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c_ts" value="TS CondTask&lt;br&gt;IF / WHILE / SW" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#2f5783;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter, Noto Sans SC;fontSize=11;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="224" y="264" width="168" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c_sub0" value="SubGraph 0 (True / Loop 体)&lt;br&gt;结尾发射 subModelNotify_" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5e9;strokeColor=#2c522d;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="424" y="256" width="248" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c_sub1" value="SubGraph 1 (Else 支路)&lt;br&gt;共享同一 subModelNotify_ 唤醒父流" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#5c6067;strokeWidth=1;dashed=1;dashPattern=4 4;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter, Noto Sans SC;fontSize=12;fontColor=#1d1d1f;" vertex="1" parent="1">
          <mxGeometry x="424" y="320" width="248" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c_note" value="父流在 CondTask 后紧接 notify wait (SQE+1) 挂起，子图写 *devAddr_=0 即可终止 WHILE 循环，零 CPU 往返" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Inter, Noto Sans SC;fontSize=11;fontColor=#5c6067;" vertex="1" parent="1">
          <mxGeometry x="16" y="376" width="656" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ec1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#1d1d1f;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=10;" edge="1" parent="1" source="c_hdl" target="c_ts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#2c522d;strokeWidth=1.25;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=10;" edge="1" parent="1" source="c_ts" target="c_sub0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec3" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#5c6067;strokeWidth=1.25;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=10;" edge="1" parent="1" source="c_ts" target="c_sub1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

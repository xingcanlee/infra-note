---
import Icon from '../wisp/components/Icon.astro';
import Base from '../layouts/Base.astro';
import PostCard from '../wisp/components/PostCard.astro';
import { getPosts } from '../wisp/utils/posts';

const recent = (await getPosts()).slice(0, 3);
---

<Base title="页面不存在" noindex>
  <div class="wisp-container nf">
    <h1>404</h1>
    <p class="nf-lead">这个页面不存在，可能已被移动或删除。</p>
    <p><a class="wisp-link" href="/"><Icon name="arrow-left" /> 回到首页</a></p>
    {
      recent.length > 0 && (
        <section class="nf-recent" aria-labelledby="nf-recent-title">
          <h2 id="nf-recent-title">最近的文章</h2>
          <ul>
            {recent.map((post) => (
              <li>
                <PostCard post={post} headingLevel={3} showDescription={false} showTags={false} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .nf {
    padding-top: 4rem;
  }
  h1 {
    margin: 0;
    font-size: 2rem;
  }
  .nf-lead {
    margin: 0.5rem 0 1rem;
    color: var(--wisp-muted);
  }
  .nf-recent {
    margin-top: 3.5rem;
  }
  .nf-recent h2 {
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--wisp-muted);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

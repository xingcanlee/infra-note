---
import Base from '../layouts/Base.astro';
import PostCard from '../wisp/components/PostCard.astro';
import Pagination from '../wisp/components/Pagination.astro';
import { getPosts } from '../wisp/utils/posts';
import { getReadingTimes } from '../wisp/utils/reading';
import config from '../wisp.config';

const all = await getPosts();
const featured = all.filter((p) => p.data.featured).slice(0, config.home.featuredCount);
const posts = all.slice(0, config.home.pageSize);
const totalPages = Math.max(1, Math.ceil(all.length / config.home.pageSize));
const [featuredTimes, times] = await Promise.all([getReadingTimes(featured), getReadingTimes(posts)]);
---

<Base>
  <div class="wisp-container home">
    <header class="home-intro">
      <h1>{config.site.title}</h1>
      <p>{config.site.description}</p>
    </header>
    {
      featured.length > 0 && (
        <section class="home-featured" aria-labelledby="featured-title">
          <h2 id="featured-title" class="home-label">精选</h2>
          <ul class="home-list">
            {featured.map((post, i) => (
              <li>
                <PostCard post={post} readingTime={featuredTimes[i]} headingLevel={3} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section aria-labelledby="latest-title">
      <h2 id="latest-title" class="home-label">最新文章</h2>
      <ul class="home-list">
        {
          posts.map((post, i) => (
            <li>
              <PostCard post={post} readingTime={times[i]} headingLevel={3} />
            </li>
          ))
        }
      </ul>
    </section>
    <Pagination current={1} total={totalPages} />
  </div>
</Base>

<style>
  .home {
    padding-top: 4rem;
  }
  .home-intro {
    margin-bottom: 3.5rem;
  }
  .home-intro h1 {
    margin: 0;
    font-size: 2rem;
  }
  .home-intro p {
    margin: 0.5rem 0 0;
    color: var(--wisp-muted);
  }
  .home-label {
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--wisp-muted);
  }
  .home-featured {
    margin-bottom: 3.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--wisp-border);
  }
  .home-featured .home-list {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--wisp-accent);
  }
  .home-list {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

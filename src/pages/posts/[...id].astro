---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { getPosts, type PostEntry } from '../../wisp/utils/posts';
import Post from '../../layouts/Post.astro';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => {
    // getPosts() 按发布日期降序：更早的一篇在后面
    const older = posts[i + 1];
    const newer = posts[i - 1];
    return {
      params: { id: post.id },
      props: {
        post,
        prev: older && { id: older.id, title: older.data.title },
        next: newer && { id: newer.id, title: newer.data.title },
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  post: PostEntry;
  prev?: { id: string; title: string };
  next?: { id: string; title: string };
}

const { post, prev, next } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
---

<Post
  post={post}
  headings={headings}
  readingTime={remarkPluginFrontmatter.readingTime}
  hasMath={Boolean(remarkPluginFrontmatter.hasMath)}
  hasDiagram={Boolean(remarkPluginFrontmatter.hasDiagram)}
  hasHandDiagram={Boolean(remarkPluginFrontmatter.hasHandDiagram)}
  prev={prev}
  next={next}
>
  <Content />
</Post>

{
  "name": "infra-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基础设施技术笔记站点",
  "author": "xingcanlee",
  "license": "MIT",
  "homepage": "https://github.com/xingcanlee/infra-note#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingcanlee/infra-note.git"
  },
  "bugs": {
    "url": "https://github.com/xingcanlee/infra-note/issues"
  },
  "keywords": [
    "astro",
    "blog",
    "infrastructure",
    "notes",
    "mdx",
    "mermaid"
  ],
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tokens": "tsx scripts/gen-tokens.ts",
    "contrast": "tsx scripts/check-contrast.ts",
    "diagram": "tsx scripts/diagram/cli.ts",
    "check": "astro check && tsc --noEmit -p . && tsx scripts/check-contrast.ts && tsx scripts/diagram/cli.ts check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.6",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.1",
    "mdast-util-to-string": "^4.0.0",
    "motion": "^14.9.1",
    "oxc-transform-react": "^0.145.0",
    "pele": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.64.1",
    "@types/culori": "^4.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "culori": "^4.0.2",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@napi-rs/wasm-runtime@1.2.4>@emnapi/runtime": "1.11.3",
      "@napi-rs/wasm-runtime@1.2.4>@emnapi/core": "1.11.3"
    }
  }
}

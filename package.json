{
  "name": "infra-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基础设施技术笔记站点",
  "author": "xingcanlee",
  "license": "MIT",
  "homepage": "https://github.com/xingcanlee/infra-note#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingcanlee/infra-note.git"
  },
  "bugs": {
    "url": "https://github.com/xingcanlee/infra-note/issues"
  },
  "keywords": [
    "astro",
    "blog",
    "infrastructure",
    "notes",
    "mdx",
    "mermaid"
  ],
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "diagram": "wisp diagram",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "simple-git-hooks",
    "check": "astro check && tsc --noEmit -p . && eslint . && prettier . --check && vitest run && wisp diagram check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.3",
    "astro": "^7.4.6",
    "astro-wisp": "^0.5.2",
    "motion": "^14.9.1",
    "oxc-transform-react": "^0.145.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/culori": "^4.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,mdx,yaml,yml}": "prettier --write"
  }
}

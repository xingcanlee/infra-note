{
  "name": "infra-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基础设施技术笔记站点",
  "author": "xingcanlee",
  "license": "MIT",
  "homepage": "https://github.com/xingcanlee/infra-note#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingcanlee/infra-note.git"
  },
  "bugs": {
    "url": "https://github.com/xingcanlee/infra-note/issues"
  },
  "keywords": [
    "astro",
    "blog",
    "infrastructure",
    "notes",
    "mdx",
    "mermaid"
  ],
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "diagram": "wisp diagram",
    "check": "astro check && tsc --noEmit -p . && wisp diagram check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.3",
    "astro": "^7.4.6",
    "astro-wisp": "^0.2.3",
    "motion": "^14.9.1",
    "oxc-transform-react": "^0.145.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@astrojs/react>@vitejs/plugin-react": "6.1.1",
      "@napi-rs/wasm-runtime@1.2.4>@emnapi/runtime": "1.11.3",
      "@napi-rs/wasm-runtime@1.2.4>@emnapi/core": "1.11.3"
    }
  }
}
